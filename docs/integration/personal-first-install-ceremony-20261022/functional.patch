--- a/apps/server/personal_plan_data.h
+++ b/apps/server/personal_plan_data.h
@@ -0,0 +1,26 @@
+#ifndef PAPACC_PERSONAL_PLAN_DATA_H
+#define PAPACC_PERSONAL_PLAN_DATA_H
+/* Private DATA sequencing, never an authority/eligibility proof. Embedded in
+ * the existing canonical owner. No platform types, allocation or callbacks. */
+#include <stddef.h>
+#define PAPACC_PERSONAL_PLAN_MAX 8192U
+#define PAPACC_PERSONAL_DATA_CAPTURED 1U
+#define PAPACC_PERSONAL_DATA_PRESENTED 2U
+#define PAPACC_PERSONAL_DATA_CONFIRMED 3U
+#define PAPACC_PERSONAL_DATA_CONSUMED 4U
+#define PAPACC_PERSONAL_DATA_INVALID 5U
+#define PAPACC_PERSONAL_DATA_FINISHED 6U
+typedef struct PAPACC_PERSONAL_PLAN_DATA {
+ unsigned phase,consumed;size_t bytes;
+ unsigned char attempt[32],plan[PAPACC_PERSONAL_PLAN_MAX];
+} PAPACC_PERSONAL_PLAN_DATA;
+/* Input nonce is untrusted DATA here: qualified native CSPRNG/identity/target
+ * and publication are deliberately NOT supplied by this module. */
+int papacc_personal_data_capture(PAPACC_PERSONAL_PLAN_DATA *,const unsigned char *,const unsigned char *,size_t);
+int papacc_personal_data_present(PAPACC_PERSONAL_PLAN_DATA *);
+int papacc_personal_data_confirm(PAPACC_PERSONAL_PLAN_DATA *,const unsigned char *,const unsigned char *,size_t);
+int papacc_personal_data_consume(PAPACC_PERSONAL_PLAN_DATA *,const unsigned char *,const unsigned char *,size_t);
+void papacc_personal_data_invalidate(PAPACC_PERSONAL_PLAN_DATA *);
+/* Caller must prove no worker/borrow before invoking retire. No timeout. */
+int papacc_personal_data_retire(PAPACC_PERSONAL_PLAN_DATA *);
+#endif
--- a/apps/server/personal_plan_data.c
+++ b/apps/server/personal_plan_data.c
@@ -0,0 +1,43 @@
+#include "personal_plan_data.h"
+#include <string.h>
+static int overlaps(const PAPACC_PERSONAL_PLAN_DATA *p,const unsigned char *s,size_t n)
+{
+ const unsigned char *base=(const unsigned char *)p;size_t i;
+ for(i=0U;i<sizeof(*p);i++)if(s==base+i||s+n-1U==base+i)return 1;
+ return 0;
+}
+static int match(const PAPACC_PERSONAL_PLAN_DATA *p,const unsigned char *id,const unsigned char *plan,size_t n)
+{return p&&id&&plan&&n&&n<=PAPACC_PERSONAL_PLAN_MAX&&n==p->bytes&&!memcmp(id,p->attempt,32U)&&!memcmp(plan,p->plan,n);}
+int papacc_personal_data_capture(PAPACC_PERSONAL_PLAN_DATA *p,const unsigned char *id,const unsigned char *plan,size_t n)
+{
+ size_t i;unsigned any=0U;
+ if(!p||p->phase||!id||!plan||!n||n>PAPACC_PERSONAL_PLAN_MAX)return 0;
+ /* Aliased input is rejected before copying: no destructive partial capture. */
+ if(overlaps(p,id,32U)||overlaps(p,plan,n))return 0;
+ for(i=0U;i<32U;i++)any|=id[i];
+ if(!any)return 0;
+ memcpy(p->attempt,id,32U);memcpy(p->plan,plan,n);p->bytes=n;p->consumed=0U;p->phase=PAPACC_PERSONAL_DATA_CAPTURED;return 1;
+}
+int papacc_personal_data_present(PAPACC_PERSONAL_PLAN_DATA *p)
+{if(!p||p->phase!=PAPACC_PERSONAL_DATA_CAPTURED)return 0;p->phase=PAPACC_PERSONAL_DATA_PRESENTED;return 1;}
+int papacc_personal_data_confirm(PAPACC_PERSONAL_PLAN_DATA *p,const unsigned char *id,const unsigned char *plan,size_t n)
+{
+ if(!p||p->phase!=PAPACC_PERSONAL_DATA_PRESENTED)return 0;
+ if(!match(p,id,plan,n)){p->phase=PAPACC_PERSONAL_DATA_INVALID;return 0;}
+ p->phase=PAPACC_PERSONAL_DATA_CONFIRMED;return 1;
+}
+int papacc_personal_data_consume(PAPACC_PERSONAL_PLAN_DATA *p,const unsigned char *id,const unsigned char *plan,size_t n)
+{
+ if(!p||p->phase!=PAPACC_PERSONAL_DATA_CONFIRMED||p->consumed)return 0;
+ if(!match(p,id,plan,n)){p->phase=PAPACC_PERSONAL_DATA_INVALID;return 0;}
+ p->consumed=1U;p->phase=PAPACC_PERSONAL_DATA_CONSUMED;return 1;
+}
+void papacc_personal_data_invalidate(PAPACC_PERSONAL_PLAN_DATA *p)
+{if(p&&p->phase&&p->phase!=PAPACC_PERSONAL_DATA_FINISHED)p->phase=PAPACC_PERSONAL_DATA_INVALID;}
+int papacc_personal_data_retire(PAPACC_PERSONAL_PLAN_DATA *p)
+{
+ volatile unsigned char *b;size_t i;
+ if(!p||p->phase!=PAPACC_PERSONAL_DATA_INVALID)return 0;
+ b=p->plan;for(i=0U;i<sizeof(p->plan);i++)b[i]=0U;
+ p->bytes=0U;p->phase=PAPACC_PERSONAL_DATA_FINISHED;return 1;
+}
--- a/apps/server/server_configuration_personal_data_win32.inc
+++ b/apps/server/server_configuration_personal_data_win32.inc
@@ -0,0 +1,27 @@
+static int personal_native_ceremony_ready(const PAPACC_CONFIG_PENDING *p)
+{(void)p;return 0; /* DATA sequencing never establishes native admissibility. */}
+/* Same root/packet, DATA only. Never establishes native eligibility, parent
+ * identity, CSPRNG provenance or permission for a worker/custody operation. */
+PAPACC_RESULT papacc_configuration_personal_data_capture(PAPACC_CONFIGURATION_COMMIT *o,
+ const unsigned char id[32],const unsigned char *plan,PAPACC_SIZE bytes)
+{
+ unsigned i;
+ if(!owner(o)||o->stopped||o->unresolved||o->published||o->prepared||o->committed_pending||
+ o->committed_bytes||o->recovery_selected||o->recovery_guard||pending_blocks(o)||o->pending_commit.thread)
+ return PAPACC_RESULT_INVALID_STATE;
+ for(i=0U;i<PAPACC_CONFIG_SLOTS;i++)if(o->slots[i].readers||o->slots[i].retained||o->issuer_snapshot_valid[i])return PAPACC_RESULT_INVALID_STATE;
+ return papacc_personal_data_capture(&o->pending_commit.personal_data,id,plan,bytes)?PAPACC_RESULT_OK:PAPACC_RESULT_INVALID_ARGUMENT;
+}
+PAPACC_RESULT papacc_configuration_personal_data_retire(PAPACC_CONFIGURATION_COMMIT *o)
+{
+ PAPACC_CONFIG_PENDING *p;
+ if(!owner(o))return PAPACC_RESULT_INVALID_STATE;p=&o->pending_commit;
+ /* The DATA object never acquires a borrow. Still deny erasure while any
+  * canonical worker/native owner can be pending or retained. */
+ if(papacc_store_hash_blocked(&o->store_hash)||papacc_store_hash_blocked(&p->store_hash)||p->active||p->thread||p->bootstrap_parent||p->bootstrap_container||p->bootstrap_token||
+ p->transaction||(p->file&&p->file!=INVALID_HANDLE_VALUE)||o->unresolved||
+ o->retained_transaction||(o->retained_file&&o->retained_file!=INVALID_HANDLE_VALUE))return PAPACC_RESULT_INVALID_STATE;
+ papacc_personal_data_invalidate(&p->personal_data);
+ return papacc_personal_data_retire(&p->personal_data)?PAPACC_RESULT_OK:PAPACC_RESULT_INVALID_STATE;
+}
+
--- a/tests/personal_plan_data_win32_test.c
+++ b/tests/personal_plan_data_win32_test.c
@@ -0,0 +1,46 @@
+#include "server_configuration_commit_win32.h"
+#include <stdio.h>
+#include <string.h>
+static PAPACC_CONFIGURATION_COMMIT owner_state;
+static unsigned char nonce[32]={1},other[32]={2},plan[]={1,2,3,4},changed[]={1,2,3,5};
+#define CHECK(x) do {if(!(x)){printf("FAIL %u\n",(unsigned)__LINE__);return 1;}}while(0)
+int main(void)
+{
+ PAPACC_PERSONAL_PLAN_DATA *p=&owner_state.pending_commit.personal_data;unsigned i;
+ /* MODEL owner initialization only: no CSPRNG, filesystem, token or key call. */
+ owner_state.initialized=1;owner_state.writer=GetCurrentThreadId();
+ CHECK(!papacc_personal_data_capture(p,nonce,plan,0));
+ CHECK(!papacc_personal_data_capture(p,nonce,plan,PAPACC_PERSONAL_PLAN_MAX+1U));
+ CHECK(papacc_configuration_personal_data_capture(&owner_state,nonce,plan,sizeof(plan))==0);
+ CHECK(!papacc_personal_data_consume(p,nonce,plan,sizeof(plan)));
+ CHECK(!papacc_personal_data_confirm(p,nonce,plan,sizeof(plan)));
+ CHECK(papacc_personal_data_present(p));
+ CHECK(!papacc_personal_data_confirm(p,other,plan,sizeof(plan)));
+ CHECK(p->phase==PAPACC_PERSONAL_DATA_INVALID);
+ CHECK(papacc_configuration_personal_data_retire(&owner_state)==0);
+ CHECK(!papacc_personal_data_capture(p,nonce,plan,sizeof(plan)));
+ memset(p,0,sizeof(*p)); /* MODEL reset only, never a product retry. */
+ CHECK(papacc_configuration_personal_data_capture(&owner_state,nonce,plan,sizeof(plan))==0);
+ CHECK(papacc_personal_data_present(p));
+ CHECK(!papacc_personal_data_confirm(p,nonce,changed,sizeof(changed)));
+ CHECK(papacc_configuration_personal_data_retire(&owner_state)==0);
+ memset(p,0,sizeof(*p));
+ CHECK(papacc_configuration_personal_data_capture(&owner_state,nonce,plan,sizeof(plan))==0);
+ CHECK(papacc_personal_data_present(p));
+ CHECK(papacc_personal_data_confirm(p,nonce,plan,sizeof(plan)));
+ CHECK(papacc_personal_data_consume(p,nonce,plan,sizeof(plan)));
+ CHECK(!papacc_personal_data_consume(p,nonce,plan,sizeof(plan)));
+ CHECK(!papacc_personal_data_confirm(p,nonce,plan,sizeof(plan)));
+ owner_state.pending_commit.active=1;
+ CHECK(papacc_configuration_personal_data_retire(&owner_state)!=0&&p->phase==PAPACC_PERSONAL_DATA_CONSUMED&&p->consumed);
+ owner_state.pending_commit.active=0;owner_state.stopped=1;
+ CHECK(papacc_configuration_personal_data_retire(&owner_state)==0&&p->consumed);
+ for(i=0;i<PAPACC_PERSONAL_PLAN_MAX;i++)CHECK(p->plan[i]==0);
+ CHECK(!papacc_personal_data_present(p));
+ CHECK(papacc_configuration_personal_data_capture(&owner_state,other,plan,sizeof(plan))!=0);
+ memset(p,0,sizeof(*p));owner_state.stopped=0;
+ CHECK(!papacc_personal_data_capture(p,nonce,p->plan,1));
+ CHECK(papacc_configuration_personal_data_capture(&owner_state,nonce,plan,sizeof(plan))==0);
+ CHECK(papacc_configuration_prepare(&owner_state,NULL,0,0)!=0); /* never authority */
+ printf("PERSONAL_DATA_ONLY_PASS STATE_BYTES=%lu NO_ELIGIBILITY_NO_CUSTODY_NO_EFFECT\n",(unsigned long)sizeof(*p));return 0;
+}
