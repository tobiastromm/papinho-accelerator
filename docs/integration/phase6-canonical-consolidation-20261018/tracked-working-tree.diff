+            PAPACC_MESSAGE_TYPE_NETWORK_CLOSE&&
+        o->owner_publication_attempt_event.terminal_cause==
+            PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_NONE&&
+        o->owner_publication_success_event.operation_id==o->channel_instance_id&&
