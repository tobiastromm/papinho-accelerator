+cleanup:
+    if (!success && mode == TEST_OUTBOUND_VALID) {
+        pst_u32 diagnostic_interest = PST_INTEREST_NONE;
+        PST_RESULT diagnostic_interest_result = PST_RESULT_INVALID_STATE;
+        if (fixture_connection != NULL)
