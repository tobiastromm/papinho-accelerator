+            client_credentials, client_trust, &data)) goto cleanup;
+    diagnostic_stage = 21;
+    if (!write_all(&data, secure_io, attach, sizeof(attach), 3U))
+        goto cleanup;
+    diagnostic_stage = 22;
+    if (!read_exact(&data, secure_io, accepted_frame,
+            sizeof(accepted_frame))) goto cleanup;
+    diagnostic_stage = 23;
