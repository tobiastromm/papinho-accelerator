+static void ai_resource_init(AI_RESOURCE_OBSERVATION *resource,
+    const char *type, PAPACC_U32 test_id)
+{
+    memset(resource, 0, sizeof(*resource));
+    resource->type = type;
+    resource->test_id = test_id;
+}
