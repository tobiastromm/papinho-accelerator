+    if(!ai_g1_publication_oracle_valid(&baseline))return 0;
+    candidate=baseline;
+    candidate.owner_publication_attempt_event.internal_injection=PAPACC_TRUE;
+    if(ai_g1_publication_oracle_valid(&candidate))return 0;
