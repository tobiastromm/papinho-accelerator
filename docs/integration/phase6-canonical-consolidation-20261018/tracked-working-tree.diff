+static DWORD WINAPI reference_fixture_thread(void *value)
+{
+    REFERENCE_FIXTURE_THREAD *fixture = (REFERENCE_FIXTURE_THREAD *)value;
+    PAPACC_U8 bytes[32768];
+    PAPACC_SIZE offset = 0U;
