+static int productive_tls_scenario(TEST_OUTBOUND_MODE mode,
+    PAPACC_U16 server_port, PAPACC_SECURITY_COMPOSITION *composition,
+    PAPACC_SERVER_SECURE_IO_WIN32 *secure_io,
