+    papacc_resolved_server_security_configuration_release(&t->configuration);
+    if(t->used || t->held_storage)return PAPACC_RESULT_INTERNAL_ERROR;
+    t->state=PAPACC_SECURITY_SOURCE_CLOSED;return PAPACC_RESULT_OK;
