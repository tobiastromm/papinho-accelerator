+        t->held_storage!=NULL || t->used!=0U || t->configuration.release!=NULL)
+        return PAPACC_RESULT_INVALID_STATE;
+    if(sizeof(*t)>2097152U || other_reserved>2097152U-sizeof(*t) ||
+        credit>2097152U-sizeof(*t)-other_reserved)return PAPACC_RESULT_LIMIT_EXCEEDED;
