+ if(kind==TokenStatistics){TOKEN_STATISTICS *t=out;memset(t,0,sizeof(*t));t->TokenType=fault==8?TokenImpersonation:TokenPrimary;t->TokenId.LowPart=(fault==22&&token==(HANDLE)2)?2:1;t->ModifiedId.LowPart=3;}
