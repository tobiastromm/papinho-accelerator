+/* Post-seal copy only; cannot grant authority, export I/O or refund quota. */
+PAPACC_RESULT papacc_server_c2_pair_copy(const PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_SIZE index,PAPACC_C2_PAIR_OPEN_RECEIPT*out){
+ ULONG_PTR a=(ULONG_PTR)o,b=(ULONG_PTR)out;
+ if(!o||!out||index>=2U||(b>=a&&b-a<sizeof(*o)))return PAPACC_RESULT_INVALID_ARGUMENT;
+ if(b<a&&a-b<sizeof(*out))return PAPACC_RESULT_INVALID_ARGUMENT;
+ if(!o->initialized||!o->manager||!o->secure||o->manager->owner!=(PAPACC_U32)GetCurrentThreadId()||
+    o->secure->dispatch_active||!o->e10.enabled||!o->e10.sealed||o->e10.busy||
+    o->e10.overflow||o->e10.reentrant||!o->e10.pair_open[index].present)return PAPACC_RESULT_INVALID_STATE;
