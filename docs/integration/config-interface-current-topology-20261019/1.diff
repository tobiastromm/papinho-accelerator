 PAPACC_RESULT papacc_interface_snapshot_copy_prepare(PAPACC_INTERFACE_SNAPSHOT_COPY *out,
  const PAPACC_NETWORK_DISCOVERY_SNAPSHOT *source,PAPACC_U64 invocation,PAPACC_U64 revision)
 {
@@ -43,3 +44,38 @@
  out->addresses=(PAPACC_NETWORK_INTERFACE_ADDRESS *)copy->addresses;out->address_count=copy->address_count;
  return PAPACC_RESULT_OK;
 }
+
+PAPACC_RESULT papacc_interface_snapshot_copy_matches(const PAPACC_INTERFACE_SNAPSHOT_COPY *copy,
+ const PAPACC_NETWORK_DISCOVERY_SNAPSHOT *observed,const PAPACC_PERSISTENT_BIND_SELECTION *selected,PAPACC_BOOL *matches)
+{
+ PAPACC_NETWORK_DISCOVERY_SNAPSHOT before=PAPACC_NETWORK_DISCOVERY_SNAPSHOT_INITIALIZER;
+ PAPACC_PERSISTENT_BIND_SELECTION one=PAPACC_PERSISTENT_BIND_SELECTION_INITIALIZER;
+ PAPACC_BIND_SELECTION left=PAPACC_BIND_SELECTION_INITIALIZER,right=PAPACC_BIND_SELECTION_INITIALIZER;
+ PAPACC_BIND_TARGET a[8],b[8];PAPACC_U32 li,ri;PAPACC_SIZE i,j,k,an,bn,required;PAPACC_RESULT result;
+ const PAPACC_NETWORK_INTERFACE *old_record,*new_record;
+ if(!matches)return PAPACC_RESULT_INVALID_ARGUMENT;*matches=PAPACC_FALSE;
+ if(!copy||!observed||!selected)return PAPACC_RESULT_INVALID_ARGUMENT;
+ if(selected->mode!=PAPACC_BIND_SELECTION_SELECTED_INTERFACES)return PAPACC_RESULT_NOT_SUPPORTED;
+ if(papacc_persistent_bind_selection_validate(selected)!=PAPACC_RESULT_OK)return PAPACC_RESULT_INVALID_ARGUMENT;
+ if(selected->interface_persistent_id_count>8U)return PAPACC_RESULT_LIMIT_EXCEEDED;
+ result=papacc_interface_snapshot_copy_view(copy,copy->invocation,copy->preparation_revision,&before);
+ if(result!=PAPACC_RESULT_OK)return result;
+ one.mode=PAPACC_BIND_SELECTION_SELECTED_INTERFACES;one.interface_persistent_id_count=1U;
+ for(i=0;i<selected->interface_persistent_id_count;++i){one.interface_persistent_ids=&selected->interface_persistent_ids[i];
+  if(papacc_persistent_bind_selection_resolve(&one,&before,&li,1U,&left,&required)!=PAPACC_RESULT_OK||
+     papacc_persistent_bind_selection_resolve(&one,observed,&ri,1U,&right,&required)!=PAPACC_RESULT_OK)return PAPACC_RESULT_OK;
+  old_record=NULL;new_record=NULL;
+  for(j=0;j<before.interface_count;++j)if(before.interfaces[j].interface_instance_id==li)old_record=&before.interfaces[j];
+  for(j=0;j<observed->interface_count;++j)if(observed->interfaces[j].interface_instance_id==ri)new_record=&observed->interfaces[j];
+  if(!old_record||!new_record||old_record->is_up!=new_record->is_up||old_record->is_loopback!=new_record->is_loopback)return PAPACC_RESULT_OK;
+  result=papacc_bind_targets_resolve(&left,&before,a,8U,&an,&required);
+  if(result==PAPACC_RESULT_LIMIT_EXCEEDED)return result;if(result!=PAPACC_RESULT_OK)return PAPACC_RESULT_OK;
+  result=papacc_bind_targets_resolve(&right,observed,b,8U,&bn,&required);
+  if(result==PAPACC_RESULT_LIMIT_EXCEEDED)return result;if(result!=PAPACC_RESULT_OK||an!=bn)return PAPACC_RESULT_OK;
+  for(j=0;j<an;++j){PAPACC_BOOL found=PAPACC_FALSE;
+   for(k=0;k<bn;++k)if(a[j].scope_id==b[k].scope_id&&papacc_ip_address_equal(&a[j].address,&b[k].address)==PAPACC_TRUE)found=PAPACC_TRUE;
+   if(found!=PAPACC_TRUE)return PAPACC_RESULT_OK;
+  }
+ }
+ *matches=PAPACC_TRUE;return PAPACC_RESULT_OK;
+}
