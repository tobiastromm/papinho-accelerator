  if(GetEnvironmentVariableA("PAPACC_C7_METRICS",enabled,sizeof(enabled))==1U&&enabled[0]=='1'&&n>=28U)fprintf(stderr,"E10_DATA_AUTHORITY pid=%lu owner=%lu session=%llu channel=%llu bound_operation=%llu bound_generation=%llu incoming_operation=%llu incoming_generation=%llu incoming_role=%u TLS_READY=%u SITE_READY=%u result=%d admitted_before=%llu admitted_after=%llu queue_before=%llu queue_after=%llu\n",GetCurrentProcessId(),GetCurrentThreadId(),(unsigned long long)sid,(unsigned long long)channel,(unsigned long long)r->id,(unsigned long long)r->generation,(unsigned long long)owner_read64(p),(unsigned long long)owner_read64(p+8),(unsigned)p[16],(unsigned)r->tls_ready_written,(unsigned)r->site_ready,(int)result,(unsigned long long)before,(unsigned long long)r->flow[flow].admitted,(unsigned long long)queued,(unsigned long long)r->flow[flow].size);
