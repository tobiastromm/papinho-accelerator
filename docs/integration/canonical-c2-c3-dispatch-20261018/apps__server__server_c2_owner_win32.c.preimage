#include <stdio.h>
/* Diagnostic metadata only: no tokens, payloads or secret principals. */
static void causal_observe(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_U64 sid,PAPACC_U64 channel,const char*event,PAPACC_U16 type,PAPACC_U16 fact){
 static PAPACC_U64 sequence;unsigned i;PAPACC_CHANNEL*c;PAPACC_SERVER_PROTOCOL_SLOT_WIN32*slot;char enabled[8];
 if(GetEnvironmentVariableA("PAPACC_C2_RESET_CAUSAL_TRACE",enabled,sizeof(enabled))!=1U||enabled[0]!='1')return;
 c=papacc_channel_manager_find_control(&o->loop->channel_manager,sid);slot=c?papacc_server_io_loop_win32_find_connection_slot(o->loop,c->connection_instance_id):NULL;
 for(i=0;i<2U;++i){PAPACC_C2_OPERATION*r=&o->manager->operations[i];if(r->state==PAPACC_C2_OP_EMPTY||r->session==NULL||r->session->incarnation!=sid)continue;
  fprintf(stderr,"S6_OWNER_CAUSAL sequence=%llu owner=%lu session=%llu control_connection=%llu channel=%llu operation=%llu generation=%llu event=%s type=%u incoming_fact=%u first_cause=%u session_state=%u operation_state=%u site_ready=%d tls_ready=%d revoked=%d app_channel=%llu record_channel=%llu control_payload_received=%lu control_header_received=%lu control_parser_payload=%lu control_buffered=%lu\n",(unsigned long long)++sequence,(unsigned long)o->manager->owner,(unsigned long long)sid,(unsigned long long)(c?c->connection_instance_id:0),(unsigned long long)channel,(unsigned long long)r->id,(unsigned long long)r->generation,event,type,fact,r->first_cause,(unsigned)r->session->state,(unsigned)r->state,r->site_ready,r->tls_ready_written,r->revoked,(unsigned long long)r->tokens.channels[0],(unsigned long long)r->tokens.channels[1],(unsigned long)(slot?slot->post_control_processor.c2_received:0),(unsigned long)(slot?slot->post_control_processor.reader.parser.header_bytes_received:0),(unsigned long)(slot?slot->post_control_processor.reader.parser.payload_bytes_received:0),(unsigned long)(slot?slot->post_control_processor.reader.buffered_length:0));
 }
}
static int c7_stall(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_C2_OPERATION*r,unsigned flow){
 if(!o->c7_stall_event||flow!=o->c7_stall_flow||!r->tls_ready_written||r->revoked)return 0;
 if(o->c7_stall_operation==0U){o->c7_stall_operation=r->id;o->c7_stall_generation=r->generation;}
 return o->c7_stall_operation==r->id&&o->c7_stall_generation==r->generation&&WaitForSingleObject(o->c7_stall_event,0U)!=WAIT_OBJECT_0;
}
static PAPACC_U64 owner_read64(const PAPACC_U8*p){PAPACC_U64 v=0;unsigned i;for(i=0;i<8U;++i)v=(v<<8)|p[i];return v;}
static int valid(const PAPACC_SERVER_C2_OWNER_WIN32*o){return o!=NULL&&o->initialized&&o->loop!=NULL&&o->loop->initialized&&o->secure!=NULL&&o->secure->initialized&&o->secure->protocol_loop==o->loop&&o->secure->c2_finish_role_fn!=NULL&&o->manager!=NULL&&o->manager->initialized&&o->secure->owner_thread_id==(PAPACC_U32)GetCurrentThreadId()&&o->manager->owner==o->secure->owner_thread_id;}
static int index_of(const PAPACC_SERVER_C2_OWNER_WIN32*o,const PAPACC_C2_OPERATION*r){unsigned i;for(i=0;i<2U;++i)if(&o->manager->operations[i]==r&&r->state!=PAPACC_C2_OP_EMPTY)return (int)i;return -1;}
#include "server_c2_e10_observe.inc"
static void observe(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_C2_OWNER_WRITE*w,PAPACC_C2_PUBLICATION_EVENT_KIND kind,PAPACC_SIZE n,PAPACC_RESULT result){PAPACC_C2_PUBLICATION_EVENT event;if(o->observer==NULL&&!o->e10.enabled)return;memset(&event,0,sizeof(event));event.kind=kind;event.connection=w->connection;event.operation=w->operation;event.generation=w->generation;event.type=w->type;event.accepted=n;event.result=result;
 if(w->record&&w->record->session)event.session=w->record->session->incarnation;
 if(w->type==22U&&w->length>=44U){
  PAPACC_CHANNEL*channel=papacc_channel_manager_find_by_connection(&o->loop->channel_manager,w->connection);
  if(channel)event.bind_channel=channel->channel_instance_id;
  event.incoming_operation=owner_read64(w->bytes+16U);event.incoming_generation=owner_read64(w->bytes+24U);
  event.incoming_role=w->bytes[32];event.incoming_direction=w->bytes[33];event.offset=owner_read64(w->bytes+36U);event.data_length=w->length-44U;
  if(kind==PAPACC_C2_PUBLICATION_LOWER_ACCEPTED&&w->offset>=n)event.progress_prefix=(PAPACC_U64)(w->offset-n);
 }
 e10_snapshot(o,&event);if(event.e10_snapshot_valid){
 e10_store(o,&event);
 /* Fixed public fact mirrors are independent of event capacity. This is the
  * actual completion observation, not authority or proof of a complete capture.
  * Overflow stays incomplete; no observer failure may gate harness progress. */
 if(kind==PAPACC_C2_PUBLICATION_FRAME_COMPLETE&&
    !o->e10.busy&&w->record!=NULL&&(w->type==21U||w->type==27U)){
  unsigned slot;for(slot=0U;slot<2U;++slot)if(w->record==&o->manager->operations[slot]){
   PAPACC_C2_E10_PUBLICATION_FACT*f=w->type==21U?&o->e10.tls_ready_fact[slot]:&o->e10.final_fact[slot];
   if(w->length>=16U&&w->length-16U<=sizeof(f->bytes)&&
      ((w->type==21U&&w->length>=48U)||(w->type==27U&&w->length==92U))){
    f->sequence=o->e10.overflow?0U:event.sequence;f->connection=event.connection;f->operation=event.operation;f->generation=event.generation;
    f->length=w->length-16U;memcpy(f->bytes,w->bytes+16U,f->length);f->valid=PAPACC_TRUE;
   }
  }
 }
}if(o->observer!=NULL&&!o->e10.enabled)o->observer(o->observer_context,&event);}
static PAPACC_CHANNEL *channel_for(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_U64 connection){PAPACC_CHANNEL*c=papacc_channel_manager_find_by_connection(&o->loop->channel_manager,connection);return c!=NULL&&c->state==PAPACC_CHANNEL_STATE_BOUND?c:NULL;}
static int authority(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_C2_OWNER_WRITE*w){PAPACC_C2_OPERATION*r=w->record;PAPACC_CHANNEL*c;PAPACC_CONNECTION*connection;
 if(!valid(o)||o->secure->stop_state==PAPACC_SERVER_SECURE_STOP_ERROR_TERMINAL)return 0;
 if(r==NULL){PAPACC_C2_SESSION*s=w->denial_session;c=channel_for(o,w->connection);connection=papacc_connection_manager_find(o->loop->connection_manager,w->connection);return w->type==17U&&s!=NULL&&c!=NULL&&c->role==PAPACC_CHANNEL_ROLE_CONTROL&&c->session_instance_id==s->incarnation&&connection!=NULL&&connection->state==PAPACC_CONNECTION_STATE_ASSOCIATED&&papacc_c2_session_authorized(s,o->manager->owner,s->incarnation,s->principal,s->policy_epoch);}
 if(index_of(o,r)<0||r->id!=w->operation||r->generation!=w->generation||r->session==NULL)return 0;
 c=channel_for(o,w->connection);connection=papacc_connection_manager_find(o->loop->connection_manager,w->connection);
 if(c==NULL||connection==NULL||connection->state!=PAPACC_CONNECTION_STATE_ASSOCIATED||c->session_instance_id!=r->session->incarnation)return 0;
 if(w->type==27U){PAPACC_U8 payload[76];if(c->role!=PAPACC_CHANNEL_ROLE_CONTROL||r->final_written||(r->final_queued&&!w->pending))return 0;return papacc_c2_operation_final_payload(o->manager,r,payload)==0;}
 if(w->type==26U&&w->length!=0U){const PAPACC_U8*p=w->bytes+16;return c->role==PAPACC_CHANNEL_ROLE_CONTROL&&p[1]==2U&&p[3]==r->first_cause&&r->first_cause>=1U&&r->first_cause<=3U&&owner_read64(p+16)==r->id&&owner_read64(p+24)==r->generation&&owner_read64(p+32)==r->epoch;}
 if(!papacc_c2_operation_authorized(o->manager,r)||r->state==PAPACC_C2_OP_RETAINED)return 0;
 if(w->type==17U||w->type==21U||w->type==26U)return c->role==PAPACC_CHANNEL_ROLE_CONTROL;
 if(c->role!=PAPACC_CHANNEL_ROLE_DATA)return 0;
 if(w->length!=0U){const PAPACC_U8*p=w->bytes+16;unsigned role=w->type==19U?p[24]:p[16],flow;
  if(role<1U||role>2U||r->tokens.channels[role-1U]!=c->channel_instance_id)return 0;
  if(w->type==19U)return r->state==PAPACC_C2_OP_RESERVED&&r->tokens.claimed[role-1U]&&!r->tokens.ack_written[role-1U];
  flow=(role-1U)*2U+p[17];
  if(w->type==22U){PAPACC_SIZE amount=w->length-44U;return r->site_ready&&(role==2U||r->tls_ready_written)&&!r->flow[flow].sealed&&owner_read64(p+20)==r->flow[flow].submitted&&amount<=r->flow[flow].size&&memcmp(p+28,r->flow[flow].bytes,amount)==0;}
  if(w->type==24U)return r->flow[flow].fence_received&&!r->flow[flow].ack_written&&r->flow[flow].accepted==owner_read64(p+20)&&r->flow[flow].accepted==r->flow[flow].fence&&r->flow[flow].size==0U;
  if(w->type==23U){PAPACC_C3_BRIDGE*b=o->bridges[index_of(o,r)];if(b==NULL||b->retained||r->flow[flow].fence_written||r->flow[flow].size||owner_read64(p+20)!=r->flow[flow].submitted)return 0;return role==1U?b->tls_complete:(b->child_destroyed&&b->ab_eof&&b->ab.size==0U&&b->ab.received==b->ab.accepted);}
 }
 return (r->tokens.channels[0]==c->channel_instance_id||r->tokens.channels[1]==c->channel_instance_id);
}
static void retire_write(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_C2_OWNER_WRITE*w){PAPACC_C2_OPERATION*r=w->record;
 if(w->secret_borrow)(void)papacc_c2_tokens_quiescent(&r->tokens,o->manager->owner);
 if(r!=NULL&&r->callbacks!=0U)--r->callbacks;SecureZeroMemory(w,sizeof(*w));
}
PAPACC_RESULT papacc_server_c2_owner_win32_install(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_SERVER_IO_LOOP_WIN32*l,PAPACC_SERVER_SECURE_IO_WIN32*s,PAPACC_C2_OPERATION_MANAGER*m){
 if(o==NULL||l==NULL||s==NULL||m==NULL)return PAPACC_RESULT_INVALID_ARGUMENT;
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
 /* Administrative apply is not attachment permission. Preserve its leases;
  * the old installer must not memset an applied/retained configuration. */
 if(o->configuration.state!=PAPACC_C2_CONFIG_EMPTY)return PAPACC_RESULT_NOT_SUPPORTED;
#endif
 if(o->initialized||!l->initialized||!s->initialized||s->protocol_loop!=l||!m->initialized||s->owner_thread_id!=(PAPACC_U32)GetCurrentThreadId()||m->owner!=s->owner_thread_id||l->c2_owner!=NULL)return PAPACC_RESULT_INVALID_STATE;
 {PAPACC_RESULT partition=papacc_pst_secure_scheduler_enable_partition(&s->scheduler);if(partition!=PAPACC_RESULT_OK)return partition;}
 memset(o,0,sizeof(*o));o->loop=l;o->secure=s;o->manager=m;o->initialized=PAPACC_TRUE;o->wake_credits=8U;l->c2_owner=o;
 {PAPACC_CAPABILITY_KEY key={3U,1U};PAPACC_RESULT result=papacc_capability_registry_register(&l->capability_registry,&key,"MODE_C_OPERATION");if(result==0)result=papacc_capability_set_insert(&l->supported_capabilities,&key);if(result==0)result=papacc_capability_set_insert(&l->enabled_capabilities,&key);if(result!=0){l->c2_owner=NULL;o->initialized=PAPACC_FALSE;return result;}}
 return PAPACC_RESULT_OK;
}
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
PAPACC_RESULT papacc_server_c2_owner_win32_attach_closed(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_SERVER_IO_LOOP_WIN32*l,PAPACC_SERVER_SECURE_IO_WIN32*s)
{
 PAPACC_RESULT result;
 if(!o||!l||!s||papacc_server_c2_configuration_validate(o)!=PAPACC_RESULT_OK||
    o->configuration.state!=PAPACC_C2_CONFIG_CURRENT||!o->configuration.epoch||o->configuration.io_attached||
    !l->initialized||l->acceptor!=NULL||l->c2_owner||!s->initialized||s->protocol_loop!=l||
    !s->c2_finish_role_fn||s->security_composition!=o->configuration.secure_lease||
    s->owner_thread_id!=GetCurrentThreadId()||!s->scheduler.initialized)return PAPACC_RESULT_INVALID_STATE;
 result=papacc_pst_secure_scheduler_enable_partition(&s->scheduler);if(result!=PAPACC_RESULT_OK)return result;
 o->loop=l;o->secure=s;o->wake_credits=8U;o->initialized=PAPACC_TRUE;l->c2_owner=o;o->configuration.io_attached=PAPACC_TRUE;
 return PAPACC_RESULT_OK;
}
PAPACC_RESULT papacc_server_c2_owner_win32_detach_closed(PAPACC_SERVER_C2_OWNER_WIN32*o)
{
 if(!o||!o->configuration.io_attached||!o->loop||!o->secure||o->loop->acceptor||
    o->configuration.state!=PAPACC_C2_CONFIG_CURRENT||papacc_server_c2_owner_win32_has_dependencies(o))return PAPACC_RESULT_INVALID_STATE;
 if(o->secure->initialized||o->secure->scheduler.initialized)return PAPACC_RESULT_INVALID_STATE;
 o->loop->c2_owner=NULL;o->loop=NULL;o->secure=NULL;o->initialized=PAPACC_FALSE;o->configuration.io_attached=PAPACC_FALSE;
 return PAPACC_RESULT_OK;
}
#endif
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
PAPACC_RESULT papacc_server_c2_owner_win32_wire_control(PAPACC_SERVER_C2_OWNER_WIN32 *o,PAPACC_POST_CONTROL_PROCESSOR *p)
{
 if(p==NULL)return PAPACC_RESULT_INVALID_ARGUMENT;
 /* Even missing ownership cannot fall back to the generic ALLOW callback. */
 p->capability_inputs.principal_policy=papacc_server_c2_owner_win32_capability_policy;
 p->capability_inputs.principal_policy_context=p;p->c2_control=NULL;p->c2_context=NULL;
 if(!valid(o))return PAPACC_RESULT_INVALID_STATE;
 p->c2_control=papacc_server_c2_owner_win32_control;p->c2_context=o;return PAPACC_RESULT_OK;
}
#endif
PAPACC_RESULT papacc_server_c2_owner_win32_queue(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_C2_OPERATION*r,PAPACC_U64 generation,PAPACC_U64 connection,PAPACC_U16 type,const PAPACC_U8*p,PAPACC_SIZE n){PAPACC_C2_OWNER_WRITE candidate,*w=NULL;PAPACC_CHANNEL*c;PAPACC_C2_CHANNEL role;unsigned i;PAPACC_RESULT result;
 if(!valid(o)||index_of(o,r)<0)return PAPACC_RESULT_INVALID_STATE;
 memset(&candidate,0,sizeof(candidate));candidate.connection=connection;candidate.operation=r->id;candidate.generation=generation;candidate.type=type;candidate.record=r;
 observe(o,&candidate,PAPACC_C2_PUBLICATION_ATTEMPT,0,0);
 if(!authority(o,&candidate)){observe(o,&candidate,PAPACC_C2_PUBLICATION_REJECTED,0,PAPACC_RESULT_INVALID_STATE);return PAPACC_RESULT_INVALID_STATE;}
 for(i=0;i<6U;++i){if((o->writes[i].pending||o->writes[i].quarantined)&&o->writes[i].connection==connection)return PAPACC_RESULT_INVALID_STATE;if(!o->writes[i].pending&&!o->writes[i].quarantined)w=&o->writes[i];}
 if(w==NULL||r->callbacks>=16U)return PAPACC_RESULT_LIMIT_EXCEEDED;
 c=channel_for(o,connection);role=c->role==PAPACC_CHANNEL_ROLE_CONTROL?PAPACC_C2_CONTROL:PAPACC_C2_ROLE_CHANNEL;
 result=papacc_c2_encode_frame(type,p,n,role,PAPACC_C2_ACCELERATOR,candidate.bytes,sizeof(candidate.bytes),&candidate.length);if(result!=0)return result;
 if(!authority(o,&candidate)){observe(o,&candidate,PAPACC_C2_PUBLICATION_REJECTED,0,PAPACC_RESULT_INVALID_STATE);SecureZeroMemory(&candidate,sizeof(candidate));return PAPACC_RESULT_INVALID_STATE;}
 if(type==17U&&(r->tokens.grant_written||n!=108U||memcmp(p,r->result,108)!=0)){SecureZeroMemory(&candidate,sizeof(candidate));return PAPACC_RESULT_INVALID_STATE;}
 if(type==21U){int bi=index_of(o,r);PAPACC_C3_BRIDGE*b=o->bridges[bi];if(b==NULL||!b->tls_verified||r->state!=PAPACC_C2_OP_HANDSHAKE||memcmp(p,r->tokens.identity,24)!=0||n!=32U+b->selected_alpn_size||memcmp(p+32,b->selected_alpn,b->selected_alpn_size)!=0){SecureZeroMemory(&candidate,sizeof(candidate));return PAPACC_RESULT_INVALID_STATE;}r->tls_fact=1U;}
 if(type!=17U&&type!=27U&&type!=26U&&memcmp(p,r->tokens.identity,type==22U||type==23U||type==24U||type==25U?16U:24U)!=0){SecureZeroMemory(&candidate,sizeof(candidate));return PAPACC_RESULT_INVALID_STATE;}
 if(type==27U){PAPACC_U8 final[76];if(papacc_c2_operation_final_payload(o->manager,r,final)!=0||memcmp(p,final,76)!=0){SecureZeroMemory(&candidate,sizeof(candidate));return PAPACC_RESULT_INVALID_STATE;}}

 if(type==17U){result=papacc_c2_tokens_borrow(&r->tokens,o->manager->owner);if(result!=0){SecureZeroMemory(&candidate,sizeof(candidate));return result;}candidate.secret_borrow=PAPACC_TRUE;}
 if(type==17U)o->control_connections[index_of(o,r)]=connection;
 candidate.pending=PAPACC_TRUE;if(type==27U)r->final_queued=PAPACC_TRUE;++r->callbacks;*w=candidate;SecureZeroMemory(&candidate,sizeof(candidate));observe(o,w,PAPACC_C2_PUBLICATION_AUTHORIZED,0,0);return PAPACC_RESULT_OK;
}
#include "server_c2_owner_step_win32.inc"
PAPACC_RESULT papacc_server_c2_owner_win32_bind_bridge(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_C2_OPERATION*r,PAPACC_C3_BRIDGE*b){int i;
 if(!valid(o)||(i=index_of(o,r))<0||b==NULL||!b->initialized||b->owner_thread!=o->secure->owner_thread_id||b->operation!=r->id||b->generation!=r->generation||b->scheduler!=&o->secure->scheduler||o->bridges[i]!=NULL)return PAPACC_RESULT_INVALID_STATE;
 {PAPACC_SIZE original=((PAPACC_SIZE)r->open[24]<<8)|r->open[25],canonical=((PAPACC_SIZE)r->open[26]<<8)|r->open[27],alpn=((PAPACC_SIZE)r->open[34]<<8)|r->open[35];
  if(o->secure->dispatch_active||b->processor.connection==NULL||b->expected_name_size!=canonical||memcmp(b->expected_name,r->open+40+original,canonical)!=0||b->alpn_offer_bytes!=alpn||memcmp(b->alpn_offers,r->open+40+original+canonical,alpn)!=0||(r->open[32]!=0U&&!b->require_alpn))return PAPACC_RESULT_INVALID_STATE;
 }
 o->bridges[i]=b;r->resources_created=PAPACC_TRUE;return PAPACC_RESULT_OK;
}
PAPACC_RESULT papacc_server_c2_owner_win32_stop(PAPACC_SERVER_C2_OWNER_WIN32*o){unsigned i;PAPACC_RESULT result,first=0;if(!valid(o))return PAPACC_RESULT_INVALID_STATE;
 result=papacc_c2_operation_stop(o->manager);e10_boundary(o,NULL,0U,PAPACC_C2_E10_STOP_RETURN,0U,result,NULL,0U);if(result!=0)return result;
 if(o->secure->dispatch_active)return PAPACC_RESULT_OK; /* Logical revoke only; defer native membership/release until dispatch quiescence. */
 for(i=0;i<2U;++i){PAPACC_C3_BRIDGE*b=o->bridges[i];PAPACC_C2_OPERATION*r=&o->manager->operations[i];if(b==NULL)continue;
  if(!b->retained&&!b->child_destroyed&&!o->child_release_attempted[i]){(void)papacc_c3_bridge_revoke(b);o->child_release_attempted[i]=PAPACC_TRUE;result=papacc_c3_bridge_release_child(b);e10_boundary(o,r,0U,PAPACC_C2_E10_RELEASE_RETURN,0U,result,NULL,0U);if(result!=0&&first==0)first=result;}
  if(b->retained){r->ownership=3;r->state=PAPACC_C2_OP_RETAINED;(void)papacc_c2_tokens_revoke(&r->tokens,o->manager->owner,PAPACC_TRUE);o->secure->stop_state=PAPACC_SERVER_SECURE_STOP_ERROR_TERMINAL;if(o->secure->stop_last_remove_result==0)o->secure->stop_last_remove_result=PAPACC_RESULT_INTERNAL_ERROR;first=o->secure->stop_last_remove_result;}
 }
 return first;
}
PAPACC_BOOL papacc_server_c2_owner_win32_has_dependencies(const PAPACC_SERVER_C2_OWNER_WIN32*o){unsigned i;if(o==NULL||!o->initialized)return PAPACC_FALSE;
 for(i=0;i<2U;++i){const PAPACC_C2_OPERATION *r=&o->manager->operations[i];
  if(r->state!=PAPACC_C2_OP_EMPTY&&!(r->state==PAPACC_C2_OP_RELEASED&&
   r->cleanup_confirmed&&r->ownership==1U&&(r->final_written||r->summary_unavailable)&&
   r->callbacks==0U&&r->tokens.borrowers==0U))return PAPACC_TRUE;
 }
 for(i=0;i<6U;++i)if(o->writes[i].pending||o->writes[i].quarantined)return PAPACC_TRUE;
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
 for(i=0U;i<4U;++i)if(o->sessions[i].initialized)return PAPACC_TRUE;
#endif
 return PAPACC_FALSE;
}

static PAPACC_RESULT owner_reap_completed(PAPACC_SERVER_C2_OWNER_WIN32 *o);
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
/* Quiescent operation metadata collection precedes Session retirement. Neither
 * collector consumes readiness, calls PST/native close, clears a live operation,
 * nor resolves retention. No new OPEN is required. */
/* Metadata retirement only. Never consumes readiness, calls PST, closes a
 * transport, clears a live operation, or resolves a Model E retention. */
PAPACC_RESULT papacc_server_c2_owner_win32_retire_sessions(PAPACC_SERVER_C2_OWNER_WIN32 *o)
{
 PAPACC_SIZE i,j;PAPACC_RESULT result;
 if(!valid(o)||o->secure->dispatch_active||!o->loop->session_manager.initialized||
    !o->loop->channel_manager.initialized||o->configuration.state==PAPACC_C2_CONFIG_RETAINED||
    o->secure->stop_state==PAPACC_SERVER_SECURE_STOP_ERROR_TERMINAL)return PAPACC_RESULT_INVALID_STATE;
 result=owner_reap_completed(o);if(result!=PAPACC_RESULT_OK)return result;
 for(i=0U;i<4U;++i){PAPACC_C2_SESSION *s=&o->sessions[i];int borrowed=0;
  if(!s->initialized||s->state!=PAPACC_C2_SESSION_REVOKED||!s->incarnation||
     papacc_session_manager_find(&o->loop->session_manager,s->incarnation))continue;
  if(s->control_connection&&papacc_connection_manager_find(o->loop->connection_manager,s->control_connection))borrowed=1;
  /* Even stale references in an EMPTY record block reuse until that record's
   * governed cleanup has cleared them. Includes callbacks/token borrowers. */
  for(j=0U;j<2U;++j)if(o->manager->operations[j].session==s)borrowed=1;
  for(j=0U;j<6U;++j)if(o->writes[j].denial_session==s||
    (o->writes[j].record&&o->writes[j].record->session==s))borrowed=1;
  for(j=0U;j<o->loop->channel_manager.capacity;++j)
   if(o->loop->channel_manager.storage[j].state!=PAPACC_CHANNEL_STATE_UNINITIALIZED&&
      o->loop->channel_manager.storage[j].session_instance_id==s->incarnation)borrowed=1;
  for(j=0U;j<o->loop->processor_capacity;++j){PAPACC_SERVER_PROTOCOL_SLOT_WIN32 *p=&o->loop->processor_slots[j];
   if(p->in_use&&((s->control_connection&&p->connection_instance_id==s->control_connection)||
      (p->kind==PAPACC_SERVER_PROTOCOL_SLOT_KIND_POST_CONTROL&&p->post_control_processor.session_instance_id==s->incarnation)))borrowed=1;
  }
  for(j=0U;j<o->secure->candidate_capacity;++j){PAPACC_SERVER_SECURE_CANDIDATE_WIN32 *c=&o->secure->candidates[j];
   if(c->control_close_result.session_instance_id==s->incarnation||
      (s->control_connection&&c->connection_instance_id==s->control_connection)){
    if(c->state!=PAPACC_SERVER_SECURE_CANDIDATE_CLOSED||c->secure_processor.connection||
       c->secure_processor.state==PAPACC_PST_SECURE_PROCESSOR_RETAINED_TERMINAL||
       c->session_security.published||c->transport_adapter.registered||
       papacc_connection_manager_find(o->loop->connection_manager,c->connection_instance_id))borrowed=1;
   }
  }
  if(borrowed)continue;
  for(j=0U;j<4U;++j)if(o->manager->sessions[j].session==s)
   SecureZeroMemory(&o->manager->sessions[j],sizeof(o->manager->sessions[j]));
  /* Native ID allocator and operation ID/generation counters are untouched.
   * Only terminal, unreferenced logical metadata becomes reusable storage. */
  SecureZeroMemory(s,sizeof(*s));
