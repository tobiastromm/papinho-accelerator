#ifndef PAPACC_C8_PRIVATE_STORAGE_PROFILE
static PAPACC_RESULT owner_reap_retired_sessions(PAPACC_SERVER_C2_OWNER_WIN32 *o){
 unsigned i,j;PAPACC_RESULT result=owner_reap_completed(o);if(result!=0)return result;
 for(i=0;i<4U;++i){PAPACC_C2_SESSION*s=&o->sessions[i];PAPACC_BOOL borrowed=PAPACC_FALSE;
  if(!s->initialized||s->state!=PAPACC_C2_SESSION_REVOKED||papacc_session_manager_find(&o->loop->session_manager,s->incarnation)!=NULL)continue;
  for(j=0;j<2U;++j)if(o->manager->operations[j].state!=PAPACC_C2_OP_EMPTY&&o->manager->operations[j].session==s)borrowed=PAPACC_TRUE;
  for(j=0;j<6U;++j)if((o->writes[j].pending||o->writes[j].quarantined)&&(o->writes[j].denial_session==s||(o->writes[j].record!=NULL&&o->writes[j].record->session==s)))borrowed=PAPACC_TRUE;
  for(j=0;j<o->secure->candidate_capacity;++j){PAPACC_SERVER_SECURE_CANDIDATE_WIN32*c=&o->secure->candidates[j];
   if(c->control_close_result.session_instance_id==s->incarnation&&(c->state!=PAPACC_SERVER_SECURE_CANDIDATE_CLOSED||c->secure_processor.connection!=NULL||c->session_security.published))borrowed=PAPACC_TRUE;
  }
  if(borrowed)continue;
  for(j=0;j<4U;++j)if(o->manager->sessions[j].session==s)SecureZeroMemory(&o->manager->sessions[j],sizeof(o->manager->sessions[j]));
  /* Native Session is gone; all operation generations/writes quiescent.
   * Only logical metadata is retired. No PST call, close or ID reset here. */
  if(o->observer!=NULL)fprintf(stderr,"ED11_C2_SESSION_METADATA_REAP incarnation=%llu native_session_absent=1 operation_refs=0 writer_refs=0 operation_id_counter=%llu\n",(unsigned long long)s->incarnation,(unsigned long long)o->manager->next_operation);
  SecureZeroMemory(s,sizeof(*s));
 }
 return PAPACC_RESULT_OK;
}
