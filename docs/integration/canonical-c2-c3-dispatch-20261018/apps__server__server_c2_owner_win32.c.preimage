 if(type==26U){e10_boundary(o,NULL,channel->connection_instance_id,PAPACC_C2_E10_CONTROL_BEFORE,type,0,p,n);result=papacc_c2_operation_cancel(o->manager,s,p,n);e10_boundary(o,NULL,channel->connection_instance_id,PAPACC_C2_E10_CONTROL_RETURN,type,result,p,n);causal_observe(o,sid,0,"CANCEL_RETURN",type,n==40U?p[3]:0U);return result;}
 if(type==20U){
  for(i=0;i<2U;++i)if(o->manager->operations[i].state!=PAPACC_C2_OP_EMPTY&&o->manager->operations[i].session==s)r=&o->manager->operations[i];
  if(r==NULL)return PAPACC_RESULT_PROTOCOL_ERROR;
