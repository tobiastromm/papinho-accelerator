 return papacc_server_launcher_c2_capability_policy((PAPACC_POST_CONTROL_PROCESSOR *)context,key,decision);
#else
PAPACC_POST_CONTROL_PROCESSOR*p=(PAPACC_POST_CONTROL_PROCESSOR*)context;PAPACC_SERVER_C2_OWNER_WIN32*o;PAPACC_SIZE i;
 static const PAPACC_U8 offer[28]={0,2,0,2,0,0,0,2,0,1,0,0,0,3,0,1,0,0,0,2,0,1,0,0,0,3,0,1};
 if(p==NULL||key==NULL||decision==NULL)return PAPACC_RESULT_INVALID_ARGUMENT;
 *decision=PAPACC_CAPABILITY_POLICY_ALLOW;if(key->id!=3U)return PAPACC_RESULT_OK;*decision=PAPACC_CAPABILITY_POLICY_DENY;
 o=(PAPACC_SERVER_C2_OWNER_WIN32*)p->c2_context;
 if(!valid(o)||key->major!=1U||p->capability_payload_received!=28U||memcmp(p->capability_payload,offer,28)!=0)return PAPACC_RESULT_OK;
 for(i=0;i<o->secure->candidate_capacity;++i){PAPACC_SERVER_SECURE_CANDIDATE_WIN32*c=&o->secure->candidates[i];if(c->state==PAPACC_SERVER_SECURE_CANDIDATE_PROTOCOL&&c->connection_instance_id==p->connection->connection_instance_id&&c->connection_security.state==PAPACC_SECURITY_CONTEXT_AUTHORIZED&&c->session_security.published==PAPACC_TRUE&&c->session_security.principal.valid==PAPACC_TRUE)*decision=PAPACC_CAPABILITY_POLICY_ALLOW;}
 return PAPACC_RESULT_OK;

#endif
}

/* Tokens are scheduler identities, not operation IDs. Match both live token and
 * exact source before capturing flags. Never call PST or mutate membership here. */
PAPACC_RESULT papacc_server_c2_owner_win32_collect_ready(
 PAPACC_SERVER_C2_OWNER_WIN32 *o,const PAPACC_PST_READY_EVENT *event,
 PAPACC_BOOL *handled)
{
 PAPACC_SIZE mi;unsigned i;PAPACC_PST_SCHEDULER_MEMBER *member=NULL;
 if(handled==NULL||event==NULL)return PAPACC_RESULT_INVALID_ARGUMENT;
 *handled=PAPACC_FALSE;if(!valid(o))return PAPACC_RESULT_INVALID_STATE;
 for(mi=0;mi<o->secure->scheduler.member_capacity;++mi){
  PAPACC_PST_SCHEDULER_MEMBER *m=&o->secure->scheduler.members[mi];
  if(m->registered&&m->token==event->token&&m->kind==event->kind){member=m;break;}
 }
 if(member==NULL)return PAPACC_RESULT_OK;
 for(i=0;i<2U;++i){
  PAPACC_C3_BRIDGE *b=o->bridges[i];PAPACC_C2_OPERATION *r=&o->manager->operations[i];
  PAPACC_PST_READY_EVENT *saved;PAPACC_BOOL *pending;
  if(b==NULL||!b->initialized||r->state==PAPACC_C2_OP_EMPTY||
   b->operation!=r->id||b->generation!=r->generation)continue;
  if(member->kind==PAPACC_PST_SCHEDULER_MEMBER_CONNECTION&&
   member->source.connection==b->processor.connection){
   saved=&o->child_ready[i];pending=&o->child_ready_pending[i];
  }else if(member->kind==PAPACC_PST_SCHEDULER_MEMBER_EXTERNAL&&
   member->source.external_source==b->peer_source){
   saved=&o->peer_ready[i];pending=&o->peer_ready_pending[i];
  }else continue;
  *handled=PAPACC_TRUE;
  /* Retention/Stop cannot regain authority from readiness. */
  if(r->revoked||b->revoked||b->retained||!r->site_ready)return PAPACC_RESULT_OK;
  if(!*pending||saved->token!=event->token){*saved=*event;*pending=PAPACC_TRUE;}
  else{saved->read_ready|=event->read_ready;saved->write_ready|=event->write_ready;
   saved->terminal|=event->terminal;if(saved->source_result==PST_RESULT_OK)
    saved->source_result=event->source_result;}
  return PAPACC_RESULT_OK;
 }
 return PAPACC_RESULT_OK;
}

static PAPACC_U64 owner_channel_connection(PAPACC_SERVER_C2_OWNER_WIN32 *o,
 PAPACC_C2_OPERATION *r,unsigned role)
{
 PAPACC_CHANNEL *ch=role?papacc_channel_manager_find(&o->loop->channel_manager,
  r->tokens.channels[role-1U]):papacc_channel_manager_find_control(
  &o->loop->channel_manager,r->session->incarnation);
 return ch!=NULL&&ch->state==PAPACC_CHANNEL_STATE_BOUND?
  ch->connection_instance_id:0U;
}
static void owner_put64(PAPACC_U8 *p,PAPACC_U64 n)
{unsigned i=8U;while(i--){p[i]=(PAPACC_U8)n;n>>=8;}}
PAPACC_RESULT papacc_server_c2_owner_win32_configure_site(
 PAPACC_SERVER_C2_OWNER_WIN32 *o,pst_runtime *runtime,
 const PST_CONNECTION_CONFIG *config,PAPACC_CONNECTION_MANAGER *manager,
 PAPACC_C3_BRIDGE *storage,PAPACC_C2_CAPACITY_GATE capacity,void *context)
{
 unsigned i;
 if(!valid(o)||o->secure->dispatch_active||o->site_configured||runtime==NULL||
  config==NULL||manager==NULL||!manager->initialized||storage==NULL||capacity==NULL)
  return PAPACC_RESULT_INVALID_STATE;
 for(i=0;i<2U;++i)if(storage[i].initialized||o->bridges[i]!=NULL)
  return PAPACC_RESULT_INVALID_STATE;
 o->site_runtime=runtime;o->site_template=*config;o->site_manager=manager;
 o->site_storage=storage;o->site_capacity=capacity;o->site_capacity_context=context;
 o->site_configured=PAPACC_TRUE;return PAPACC_RESULT_OK;
}
static PAPACC_RESULT owner_activate(PAPACC_SERVER_C2_OWNER_WIN32 *o,
 PAPACC_C2_OPERATION *r,unsigned index)
{
 PST_CONNECTION_CONFIG config;PAPACC_SIZE original,canonical,cursor,end,count=0;
 PAPACC_BOOL capacity=PAPACC_FALSE;PAPACC_RESULT result;PAPACC_U64 now_ns,now_ms,remaining_ms;
 if(!o->site_configured)return PAPACC_RESULT_OK; /* Default stays closed. */
#ifdef PAPACC_ENABLE_CANONICAL_C8_ROOT
 {
  PAPACC_SITE_TLS_CATALOG profile;PAPACC_U32 reference;
  reference=((PAPACC_U32)r->open[28]<<24)|((PAPACC_U32)r->open[29]<<16)|((PAPACC_U32)r->open[30]<<8)|r->open[31];
  if(papacc_server_launcher_c2_site_template(r->session,reference,&o->site_template,&profile)!=PAPACC_RESULT_OK)
   return papacc_c2_operation_revoke(o->manager,r,12U);
 }
#endif
 result=o->site_capacity(o->site_capacity_context,sizeof(*o)+sizeof(*o->manager)+
  2U*sizeof(PAPACC_C3_BRIDGE),&capacity);
 if(result!=0||!capacity)return papacc_c2_operation_revoke(o->manager,r,12U);
 if(!papacc_c2_operation_authorized(o->manager,r)||!r->site_ready||
  !r->tokens.ack_written[0]||!r->tokens.ack_written[1])return PAPACC_RESULT_INVALID_STATE;
 original=((PAPACC_SIZE)r->open[24]<<8)|r->open[25];
 canonical=((PAPACC_SIZE)r->open[26]<<8)|r->open[27];
 config=o->site_template;
 config.peer_authentication.expected_peer_name=(const char*)r->open+40U+original;
 config.peer_authentication.expected_peer_name_size=canonical;
 config.server_name_indication=config.peer_authentication.expected_peer_name;
 config.server_name_indication_size=canonical;config.server_name_indication_mode=PST_SNI_MODE_EXPLICIT;
 cursor=40U+original+canonical;end=r->open_length;
 while(cursor<end&&count<8U){PAPACC_SIZE size=r->open[cursor++];
  if(size==0U||size>end-cursor)return PAPACC_RESULT_INVALID_STATE;
  o->site_alpn[index][count].data=r->open+cursor;
  o->site_alpn[index][count++].size=size;cursor+=size;
 }
 if(cursor!=end)return PAPACC_RESULT_INVALID_STATE;
 config.alpn.protocols=o->site_alpn[index];config.alpn.protocol_count=count;
 if(r->open[32])config.alpn.mode=PST_FEATURE_REQUIRED;
 /* Processor deadlines are PAL/QPC nanoseconds, while operation absolute
  * budgets use GetTickCount64 milliseconds. Translate only remaining duration. */
 result=papacc_pal_monotonic_time_ns(&now_ns);if(result!=0)return result;
 now_ms=(PAPACC_U64)GetTickCount64();
 if(now_ms>=r->deadline_ms)return papacc_c2_operation_revoke(o->manager,r,3U);
 remaining_ms=r->deadline_ms-now_ms;
 if(remaining_ms>((PAPACC_U64)-1-now_ns)/1000000U)return PAPACC_RESULT_INVALID_STATE;
 /* Install dependency ownership BEFORE any partial native acquisition. */
 o->site_storage[index].peer=o->site_storage[index].setup_connector=o->site_storage[index].setup_listener=INVALID_SOCKET;
 o->bridges[index]=&o->site_storage[index];r->resources_created=PAPACC_TRUE;
 result=papacc_c3_bridge_init(o->bridges[index],o->site_runtime,&config,
  &o->secure->scheduler,o->site_manager,r->id,r->generation,
  now_ns+remaining_ms*1000000U);
 if(result!=0){
  PAPACC_RESULT revoked=papacc_c2_operation_revoke(o->manager,r,12U);
  PAPACC_C3_BRIDGE *b=o->bridges[index];
  /* A rejected private tuple belongs to this operation. Ownership of every
   * partial acquisition was installed above; normal termination reconciles it.
   * Do not convert this contained attach rejection into a root owner failure.
   * Retention or unknown internal errors still propagate without fallback. */
  if(revoked==PAPACC_RESULT_OK&&b->initialized&&b->child_acquired&&b->revoked&&
   b->source_result==PST_RESULT_PROTOCOL_FAILURE&&!b->retained&&!b->bound&&
   !b->registered&&!b->published)return PAPACC_RESULT_OK;
 }
 return result;
}
static PAPACC_RESULT owner_queue_data(PAPACC_SERVER_C2_OWNER_WIN32 *o,
 PAPACC_C2_OPERATION *r,unsigned flow)
{
 PAPACC_U8 payload[16384];PAPACC_SIZE n=r->flow[flow].size;
 PAPACC_U64 connection=owner_channel_connection(o,r,flow/2U+1U);
 if(n==0U||connection==0U||c7_stall(o,r,flow)||papacc_server_c2_owner_win32_wants_write(o,connection))
  return PAPACC_RESULT_OK;
 if(n>16356U)n=16356U;
 memset(payload,0,28U);memcpy(payload,r->tokens.identity,16U);
 payload[16]=(PAPACC_U8)(flow/2U+1U);payload[17]=1U;
 owner_put64(payload+20,r->flow[flow].submitted);
 memcpy(payload+28,r->flow[flow].bytes,n);
 return papacc_server_c2_owner_win32_queue(o,r,r->generation,connection,22U,payload,28U+n);
}

static PAPACC_RESULT owner_queue_fence(PAPACC_SERVER_C2_OWNER_WIN32 *o,
 PAPACC_C2_OPERATION *r,unsigned flow,PAPACC_BOOL ack)
{
 PAPACC_U8 p[32];PAPACC_U64 connection=owner_channel_connection(o,r,flow/2U+1U);
 /* Diagnostic fixture holds only the legitimate exact-prefix BA ACK; it never creates an ACK. */
 if(ack&&flow==2U&&o->c7_stall_event&&o->c7_stall_flow==4U){
  PAPACC_BOOL first=o->c7_stall_operation==0U;
  if(c7_stall(o,r,4U)){if(first)fprintf(stderr,"ADR0037_BA_ACK_HELD operation=%llu generation=%llu prefix=%llu received=%llu accepted=%llu fence_received=%u\n",(unsigned long long)r->id,(unsigned long long)r->generation,(unsigned long long)r->flow[2].fence,(unsigned long long)r->flow[2].submitted,(unsigned long long)r->flow[2].accepted,(unsigned)r->flow[2].fence_received);return PAPACC_RESULT_OK;}
 }
 if(connection==0U||papacc_server_c2_owner_win32_wants_write(o,connection))return PAPACC_RESULT_OK;
 memset(p,0,sizeof(p));memcpy(p,r->tokens.identity,16U);
 p[16]=(PAPACC_U8)(flow/2U+1U);p[17]=(PAPACC_U8)(flow%2U);
 owner_put64(p+20,ack?r->flow[flow].fence:r->flow[flow].submitted);
 if(!ack)p[29]=1U;
 return papacc_server_c2_owner_win32_queue(o,r,r->generation,connection,ack?24U:23U,p,sizeof(p));
}
static PAPACC_RESULT owner_close_pipeline(PAPACC_SERVER_C2_OWNER_WIN32 *o,
 PAPACC_C2_OPERATION *r,PAPACC_C3_BRIDGE *b,unsigned index)
{
 PAPACC_RESULT result;PAPACC_BOOL closed=PAPACC_FALSE,all_closed=PAPACC_TRUE;unsigned role;
 if(r->flow[0].fence_received&&!r->flow[0].ack_written&&
  r->flow[0].size==0U&&r->flow[0].accepted==r->flow[0].fence){
  result=owner_queue_fence(o,r,0U,PAPACC_TRUE);if(result!=0)return result;
 }
 if(b->processor.state==PAPACC_PST_SECURE_PROCESSOR_PEER_CLOSED){
  if(b->processor.last_close_kind!=PST_CLOSE_CLEAN){(void)papacc_c2_operation_revoke(o->manager,r,9U);r->tls_fact=3U;return PAPACC_RESULT_OK;}
  if(r->flow[0].size||o->plaintext_pending_size[index]){(void)papacc_c2_operation_revoke(o->manager,r,9U);return PAPACC_RESULT_OK;}
  if(r->flow[0].ack_written&&r->flow[1].size==0U){
   if(r->state!=PAPACC_C2_OP_SHUTDOWN){r->state=PAPACC_C2_OP_SHUTDOWN;r->deadline_ms=GetTickCount64()+5000U;}
   result=papacc_c3_bridge_shutdown_once(b);if(result!=0)return result;
  }
 }else if(b->processor.state==PAPACC_PST_SECURE_PROCESSOR_SHUTTING_DOWN){
  result=papacc_c3_bridge_shutdown_once(b);if(result!=0)return result;
 }
 if(b->tls_complete){r->reciprocal_complete=PAPACC_TRUE;r->tls_fact=2U;
  if(b->registered&&!b->child_destroyed&&!b->retained){result=papacc_pst_secure_scheduler_suspend_complete(b->scheduler,b->processor.connection);if(result!=PAPACC_RESULT_OK)return result;}
  if(r->flow[1].size==0U&&!r->flow[1].fence_written){result=owner_queue_fence(o,r,1U,PAPACC_FALSE);if(result!=0)return result;}
 }
 if(r->reciprocal_complete&&r->flow[1].fence_written&&r->flow[2].fence_received&&
  r->flow[2].accepted==r->flow[2].fence&&r->flow[2].size==0U){
  if(!b->ba_frozen){result=papacc_c3_bridge_freeze_ba(b);if(result!=0)return result;}
  if(!r->flow[2].ack_written){result=owner_queue_fence(o,r,2U,PAPACC_TRUE);if(result!=0)return result;}
  else if(!b->ba_ack_written){result=papacc_c3_bridge_ba_ack_written(b);if(result!=0)return result;}
 }
 if(b->ba_ack_written&&r->flow[0].ack_written&&r->flow[1].ack_received&&
  !b->child_destroyed&&!o->child_release_attempted[index]){
  o->child_release_attempted[index]=PAPACC_TRUE;result=papacc_c3_bridge_release_child(b);e10_boundary(o,r,0U,PAPACC_C2_E10_RELEASE_RETURN,0U,result,NULL,0U);
  if(b->release_info.disposition==PST_RELEASE_DISPOSITION_CLOSE_UNRESOLVED_RETAINED||
   b->release_info.disposition==PST_RELEASE_DISPOSITION_PRECONDITION_RETAINED){
   (void)papacc_c2_operation_revoke(o->manager,r,13U);
   r->ownership=b->release_info.disposition==PST_RELEASE_DISPOSITION_CLOSE_UNRESOLVED_RETAINED?3U:2U;
   r->state=PAPACC_C2_OP_RETAINED;
   (void)papacc_c2_tokens_revoke(&r->tokens,o->manager->owner,PAPACC_TRUE);
   return PAPACC_RESULT_OK;
  }
  if(result!=0)return result;
 }
 if(b->child_destroyed)r->child_destroyed=PAPACC_TRUE;
 if(b->child_destroyed&&b->ab_eof&&b->ab.size==0U&&b->ab.accepted==b->ab.received){
  r->ordered_eof=PAPACC_TRUE;
  if(!b->ab_sealed){result=papacc_c3_bridge_seal_ab(b,r->id,r->generation);if(result!=0)return result;}
  if(!r->flow[3].fence_written){result=owner_queue_fence(o,r,3U,PAPACC_FALSE);if(result!=0)return result;}
 }
 if(r->ordered_eof&&r->flow[3].ack_received&&r->flow[1].ack_received&&
  r->flow[2].ack_written&&r->flow[0].ack_written){
  if(b->peer!=INVALID_SOCKET||b->peer_source!=NULL||b->setup_connector!=INVALID_SOCKET||b->setup_listener!=INVALID_SOCKET){result=papacc_c3_bridge_close_peer(b);if(result!=0)return result;}
  for(role=1U;role<=2U;++role){
   PAPACC_CHANNEL *ch=papacc_channel_manager_find(&o->loop->channel_manager,r->tokens.channels[role-1U]);
   if(ch==NULL)continue;
   result=o->secure->c2_finish_role_fn(o->secure,ch->connection_instance_id,&closed);
   if(result!=0)return result;if(!closed)all_closed=PAPACC_FALSE;
  }
  if(!all_closed)return PAPACC_RESULT_OK;
  /* No independent owner lease may be inferred from child destruction. */
  if(r->callbacks==0U&&r->tokens.borrowers==0U&&b->connection==NULL&&!b->registered&&!b->adapter.registered&&
   b->processor.connection==NULL&&b->peer_source==NULL&&b->peer==INVALID_SOCKET){
   PAPACC_U8 final[76];PAPACC_U64 control=owner_channel_connection(o,r,0U);
   r->cleanup_confirmed=PAPACC_TRUE;r->ownership=1U;
   if(!r->final_queued&&!r->final_written&&control){
    result=papacc_c2_operation_final_payload(o->manager,r,final);
    if(result==0)result=papacc_server_c2_owner_win32_queue(o,r,r->generation,control,27U,final,sizeof(final));
    return result;
   }
  }
 }
 return PAPACC_RESULT_OK;
}

static PAPACC_RESULT owner_terminate(PAPACC_SERVER_C2_OWNER_WIN32 *o,
 PAPACC_C2_OPERATION *r,PAPACC_C3_BRIDGE *b,unsigned index)
{
 unsigned i,role;PAPACC_RESULT result;PAPACC_BOOL closed=PAPACC_FALSE,all_closed=PAPACC_TRUE;
 for(i=0;i<6U;++i){PAPACC_C2_OWNER_WRITE *w=&o->writes[i];
  if(w->record!=r||w->type==27U)continue;
  if(w->pending){if(w->transport_attempted){w->pending=PAPACC_FALSE;w->quarantined=PAPACC_TRUE;}else retire_write(o,w);}
 }
 if(b!=NULL&&!b->child_acquired&&b->processor.connection==NULL&&
  !b->bound&&b->peer==INVALID_SOCKET&&b->setup_connector==INVALID_SOCKET&&
  b->setup_listener==INVALID_SOCKET&&b->peer_source==NULL){
  o->bridges[index]=NULL;b=NULL; /* No PST child was acquired; no DESTROYED fact. */
 }
 if(b!=NULL&&!b->child_destroyed&&!o->child_release_attempted[index]){
  result=papacc_c3_bridge_revoke(b);if(result!=0)return result;
  o->child_release_attempted[index]=PAPACC_TRUE;result=papacc_c3_bridge_release_child(b);e10_boundary(o,r,0U,PAPACC_C2_E10_RELEASE_RETURN,0U,result,NULL,0U);
  if(b->release_info.disposition==PST_RELEASE_DISPOSITION_CLOSE_UNRESOLVED_RETAINED||
   b->release_info.disposition==PST_RELEASE_DISPOSITION_PRECONDITION_RETAINED){
   r->ownership=b->release_info.disposition==PST_RELEASE_DISPOSITION_CLOSE_UNRESOLVED_RETAINED?3U:2U;
   r->state=PAPACC_C2_OP_RETAINED;(void)papacc_c2_tokens_revoke(&r->tokens,o->manager->owner,PAPACC_TRUE);
   return PAPACC_RESULT_OK;
  }
  if(result!=0)return result;
 }
 if(b!=NULL){if(!b->child_destroyed)return PAPACC_RESULT_OK;
  r->child_destroyed=PAPACC_TRUE;
  if(b->peer!=INVALID_SOCKET||b->peer_source!=NULL||b->setup_connector!=INVALID_SOCKET||b->setup_listener!=INVALID_SOCKET){result=papacc_c3_bridge_close_peer(b);if(result!=0)return result;}
  SecureZeroMemory(o->plaintext_pending[index],sizeof(o->plaintext_pending[index]));o->plaintext_pending_size[index]=0U;
 }
 for(role=1U;role<=2U;++role){PAPACC_CHANNEL *ch=papacc_channel_manager_find(&o->loop->channel_manager,r->tokens.channels[role-1U]);
  if(ch==NULL)continue;result=o->secure->c2_finish_role_fn(o->secure,ch->connection_instance_id,&closed);
  if(result!=0)return result;if(!closed)all_closed=PAPACC_FALSE;
 }
 if(!all_closed)return PAPACC_RESULT_OK;
 /* Only factual lower destruction plus Slot absence releases quarantined input. */
 for(i=0;i<6U;++i){PAPACC_C2_OWNER_WRITE *w=&o->writes[i];
  if(w->record!=r||!w->quarantined)continue;
  if(papacc_connection_manager_find(o->loop->connection_manager,w->connection)!=NULL||
   papacc_server_io_loop_win32_find_connection_slot(o->loop,w->connection)!=NULL)return PAPACC_RESULT_OK;
  retire_write(o,w);
 }
 if(r->callbacks==0U&&r->tokens.borrowers==0U){
  PAPACC_U8 final[76];PAPACC_U64 control=owner_channel_connection(o,r,0U);
  r->cleanup_confirmed=PAPACC_TRUE;r->ownership=1U;
  if(control==0U&&o->control_connections[index]!=0U&&
   papacc_connection_manager_find(o->loop->connection_manager,o->control_connections[index])==NULL&&
   papacc_server_io_loop_win32_find_connection_slot(o->loop,o->control_connections[index])==NULL){
   PAPACC_SIZE ci;PAPACC_BOOL control_closed=PAPACC_TRUE;
   for(ci=0;ci<o->secure->candidate_capacity;++ci){PAPACC_SERVER_SECURE_CANDIDATE_WIN32 *c=&o->secure->candidates[ci];
    if(c->connection_instance_id==o->control_connections[index]&&
     (c->state!=PAPACC_SERVER_SECURE_CANDIDATE_CLOSED||c->secure_processor.connection!=NULL))control_closed=PAPACC_FALSE;
   }
   if(control_closed){r->summary_unavailable=PAPACC_TRUE;r->state=PAPACC_C2_OP_RELEASED;}
  }
  if(!r->final_queued&&!r->final_written&&control){
   result=papacc_c2_operation_final_payload(o->manager,r,final);
   if(result==0)result=papacc_server_c2_owner_win32_queue(o,r,r->generation,control,27U,final,sizeof(final));
   return result;
  }
 }
 return PAPACC_RESULT_OK;
}
PAPACC_RESULT papacc_server_c2_owner_win32_progress(PAPACC_SERVER_C2_OWNER_WIN32 *o)
{
 unsigned index,credits;PAPACC_C2_OPERATION *r;PAPACC_C3_BRIDGE *b;
 PAPACC_RESULT result;PAPACC_SIZE n,skip,transferred=0U;PAPACC_U64 before;
 PAPACC_PST_SECURE_STEP step;PAPACC_U8 payload[287],plaintext[16356];
 if(!valid(o)||o->secure->dispatch_active)return PAPACC_RESULT_INVALID_STATE;
 if(o->wake_progress_done)return PAPACC_RESULT_OK;o->wake_progress_done=PAPACC_TRUE;
 e10_boundary(o,NULL,0U,PAPACC_C2_E10_OWNER_SNAPSHOT,0U,0,NULL,0U);
 index=o->next_bridge++%2U;r=&o->manager->operations[index];b=o->bridges[index];
 {char enabled[8];if(GetEnvironmentVariableA("PAPACC_C7_METRICS",enabled,sizeof(enabled))==1U&&enabled[0]=='1')
  fprintf(stderr,"E3_SERVICE_SELECT slot=%u session=%llu operation=%llu generation=%llu state=%u credits=%u\n",index,(unsigned long long)(r->session?r->session->incarnation:0U),(unsigned long long)r->id,(unsigned long long)r->generation,(unsigned)r->state,o->wake_credits);}
 if(r->state==PAPACC_C2_OP_RETAINED&&!r->final_queued&&!r->final_written){
  PAPACC_U64 control=owner_channel_connection(o,r,0U);PAPACC_U8 final[76];
  if(control&&r->callbacks==0U&&papacc_c2_operation_final_payload(o->manager,r,final)==0)
   return papacc_server_c2_owner_win32_queue(o,r,r->generation,control,27U,final,sizeof(final));
  return PAPACC_RESULT_OK;
 }
 if(r->revoked&&r->state!=PAPACC_C2_OP_RETAINED&&r->state!=PAPACC_C2_OP_RELEASED)
  return owner_terminate(o,r,b,index);
 if(r->state==PAPACC_C2_OP_EMPTY||!r->site_ready||r->revoked||
  !papacc_c2_operation_authorized(o->manager,r))return PAPACC_RESULT_OK;
 if(b==NULL){result=owner_activate(o,r,index);if(result!=0)return result;b=o->bridges[index];}
 if(b==NULL)return PAPACC_RESULT_OK;
 /* Activation can factually revoke a partially constructed child. Re-enter
  * its governed terminal path before any live-child checks or I/O. */
 if(r->revoked)return owner_terminate(o,r,b,index);
 if(b->retained||b->revoked||b->operation!=r->id||b->generation!=r->generation)
  return PAPACC_RESULT_INVALID_STATE;
 /* Reserve only calls possible in this state. Charging five unconditionally
  * starves RECORD ingress behind blocked APPLICATION output. Peer send/recv
  * need two; handshake/read/write and reciprocal shutdown are state bounded. */
 credits=2U;
 if(r->record_events[0]&&!b->ba_input_ended&&!b->child_destroyed)++credits;
 if(r->state==PAPACC_C2_OP_HANDSHAKE&&!b->tls_verified)++credits;
 if(r->tls_ready_written&&b->processor.state==PAPACC_PST_SECURE_PROCESSOR_ESTABLISHED){
  if(r->flow[0].size)++credits;
  if(!r->flow[1].paused&&!r->flow[1].sealed&&r->flow[1].size<=49152U)++credits;
  /* A read can observe peer close and initiate shutdown in this same slice. */
  if(r->flow[0].ack_written&&r->flow[1].size==0U)++credits;
 }else if(b->processor.state==PAPACC_PST_SECURE_PROCESSOR_SHUTTING_DOWN||
  (b->processor.state==PAPACC_PST_SECURE_PROCESSOR_PEER_CLOSED&&
   r->flow[0].ack_written&&r->flow[1].size==0U))++credits;
 if(o->wake_credits<credits)return PAPACC_RESULT_OK;o->wake_credits-=credits;
 /* Keep operation storage until the ACTUAL C3 send boundary accepts it. */
 if(b->ba.received<r->flow[2].accepted||b->ba.received>r->flow[2].admitted)
  return PAPACC_RESULT_INTERNAL_ERROR;
 skip=(PAPACC_SIZE)(b->ba.received-r->flow[2].accepted);
 n=r->flow[2].size-skip;if(n>16384U)n=16384U;
 if(n&&!b->ba_frozen){result=papacc_c3_bridge_accept_ba(b,r->id,r->generation,
   b->ba.received,r->flow[2].bytes+skip,n);if(result!=0)return result;}
 b->c7_hold_ba=c7_stall(o,r,2U)?PAPACC_TRUE:PAPACC_FALSE;
 before=b->ba.accepted;result=b->ab_sealed?PAPACC_RESULT_OK:papacc_c3_bridge_step(b);if(result!=0)goto failed;
 n=(PAPACC_SIZE)(b->ba.accepted-before);
 if(n){result=papacc_c2_operation_downstream(o->manager,r,2U,n);if(result!=0)return result;}
 if(r->record_events[0]&&!b->ba_input_ended&&!b->child_destroyed&&r->flow[2].size==0U&&r->flow[2].accepted==r->flow[2].admitted&&b->ba.size==0U&&b->ba.accepted==b->ba.received){
  result=papacc_c3_bridge_end_ba_input(b,r->id,r->generation);if(result!=0)goto failed;
 }
 if(!b->child_destroyed&&r->state==PAPACC_C2_OP_HANDSHAKE&&!b->tls_verified){
  result=papacc_pst_secure_processor_handshake_once(&b->processor,&step);
  if(result!=0||step==PAPACC_PST_SECURE_STEP_FAILED||step==PAPACC_PST_SECURE_STEP_CLOSED){
   /* Preserve the actual public handshake source error before teardown. */
   b->source_result=b->processor.source_result;if(b->first_failure==PST_RESULT_OK)b->first_failure=b->source_result;
   goto failed;
  }
  if(step==PAPACC_PST_SECURE_STEP_COMPLETE){result=papacc_c3_bridge_publish(b);if(result!=0)goto failed;}
 }
 if(b->tls_verified&&!r->tls_ready_written){
  PAPACC_U64 connection=owner_channel_connection(o,r,0U);
  if(connection&&!papacc_server_c2_owner_win32_wants_write(o,connection)){
   memset(payload,0,32U);memcpy(payload,r->tokens.identity,24U);
   payload[24]=3U;payload[25]=4U;payload[27]=7U;
   payload[28]=(PAPACC_U8)(b->selected_alpn_size>>8);payload[29]=(PAPACC_U8)b->selected_alpn_size;
   memcpy(payload+32,b->selected_alpn,b->selected_alpn_size);
   result=papacc_server_c2_owner_win32_queue(o,r,r->generation,connection,21U,
    payload,32U+b->selected_alpn_size);if(result!=0)return result;
  }
 }
 if(r->tls_ready_written&&b->processor.state==PAPACC_PST_SECURE_PROCESSOR_ESTABLISHED){
  if(r->flow[0].size&&!c7_stall(o,r,0U)){
   /* SSL WANT retries require identical, persistent input pointer AND length. */
   if(o->plaintext_pending_size[index]==0U){n=r->flow[0].size;if(n>16356U)n=16356U;
    memcpy(o->plaintext_pending[index],r->flow[0].bytes,n);o->plaintext_pending_size[index]=n;}
   result=papacc_pst_secure_processor_write_once(&b->processor,
    o->plaintext_pending[index],o->plaintext_pending_size[index],&transferred,&step);
   if(result!=0||step==PAPACC_PST_SECURE_STEP_FAILED||step==PAPACC_PST_SECURE_STEP_CLOSED)goto failed;
   if(transferred){if(transferred>o->plaintext_pending_size[index])return PAPACC_RESULT_INTERNAL_ERROR;
    result=papacc_c2_operation_downstream(o->manager,r,0U,transferred);if(result!=0)return result;
    o->plaintext_pending_size[index]=0U;SecureZeroMemory(o->plaintext_pending[index],16356U);}
  }
  {char enabled[8];if(GetEnvironmentVariableA("PAPACC_C7_METRICS",enabled,sizeof(enabled))==1U&&enabled[0]=='1')fprintf(stderr,"E3_TLS_READ_POLICY session=%llu operation=%llu generation=%llu occupancy=%llu paused=%d allowed=%d\n",(unsigned long long)r->session->incarnation,(unsigned long long)r->id,(unsigned long long)r->generation,(unsigned long long)r->flow[1].size,r->flow[1].paused,!r->flow[1].paused&&!r->flow[1].sealed&&r->flow[1].size<=49152U);}
  if(!r->flow[1].paused&&!r->flow[1].sealed&&r->flow[1].size<=49152U){
   result=papacc_pst_secure_processor_read_once(&b->processor,plaintext,sizeof(plaintext),&transferred,&step);
   if(result!=0||step==PAPACC_PST_SECURE_STEP_FAILED)goto failed;
   if(transferred){result=papacc_c2_operation_output(o->manager,r,1U,plaintext,transferred);if(result!=0)return result;}
  }
 }
 /* AB producer bytes stay in C3 until a full corresponding DATA write. */
 if(r->flow[3].admitted<b->ab.accepted||r->flow[3].admitted>b->ab.received)
  return PAPACC_RESULT_INTERNAL_ERROR;
 skip=(PAPACC_SIZE)(r->flow[3].admitted-b->ab.accepted);
 n=b->ab.size-skip;if(n>16356U)n=16356U;
 if(n&&!r->flow[3].paused){result=papacc_c2_operation_output(o->manager,r,3U,b->ab.bytes+skip,n);if(result!=0)return result;}
 /* Rotate outgoing role priority per operation. Both bounded opportunities
  * retain their independent channel/offset and publication checks. */
 {
  unsigned first=(o->next_output_role[index]++&1U)?1U:3U;
  unsigned second=first==1U?3U:1U;char enabled[8];
  if(GetEnvironmentVariableA("PAPACC_C2_FAIRNESS_TRACE",enabled,sizeof(enabled))==1U&&enabled[0]=='1')
   fprintf(stderr,"C5_OWNER_ROLE_ORDER operation=%llu generation=%llu slot=%u first=%u second=%u credits_remaining=%u\n",(unsigned long long)r->id,(unsigned long long)r->generation,index,first,second,o->wake_credits);
  if(first==3U||r->tls_ready_written){result=owner_queue_data(o,r,first);if(result!=0)return result;}
  if(second==3U||r->tls_ready_written){result=owner_queue_data(o,r,second);if(result!=0)return result;}
 }
 return owner_close_pipeline(o,r,b,index);
failed:
 /* Direct public plaintext read/write failures are recorded by the processor.
  * Preserve that first source result before release overwrites source_result.
  * A private bridge failure already captured above must not be rewritten. */
 if(b->first_failure==PST_RESULT_OK&&b->processor.source_result!=PST_RESULT_OK){
  b->first_failure=b->processor.source_result;b->source_result=b->processor.source_result;
 }
 r->tls_fact=b->first_failure==PST_RESULT_TRUNCATED?3U:4U;
 (void)papacc_c2_operation_revoke(o->manager,r,b->first_failure==PST_RESULT_TRUNCATED?9U:10U);
 /* The failure is now owned by this operation. Keep driving its governed
  * cleanup; a failed TLS operation is never turned into clean completion. */
 return PAPACC_RESULT_OK;
}

PAPACC_BOOL papacc_server_c2_owner_win32_read_allowed(const PAPACC_SERVER_C2_OWNER_WIN32 *o,PAPACC_U64 connection)
{
 PAPACC_CHANNEL *ch;unsigned i,role;
 if(o==NULL||!o->initialized)return PAPACC_TRUE;
 ch=papacc_channel_manager_find_by_connection(&o->loop->channel_manager,connection);
 if(ch==NULL||ch->role!=PAPACC_CHANNEL_ROLE_DATA)return PAPACC_TRUE;
 for(i=0;i<2U;++i){const PAPACC_C2_OPERATION *r=&o->manager->operations[i];
  if(r->state==PAPACC_C2_OP_EMPTY||r->session->incarnation!=ch->session_instance_id)continue;
  for(role=0;role<2U;++role)if(r->tokens.channels[role]==ch->channel_instance_id)
   return r->revoked||r->state==PAPACC_C2_OP_RETAINED||r->flow[role*2U].paused?PAPACC_FALSE:PAPACC_TRUE;
 }
 return PAPACC_TRUE;
}

PAPACC_BOOL papacc_server_c2_owner_win32_take_opportunity(PAPACC_SERVER_C2_OWNER_WIN32 *o)
{if(o==NULL)return PAPACC_TRUE;if(!valid(o)||o->wake_credits==0U)return PAPACC_FALSE;--o->wake_credits;return PAPACC_TRUE;}
PAPACC_RESULT papacc_server_c2_owner_win32_begin_wake(PAPACC_SERVER_C2_OWNER_WIN32 *o)
{
 unsigned i;PAPACC_RESULT result;
 if(!valid(o)||o->secure->dispatch_active)return PAPACC_RESULT_INVALID_STATE;
 #ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
 {PAPACC_RESULT retirement=papacc_server_c2_owner_win32_retire_sessions(o);if(retirement!=PAPACC_RESULT_OK)return retirement;}
#endif
 o->wake_credits=8U;o->wake_progress_done=PAPACC_FALSE;
 for(i=0;i<6U;++i)if(o->writes[i].pending){PAPACC_CHANNEL *c=channel_for(o,o->writes[i].connection);
  if(c!=NULL&&c->role==PAPACC_CHANNEL_ROLE_CONTROL){result=papacc_server_c2_owner_win32_step(o,o->writes[i].connection);if(result!=0)return result;}
 }
 /* CONTROL precedes a reserved C3 slice, so blocked DATA cannot starve the
  * plaintext producer/consumer. The later progress hook is idempotent per wake. */
 return papacc_server_c2_owner_win32_progress(o);
}
