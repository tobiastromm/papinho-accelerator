}
PAPACC_RESULT papacc_server_c2_owner_win32_session_lost(PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_U64 sid,PAPACC_U16 fact){unsigned i;if(!valid(o))return PAPACC_RESULT_INVALID_STATE;
