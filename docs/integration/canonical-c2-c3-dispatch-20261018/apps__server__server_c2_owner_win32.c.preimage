static PAPACC_RESULT owner_reap_completed(PAPACC_SERVER_C2_OWNER_WIN32 *o)
{
 unsigned i;PAPACC_RESULT result;PAPACC_C2_PUBLICATION_EVENT retired;
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
 if(!valid(o)||o->secure->dispatch_active||o->configuration.state==PAPACC_C2_CONFIG_RETAINED||
    o->secure->stop_state==PAPACC_SERVER_SECURE_STOP_ERROR_TERMINAL)return PAPACC_RESULT_INVALID_STATE;
#endif
 for(i=0;i<2U;++i){PAPACC_C2_OPERATION *r=&o->manager->operations[i];PAPACC_C3_BRIDGE *b=o->bridges[i];
  if(r->state!=PAPACC_C2_OP_RELEASED||!r->cleanup_confirmed||r->callbacks||r->tokens.borrowers)continue;
#ifdef PAPACC_C8_PRIVATE_STORAGE_PROFILE
  /* Validate every release_slot condition before resetting any bridge. A
   * finished summary, retained ownership and outstanding writers are distinct. */
  {unsigned j;int borrowed=0;
   if(r->ownership!=1U||!r->revoked||(!r->final_written&&!r->summary_unavailable))continue;
   for(j=0U;j<6U;++j)if(o->writes[j].record==r)borrowed=1;
   if(borrowed)continue;
   if(b!=NULL&&(b->retained||!b->child_acquired||!b->child_destroyed||
      b->release_info.disposition!=PST_RELEASE_DISPOSITION_DESTROYED||
      b->owner_thread!=GetCurrentThreadId()||!b->initialized||
      b->processor.connection||b->connection||b->registered||b->adapter.registered||
      b->peer_registered||b->peer_source||b->peer!=INVALID_SOCKET||
      b->setup_connector!=INVALID_SOCKET||b->setup_listener!=INVALID_SOCKET))continue;
  }
#endif
  memset(&retired,0,sizeof(retired));retired.operation=r->id;retired.generation=r->generation;e10_snapshot(o,&retired);
  e10_boundary(o,r,0U,PAPACC_C2_E10_HISTORY_RETIRING,0U,0,NULL,0U);
  if(b!=NULL){result=papacc_c3_bridge_reset_destroyed(b);if(result!=0)return result;}
  result=papacc_c2_operation_release_slot(o->manager,r);if(result!=0)return result;
  if(retired.e10_snapshot_valid){retired.kind=PAPACC_C2_E10_HISTORY_RETIRED;e10_store(o,&retired);o->e10.retired_operation[i]=retired.operation;o->e10.retired_generation[i]=retired.generation;}
  o->bridges[i]=NULL;o->child_release_attempted[i]=PAPACC_FALSE;
  o->child_ready_pending[i]=o->peer_ready_pending[i]=PAPACC_FALSE;o->control_connections[i]=0;
 }
 return PAPACC_RESULT_OK;
}
PAPACC_RESULT papacc_server_c2_owner_win32_control(void*context,PAPACC_U64 sid,PAPACC_U16 type,const PAPACC_U8*p,PAPACC_SIZE n,PAPACC_BOOL header){PAPACC_SERVER_C2_OWNER_WIN32*o=(PAPACC_SERVER_C2_OWNER_WIN32*)context;PAPACC_C2_SESSION*s=NULL;PAPACC_C2_OPERATION*r=NULL;PAPACC_CHANNEL*channel;PAPACC_U8 response[108];PAPACC_RESULT result;unsigned i;
 if(!valid(o))return PAPACC_RESULT_INVALID_STATE;for(i=0;i<4U;++i)if(o->sessions[i].initialized&&o->sessions[i].incarnation==sid)s=&o->sessions[i];
 channel=papacc_channel_manager_find_control(&o->loop->channel_manager,sid);
 if(s==NULL||channel==NULL||channel->state!=PAPACC_CHANNEL_STATE_BOUND||!papacc_c2_session_authorized(s,o->manager->owner,s->incarnation,s->principal,s->policy_epoch))return PAPACC_RESULT_PROTOCOL_ERROR;
