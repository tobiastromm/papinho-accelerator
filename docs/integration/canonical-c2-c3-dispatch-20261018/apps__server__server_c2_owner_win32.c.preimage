#endif
}

PAPACC_BOOL papacc_server_c2_owner_win32_wants_write(const PAPACC_SERVER_C2_OWNER_WIN32*o,PAPACC_U64 connection){unsigned i;if(o==NULL||!o->initialized)return PAPACC_FALSE;for(i=0;i<6U;++i)if(o->writes[i].pending&&o->writes[i].connection==connection)return PAPACC_TRUE;return PAPACC_FALSE;}
