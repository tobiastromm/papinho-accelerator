+}
+static int a1_finish(const A1_OWNER *o)
+{return !(o->state&(A1_FROZEN|A1_BUSY|A1_RETAINED))&&a1_state(o,0)==A1_FREE&&a1_state(o,1)==A1_FREE;}
+#endif
