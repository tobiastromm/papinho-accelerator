+PAPACC_RESULT papacc_c2_tokens_generate(PAPACC_C2_TOKENS*,const PAPACC_C2_SESSION*,PAPACC_U32,const PAPACC_U8*,const PAPACC_C2_TOKENS*,PAPACC_SIZE);
