+void ep_limiter_stop(EP_LIMITER *l){if(l)l->stopped=1;}
+EP_RESULT ep_enrollment_quote(PAPACC_SIZE other,PAPACC_SIZE local,PAPACC_SIZE provider,PAPACC_SIZE *out){
