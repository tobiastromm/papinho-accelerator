+ unsigned k,s;PAPACC_SIZE n;const PAPACC_U8 *p;
+ if(!t||!f||!span(f->payload.data,f->payload.size)||d>1U||cross(t,sizeof(*t),f,sizeof(*f))||cross(t,sizeof(*t),f->payload.data,f->payload.size))return EP_INVALID;
