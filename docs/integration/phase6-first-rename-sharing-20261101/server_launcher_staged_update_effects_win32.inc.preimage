 if(status>0||s->resources.volume_io.Status==(NTSTATUS)0x103L)return staged_update_retain(ERROR_IO_PENDING);
 if(status||s->resources.volume_io.Status||s->resources.volume_io.Information!=sizeof(s->resources.volume))return staged_update_fail(ERROR_INVALID_DATA);
 if(s->resources.volume.total.QuadPart<=0||s->resources.volume.actual_available.QuadPart<0||s->resources.volume.caller_available.QuadPart<0||
 s->resources.volume.actual_available.QuadPart>s->resources.volume.total.QuadPart||s->resources.volume.caller_available.QuadPart>s->resources.volume.actual_available.QuadPart||
 !s->resources.volume.sectors_per_unit||!s->resources.volume.bytes_per_sector)return staged_update_fail(ERROR_INVALID_DATA);
 unit=(ULONGLONG)s->resources.volume.sectors_per_unit*s->resources.volume.bytes_per_sector;
 if(!unit||remaining>((ULONGLONG)-1)-(unit-1U)||u->new_bytes>((ULONGLONG)-1)-(unit-1U))return staged_update_fail(ERROR_ARITHMETIC_OVERFLOW);
 if(u->unit&&unit!=u->unit)return staged_update_fail(ERROR_REVISION_MISMATCH);u->unit=unit;
 u->rounded=((u->new_bytes+unit-1U)/unit)*unit;rounded=((remaining+unit-1U)/unit)*unit;
 if((ULONGLONG)s->resources.volume.actual_available.QuadPart>((ULONGLONG)-1)/unit)return staged_update_fail(ERROR_ARITHMETIC_OVERFLOW);
