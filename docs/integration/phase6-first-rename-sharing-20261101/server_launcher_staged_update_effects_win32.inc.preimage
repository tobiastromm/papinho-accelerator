 if(!GetFileInformationByHandle(s->objects[14].handle,&f))return staged_update_fail(GetLastError());
 previous=s->objects[14].identity;
 if(f.dwVolumeSerialNumber!=previous.dwVolumeSerialNumber||f.nFileIndexHigh!=previous.nFileIndexHigh||f.nFileIndexLow!=previous.nFileIndexLow||
 f.dwFileAttributes!=previous.dwFileAttributes||(((ULONGLONG)f.nFileSizeHigh<<32)|f.nFileSizeLow)!=u->written)return staged_update_fail(ERROR_REVISION_MISMATCH);
 /* Only candidate size/last-write can advance during this owned copy. SD,
