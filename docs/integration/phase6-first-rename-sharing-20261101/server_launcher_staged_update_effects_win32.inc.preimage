typedef NTSTATUS (NTAPI *UPDATE_NT_VOLUME)(HANDLE,PIO_STATUS_BLOCK,PVOID,ULONG,ULONG);
typedef char UPDATE_RENAME_LAYOUT[(FIELD_OFFSET(PAPACC_UPDATE_RENAME_INFO,name)==FIELD_OFFSET(FILE_RENAME_INFO,FileName))?1:-1];
