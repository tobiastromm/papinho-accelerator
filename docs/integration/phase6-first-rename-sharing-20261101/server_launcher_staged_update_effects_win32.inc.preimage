 if(u->written!=u->new_bytes||(u->preparation_mode?utility_prep_barrier(0):staged_update_barrier(0)))return staged_update_fail(ERROR_INVALID_DATA);
 u->location=602U;
 u->effects++;if(!FlushFileBuffers(s->objects[14].handle))return staged_update_fail(GetLastError());
 if(staged_update_candidate_current()||!scm_register_hash(s->objects[14].handle,hash)||memcmp(hash,u->new_hash,32)||
  (u->preparation_mode?utility_prep_current():staged_update_files()))return staged_update_fail(ERROR_CRC);
 return 0;
}
static DWORD staged_update_apply(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();
 if(!staged_update_owned()||u->preparation_mode||!u->execute_mode||u->act_state!=2U||!u->confirmed||u->consumed||u->first)return ERROR_ACCESS_DENIED;
 if(staged_update_current()||staged_update_files()||staged_update_resources(u->new_bytes))return u->first;
 if(InterlockedCompareExchange((volatile LONG *)&u->consumed,1,0)!=0)return ERROR_ACCESS_DENIED;u->act_state=3U;
 if(staged_update_create()||staged_binary_copy_and_flush())return u->first;
 if(staged_update_rename(1U,13U,u->previous)||staged_update_readback(11U,u->previous,13U,u->old_hash))return u->first;
 if(staged_update_rename(2U,14U,L"papacc_server.exe")||staged_update_readback(15U,L"papacc_server.exe",14U,u->new_hash))return u->first;
 if(staged_update_current()||staged_update_files())return u->first;return 0;
}
static int staged_update_hex(const char *s,BYTE out[32])
{unsigned i;if(!s||strlen(s)!=64U)return 0;for(i=0;i<32U;i++){unsigned a,b;char x=s[2U*i],y=s[2U*i+1U];if(!((x>='0'&&x<='9')||(x>='a'&&x<='f'))||!((y>='0'&&y<='9')||(y>='a'&&y<='f')))return 0;a=x<='9'?(unsigned)(x-'0'):(unsigned)(x-'a'+10);b=y<='9'?(unsigned)(y-'0'):(unsigned)(y-'a'+10);out[i]=(BYTE)((a<<4)|b);}return 1;}
static int staged_update_decimal(const char *s,DWORD *out)
{ULONGLONG n=0;size_t i;if(!s||!s[0]||(s[0]=='0'&&s[1]))return 0;for(i=0;s[i];i++){if(s[i]<'0'||s[i]>'9'||n>(MAXDWORD-(unsigned)(s[i]-'0'))/10U)return 0;n=n*10U+(unsigned)(s[i]-'0');}*out=(DWORD)n;return 1;}
int papacc_server_launcher_binary_update_cli(int argc,const char *const *argv,FILE *out,FILE *err)
{
 WCHAR source[MAX_PATH];DWORD id[9];BYTE pins[5][32];unsigned i;(void)err;
 if(argc<2||!argv||!argv[1]||strcmp(argv[1],"--owner-manual-binary-update"))return -1;
 if(argc!=17)return 2; /* old consumed handoff cannot admit an executor */
 for(i=0;i<6U;i++)if(!staged_update_decimal(argv[3U+i],&id[i]))return 2;
 for(i=0;i<4U;i++)if(!staged_update_hex(argv[9U+i],pins[i]))return 2;
 for(i=0;i<3U;i++)if(!staged_update_decimal(argv[13U+i],&id[6U+i]))return 2;
 if(!staged_update_hex(argv[16],pins[4]))return 2;
 if(!MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,argv[2],-1,source,MAX_PATH))return 2;
 return staged_update_entry(source,id,id+3,pins[0],pins[1],(const BYTE (*)[32])&pins[2],id+6,pins[4],out,1);
}
