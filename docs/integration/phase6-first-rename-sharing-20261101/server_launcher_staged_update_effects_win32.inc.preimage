 if(!staged_update_plan(digest)||memcmp(digest,u->plan_hash,32))return staged_update_fail(ERROR_REVISION_MISMATCH);
 if(papacc_configuration_personal_layout_binary_current(&root.configuration_commit)!=PAPACC_RESULT_OK||
