 ZeroMemory(&h,sizeof(h));if(!s->protection||pacc_storage_sha_init(&h)!=PACC_HASH_OK)return 0;
#define UPDATE_HASH(p,z) do{if(pacc_storage_sha_update(&h,(const BYTE *)(p),(z),NULL,NULL)!=PACC_HASH_OK)goto done;}while(0)
 if(u->preparation_mode){UPDATE_HASH(prep_policy,sizeof(prep_policy));}else {UPDATE_HASH(policy,sizeof(policy));}
 UPDATE_HASH(&u->preparation_mode,sizeof(u->preparation_mode));UPDATE_HASH(&u->prep_chain_count,sizeof(u->prep_chain_count));UPDATE_HASH(u->prep_slots,sizeof(u->prep_slots));
 UPDATE_HASH(u->attempt,sizeof(u->attempt));
 UPDATE_HASH(&root.reserved_bytes,sizeof(root.reserved_bytes));UPDATE_HASH(&u->unit,sizeof(u->unit));UPDATE_HASH(&u->rounded,sizeof(u->rounded));
 UPDATE_HASH(u->old_hash,32);UPDATE_HASH(u->new_hash,32);UPDATE_HASH(u->dll_hash,64);
 UPDATE_HASH(u->executor_id,sizeof(u->executor_id));UPDATE_HASH(u->executor_hash,32);
 UPDATE_HASH(&u->executor_pid,sizeof(u->executor_pid));UPDATE_HASH(&u->executor_creation,sizeof(u->executor_creation));
 UPDATE_HASH(u->executor_path,(wcslen(u->executor_path)+1U)*sizeof(WCHAR));
 UPDATE_HASH(u->expected_old_id,sizeof(u->expected_old_id));UPDATE_HASH(&u->old_bytes,sizeof(u->old_bytes));UPDATE_HASH(&u->new_bytes,sizeof(u->new_bytes));
 UPDATE_HASH(u->expected_parent_id,sizeof(u->expected_parent_id));
 UPDATE_HASH(u->candidate,(wcslen(u->candidate)+1U)*sizeof(WCHAR));UPDATE_HASH(u->previous,(wcslen(u->previous)+1U)*sizeof(WCHAR));
 UPDATE_HASH(u->source_path,(wcslen(u->source_path)+1U)*sizeof(WCHAR));UPDATE_HASH(n->install_paths.binary,(wcslen(n->install_paths.binary)+1U)*sizeof(WCHAR));
 UPDATE_HASH(&u->invocation,sizeof(u->invocation));UPDATE_HASH(&u->thread,sizeof(u->thread));UPDATE_HASH(&n->token,sizeof(n->token));UPDATE_HASH(n->sid,n->sid_bytes);
 for(i=0;i<14U;i++)if(i<s->ancestor_count||i==7U||i==8U||i==9U||i==10U||i==13U||utility_prep_chain_slot(i)){
  /* Local same-invocation reference identity, never serialized or transported. */
