/* U1-U7 accepted9fb5318d...: one native attributed UPDATE, same owner/packet.
 * No writer API accepts a boolean grant. Native confirmation constructs the
 * live act; pins, CLI, admin membership and samples alone cannot do so. */
#define UPDATE_KNOWN_AUTOMATIC_BYTES (SCM_RESOURCE_KNOWN_AUTOMATIC_BYTES+sizeof(PACC_STORAGE_SHA256)+1024U+96U+\
 4U*MAX_PATH+4U*65U+6U*11U+65U*sizeof(WCHAR)+(MAX_PATH+32U)*sizeof(WCHAR)+\
 2U*sizeof(BY_HANDLE_FILE_INFORMATION)+sizeof(PAPACC_UPDATE_RENAME_INFO)+\
 128U+64U*sizeof(void *)+64U*sizeof(DWORD)+16U*sizeof(ULONGLONG))
