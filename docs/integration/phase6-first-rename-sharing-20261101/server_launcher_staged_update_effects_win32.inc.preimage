 HMODULE module;FARPROC proc;NTSTATUS status;ULONGLONG unit,rounded;LARGE_INTEGER now,frequency;
 u->location=300U;
 /* Shared observation/arithmetic primitive: caller supplies its separately
  * censused known charge. U4 and utility-preparation policy stay distinct. */
 if(personal_resource_collect(&u->resources,10U+u->effects,0))return staged_update_fail(u->resources.first_error);
 if(!root.reserved_bytes||root.reserved_bytes>PAPACC_LAUNCHER_MANAGED_LIMIT||
 u->resources.last.physical_available<root.reserved_bytes||u->resources.last.commit_available<root.reserved_bytes)return staged_update_fail(ERROR_NOT_ENOUGH_MEMORY);
 module=GetModuleHandleW(L"ntdll.dll");proc=module?GetProcAddress(module,"NtQueryVolumeInformationFile"):NULL;
 if(!proc)return staged_update_fail(ERROR_NOT_SUPPORTED);memcpy(&fn,&proc,sizeof(fn));
 ZeroMemory(&s->resources.volume_io,sizeof(s->resources.volume_io));ZeroMemory(&s->resources.volume,sizeof(s->resources.volume));
