+PAPACC_RT_RESULT papacc_rt_exchange_received_data(PAPACC_RT_EXCHANGE *e,PAPACC_U64 now){
+ PAPACC_RT_RESULT r=check(e,now);if(r!=PAPACC_RT_DATA_OK)return r;
+ if(e->phase!=2){e->invalid=1;return PAPACC_RT_INVALID;}
