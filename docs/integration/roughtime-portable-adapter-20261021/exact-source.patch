+PAPACC_RT_RESULT papacc_rt_campaign_data(const PAPACC_RT_CRYPTO *,const PAPACC_RT_BYTES *,const PAPACC_RT_BYTES *,const PAPACC_U8 *,const PAPACC_U8 *,PAPACC_RT_REPLY *);
