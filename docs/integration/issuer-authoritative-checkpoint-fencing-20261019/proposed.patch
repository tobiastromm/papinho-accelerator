+  out->state=PAPACC_ISSUER_CHECKPOINT_DIVERGENT;return PAPACC_ISSUER_CONFLICT;
+ }
+ out->state=PAPACC_ISSUER_CHECKPOINT_DATA_VALID_RECOVERY_DENIED;
+ return PAPACC_ISSUER_DENIED;
+}
