+ source.interfaces=&interface_record;source.interface_count=1U;source.addresses=&address;source.address_count=1U;
+ if(papacc_interface_snapshot_copy_prepare(&copy,&source,11U,0U)!=PAPACC_RESULT_OK)return 1;
