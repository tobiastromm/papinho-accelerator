--- preimage/apps/server/server_service_admission_bd_win32.h
+++ current/apps/server/server_service_admission_bd_win32.h
@@ -0,0 +1,93 @@
+#ifndef PAPACC_SERVICE_ADMISSION_BD_WIN32_H
+#define PAPACC_SERVICE_ADMISSION_BD_WIN32_H
+/* Private bounded data/validators inside PS_ADMISSION, not another owner.
+ * MODEL evidence exists ONLY in the isolated test translation unit. */
+#include <windows.h>
+#include <string.h>
+#define PS_BD_ROLES 4U
+enum { PS_BD_NATIVE_ID=1U,PS_BD_IMAGE_PROVENANCE=2U,PS_BD_FACTUAL_RELATION=4U,PS_BD_SESSION=8U,
+ PS_BD_LIVE=16U,PS_BD_METRICS=32U,PS_BD_REVALIDATED=64U,PS_BD_GENERATION=128U };
+#define PS_BD_PROOF_ALL 255U
+#define PS_BD_MIB 1048576ULL
+enum { PS_BD_ADMIN=0,PS_BD_QUALIFIER=1,PS_BD_SERVICE=2,PS_BD_CONSOLE=3 };
+typedef struct PS_BD_ID {HANDLE handle;DWORD pid,session;ULONGLONG creation;} PS_BD_ID;
+typedef struct PS_BD_DESCRIPTOR {
+ PS_BD_ID actor;HANDLE control_thread,configuration,image;DWORD control_tid;
+ BYTE sid[SECURITY_MAX_SID_SIZE];DWORD sid_size;TOKEN_STATISTICS statistics;
+ BY_HANDLE_FILE_INFORMATION config_id,image_id;
+ char attempt[33],plan[65],config_hash[65],image_hash[65],policy[65],host[65];
+ DWORD owner_pid;ULONGLONG owner_creation,boot,challenge;
+} PS_BD_DESCRIPTOR;
+typedef struct PS_BD_PROOF {
+ PS_BD_ID actor,console;DWORD source,known;ULONGLONG boot,observed,generation;
+} PS_BD_PROOF;
+typedef struct PS_BD_INVENTORY {
+ PS_BD_ID role[PS_BD_ROLES];unsigned present[PS_BD_ROLES],count;PS_BD_PROOF console;
+} PS_BD_INVENTORY;
+typedef struct PS_BD_COST {
+ ULONGLONG private_bytes,commit,working_set,stack;DWORD handles,threads,error;
+} PS_BD_COST;
+typedef DWORD (*PS_BD_CONTEXT_CHECK)(const PS_BD_DESCRIPTOR *);
+typedef struct PS_BD_STATE {
+ PS_BD_DESCRIPTOR binding;PS_BD_INVENTORY inventory;
+ HANDLE thread,unexpected,input,output;PSID approved_sid;PS_BD_CONTEXT_CHECK check;unsigned used,bound;
+} PS_BD_STATE;
+static __inline int ps_bd_id(const PS_BD_ID *a,const PS_BD_ID *b)
+{return a->pid&&a->creation&&a->handle&&a->handle!=INVALID_HANDLE_VALUE&&b->handle&&b->handle!=INVALID_HANDLE_VALUE&&a->pid==b->pid&&a->creation==b->creation&&a->session==b->session;}
+static __inline int ps_bd_hex(const char s[65])
+{unsigned i;for(i=0;i<64;i++)if(!((s[i]>='0'&&s[i]<='9')||(s[i]>='a'&&s[i]<='f')))return 0;return !s[64];}
+static __inline DWORD ps_bd_descriptor(const PS_BD_DESCRIPTOR *d)
+{
+ if(!d||!ps_bd_id(&d->actor,&d->actor)||!d->control_thread||d->control_thread==INVALID_HANDLE_VALUE||!d->control_tid||
+ !d->configuration||d->configuration==INVALID_HANDLE_VALUE||!d->image||d->image==INVALID_HANDLE_VALUE||
+ !d->owner_pid||d->actor.pid==d->owner_pid||!d->owner_creation||!d->boot||!d->challenge||
+ d->attempt[32]||strcmp(d->attempt,"75330d11cc7e4123ae62eadc9a59c2f5")||!ps_bd_hex(d->plan)||!ps_bd_hex(d->config_hash)||!ps_bd_hex(d->image_hash)||!ps_bd_hex(d->policy)||!ps_bd_hex(d->host))return ERROR_INVALID_DATA;
+ if(d->sid_size<8||d->sid_size>sizeof(d->sid)||d->sid[0]!=SID_REVISION||d->sid[1]>SID_MAX_SUB_AUTHORITIES||d->sid_size!=8U+4U*d->sid[1])return ERROR_INVALID_SID;
+ return 0;
+}
+static __inline DWORD ps_bd_console(const PS_BD_DESCRIPTOR *d,const PS_BD_INVENTORY *v,ULONGLONG now)
+{
+ const PS_BD_PROOF *p=&v->console;
+ if(!v->present[PS_BD_CONSOLE]||p->known!=PS_BD_PROOF_ALL||!ps_bd_id(&d->actor,&p->actor)||
+ !ps_bd_id(&v->role[PS_BD_CONSOLE],&p->console)||p->boot!=d->boot||p->generation!=d->challenge||
+ p->console.session!=d->actor.session||now<p->observed||now-p->observed>60000U)return ERROR_ACCESS_DENIED;
+ /* No native source qualified yet. A mask/source supplied by a caller cannot
+  * assert factual association. Positive cases are synthetic tests ONLY. */
+#ifdef PAPACC_SERVICE_BD_MODEL
+ if(p->source==0x4d4f444cUL)return 0;
+#endif
+ return ERROR_NOT_SUPPORTED;
+}
+static __inline DWORD ps_bd_inventory(const PS_BD_DESCRIPTOR *d,const PS_BD_INVENTORY *v,ULONGLONG now)
+{
+ unsigned i,j,n=0;DWORD e=ps_bd_descriptor(d);if(e)return e;
+ if(!v||v->count>PS_BD_ROLES||!v->present[PS_BD_ADMIN]||!v->present[PS_BD_QUALIFIER])return ERROR_INVALID_DATA;
+ for(i=0;i<PS_BD_ROLES;i++){
+  if(v->present[i]>1U)return ERROR_INVALID_DATA;
+  if(!v->present[i]){if(v->role[i].pid||v->role[i].handle||v->role[i].creation)return ERROR_INVALID_DATA;continue;}
+  n++;if(!ps_bd_id(&v->role[i],&v->role[i])||v->role[i].session!=d->actor.session)return ERROR_INVALID_DATA;
+  for(j=0;j<i;j++)if(v->present[j]&&(v->role[i].pid==v->role[j].pid||v->role[i].handle==v->role[j].handle))return ERROR_INVALID_DATA;
+ }
+ if(n!=v->count||!ps_bd_id(&d->actor,&v->role[PS_BD_ADMIN])||v->role[PS_BD_QUALIFIER].pid!=d->owner_pid||v->role[PS_BD_QUALIFIER].creation!=d->owner_creation)return ERROR_INVALID_DATA;
+ return ps_bd_console(d,v,now);
+}
+static __inline DWORD ps_bd_census(const PS_BD_DESCRIPTOR *d,const PS_BD_INVENTORY *v,ULONGLONG now,DWORD pid,DWORD parent,unsigned project)
+{
+ unsigned i;int child=0;DWORD e=ps_bd_inventory(d,v,now);if(e)return e;
+ for(i=0;i<PS_BD_ROLES;i++)if(v->present[i]){if(v->role[i].pid==pid)return 0;if(v->role[i].pid==parent)child=1;}
+ return child||project?ERROR_BUSY:0; /* unchanged host baseline, never a name exemption */
+}
+static __inline DWORD ps_bd_costs(const PS_BD_INVENTORY *v,const PS_BD_COST c[PS_BD_ROLES])
+{
+ unsigned i;ULONGLONG a=0,b=0,w=0,s=0;DWORD h=0,t=0;
+ for(i=0;i<PS_BD_ROLES;i++)if(v->present[i]){
+  const PS_BD_COST *p=&c[i];ULONGLONG cap=(i==PS_BD_ADMIN||i==PS_BD_CONSOLE?256:64)*PS_BD_MIB;
+  if(p->error)return p->error;
+  if(p->private_bytes>cap||p->commit>cap||p->working_set>cap||p->stack>(i==PS_BD_ADMIN||i==PS_BD_CONSOLE?32:8)*PS_BD_MIB||
+  p->handles>(i==PS_BD_ADMIN||i==PS_BD_CONSOLE?1024U:128U)||!p->threads||p->threads>(i==PS_BD_ADMIN||i==PS_BD_CONSOLE?64U:16U))return ERROR_NOT_ENOUGH_QUOTA;
+  if(i==PS_BD_ADMIN||i==PS_BD_CONSOLE){a+=p->private_bytes;b+=p->commit;w+=p->working_set;s+=p->stack;h+=p->handles;t+=p->threads;}
+ }
+ /* Values are bounded above before summation: no unchecked unbounded input. */
+ return a<=256*PS_BD_MIB&&b<=256*PS_BD_MIB&&w<=256*PS_BD_MIB&&s<=32*PS_BD_MIB&&h<=1024U&&t<=64U?0:ERROR_NOT_ENOUGH_QUOTA;
+}
+#endif
--- preimage/apps/server/server_service_admission_bd_win32.inc
+++ current/apps/server/server_service_admission_bd_win32.inc
@@ -0,0 +1,84 @@
+/* SAME PS_ADMISSION owner. No entrypoint, registry, mutex or activation here. */
+static int psa_bd_file(const BY_HANDLE_FILE_INFORMATION *a,const BY_HANDLE_FILE_INFORMATION *b)
+{return a->dwVolumeSerialNumber==b->dwVolumeSerialNumber&&a->nFileIndexHigh==b->nFileIndexHigh&&a->nFileIndexLow==b->nFileIndexLow&&a->nFileSizeHigh==b->nFileSizeHigh&&a->nFileSizeLow==b->nFileSizeLow&&a->nNumberOfLinks==1&&!(a->dwFileAttributes&(FILE_ATTRIBUTE_DIRECTORY|FILE_ATTRIBUTE_REPARSE_POINT));}
+static DWORD psa_bd_no_impersonation(HANDLE thread)
+{
+ if(PSA.bd.unexpected)return ERROR_INVALID_STATE;
+ if(OpenThreadToken(thread,TOKEN_QUERY,TRUE,&PSA.bd.unexpected))return ERROR_ACCESS_DENIED;
+ return GetLastError()==ERROR_NO_TOKEN?0:psa_error();
+}
+static DWORD psa_bd_current(void)
+{
+ const PS_BD_DESCRIPTOR *d=&PSA.bd.binding;FILETIME ct,et,kt,ut;DWORD n,session;WCHAR path[1024];TOKEN_STATISTICS s;TOKEN_ELEVATION elevation;
+ union {TOKEN_USER aligned;BYTE bytes[256];} u;BY_HANDLE_FILE_INFORMATION id;DWORD e;
+ if(PSA.stop||PSA.phase!=1||!PSA.owned||PSA.thread!=GetCurrentThreadId())return ERROR_INVALID_STATE;
+ if((e=psa_bd_no_impersonation(GetCurrentThread()))||(e=psa_bd_no_impersonation(PSA.bd.thread)))return e;
+ if(GetProcessId(PSA.launcher)!=d->actor.pid||GetProcessIdOfThread(PSA.bd.thread)!=d->actor.pid||GetThreadId(PSA.bd.thread)!=d->control_tid||
+ WaitForSingleObject(PSA.launcher,0)!=WAIT_TIMEOUT||WaitForSingleObject(PSA.bd.thread,0)!=WAIT_TIMEOUT||
+ !GetProcessTimes(PSA.launcher,&ct,&et,&kt,&ut)||(((ULONGLONG)ct.dwHighDateTime<<32)|ct.dwLowDateTime)!=d->actor.creation||
+ !ProcessIdToSessionId(d->actor.pid,&session)||session!=d->actor.session||!ProcessIdToSessionId(d->owner_pid,&session)||session!=d->actor.session)return ERROR_INVALID_DATA;
+ n=1024;if(!QueryFullProcessImageNameW(PSA.launcher,0,path,&n)||_wcsicmp(path,L"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"))return ERROR_INVALID_DATA;
+ ZeroMemory(&u,sizeof(u));n=0;
+ if(!GetTokenInformation(PSA.token,TokenUser,&u,sizeof(u),&n)||n<sizeof(TOKEN_USER)||n>sizeof(u)||
+ (BYTE *)u.aligned.User.Sid<u.bytes||(BYTE *)u.aligned.User.Sid>u.bytes+n-8U||
+ ((BYTE *)u.aligned.User.Sid)[1]>SID_MAX_SUB_AUTHORITIES||8U+4U*((BYTE *)u.aligned.User.Sid)[1]>n-(DWORD)((BYTE *)u.aligned.User.Sid-u.bytes)||
+ !IsValidSid(u.aligned.User.Sid)||GetLengthSid(u.aligned.User.Sid)>sizeof(u)-(size_t)((BYTE *)u.aligned.User.Sid-u.bytes)||!EqualSid(u.aligned.User.Sid,(PSID)d->sid))return ERROR_INVALID_OWNER;
+ if(!GetTokenInformation(PSA.token,TokenElevation,&elevation,sizeof(elevation),&n)||!elevation.TokenIsElevated||
+ !GetTokenInformation(PSA.token,TokenStatistics,&s,sizeof(s),&n)||s.TokenType!=TokenPrimary||
+ memcmp(&s.TokenId,&d->statistics.TokenId,sizeof(LUID))||memcmp(&s.AuthenticationId,&d->statistics.AuthenticationId,sizeof(LUID))||memcmp(&s.ModifiedId,&d->statistics.ModifiedId,sizeof(LUID)))return ERROR_ACCESS_DENIED;
+ if(!GetFileInformationByHandle(d->configuration,&id)||!psa_bd_file(&id,&d->config_id)||!GetFileInformationByHandle(d->image,&id)||!psa_bd_file(&id,&d->image_id))return ERROR_INVALID_DATA;
+ return PSA.bd.check?PSA.bd.check(d):ERROR_NOT_SUPPORTED;
+}
+static DWORD psa_bd_confirm(void)
+{
+ const PS_BD_DESCRIPTOR *d=&PSA.bd.binding;WCHAR text[1024],reply[192],expected[192];DWORD n=0,w=0,im,om;int length;
+ PSA.bd.input=CreateFileW(L"CONIN$",GENERIC_READ|GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,NULL,OPEN_EXISTING,0,NULL);
+ if(PSA.bd.input==INVALID_HANDLE_VALUE){PSA.bd.input=NULL;return psa_error();}
+ PSA.bd.output=CreateFileW(L"CONOUT$",GENERIC_READ|GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,NULL,OPEN_EXISTING,0,NULL);
+ if(PSA.bd.output==INVALID_HANDLE_VALUE){PSA.bd.output=NULL;return psa_error();}
+ if(!GetConsoleMode(PSA.bd.input,&im)||!GetConsoleMode(PSA.bd.output,&om)||(im&(ENABLE_LINE_INPUT|ENABLE_ECHO_INPUT))!=(ENABLE_LINE_INPUT|ENABLE_ECHO_INPUT))return ERROR_ACCESS_DENIED;
+ if(swprintf_s(expected,192,L"BIND_BD_READ_ONLY %hs %lu %llu %llu",d->attempt,(unsigned long)d->owner_pid,d->owner_creation,d->challenge)<0)return ERROR_INVALID_DATA;
+ length=swprintf_s(text,1024,L"B+D owner binding ONLY; no operational authority. Actor=%lu creation=%llu; boot=%llu; attempt=%hs\r\nPlan=%hs\r\nConfiguration=%hs\r\nBinary=%hs\r\nPolicy=%hs\r\nHost=%hs\r\nConsole remains DENY without factual proof. Type exactly:\r\n%ls\r\n> ",(unsigned long)d->actor.pid,d->actor.creation,d->boot,d->attempt,d->plan,d->config_hash,d->image_hash,d->policy,d->host,expected);
+ if(length<0||!WriteConsoleW(PSA.bd.output,text,(DWORD)length,&w,NULL)||w!=(DWORD)length||!ReadConsoleW(PSA.bd.input,reply,191,&n,NULL)||n>=192)return ERROR_ACCESS_DENIED;
+ reply[n]=0;while(n&&(reply[n-1]=='\r'||reply[n-1]=='\n'))reply[--n]=0;
+ return wcscmp(reply,expected)?ERROR_CANCELLED:0;
+}
+DWORD papacc_server_service_admission_bd_bind(const PS_BD_DESCRIPTOR *d,PS_BD_CONTEXT_CHECK check)
+{
+ FILETIME ct,et,kt,ut;DWORD e;
+ if(PSA.phase!=1||!PSA.owned||PSA.thread!=GetCurrentThreadId()||PSA.stop||PSA.consumed||PSA.bd.used||PSA.launcher||PSA.token)return ERROR_INVALID_STATE;
