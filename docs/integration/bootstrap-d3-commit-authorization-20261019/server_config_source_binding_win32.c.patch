+PAPACC_RESULT papacc_server_config_initial_bootstrap_commit(PAPACC_SERVER_LAUNCHER_OWNER_WIN32 *o,
+ const PC_DOCUMENT *doc,const PAPACC_U8 *image,PAPACC_SIZE bytes,const char *leaf,PAPACC_SIZE reserved)
+{
+ PAPACC_BOOTSTRAP_RESOLUTION resolved;PC_DIAGNOSTIC diagnostic;PAPACC_CONFIG_VIEW expected;
+ PAPACC_CONFIGURATION_COMMIT *c;const PC_LINE *line;unsigned length;
