static void setup(unsigned count)
{unsigned i;PAPACC_U8 *q;memset(&model,0,sizeof(model));memcpy(model.fields,"PACLST01",8);
 put16(model.fields+8,1);put16(model.fields+10,128);put32(model.fields+12,160U+512U*count);
 put16(model.fields+16,count);put16(model.fields+18,512);put32(model.fields+20,15);
 model.fields[24]=1;model.fields[56]=2;model.fields[64]=3;model.fields[72]=4;model.fields[88]=1;put16(model.fields+96,1);
 for(i=0;i<count;++i){q=model.fields+128U+512U*i;put32(q,127);q[4]=1;q[5]=1;q[6]=1;
 put16(q+8,443U+i);put16(q+10,2);put16(q+12,3);put16(q+16,3);
 q[24]='L';q[25]=(PAPACC_U8)('a'+i);memcpy(q+88,"tls",3);memcpy(q+216,"pol",3);q[280]=1;q[312]=2;}}
static int unavailable(void *c,const PAPACC_U8 *p,PAPACC_SIZE n,PAPACC_U8 h[32])
{(void)c;(void)p;(void)n;(void)h;return 0;}
static int seal(PAPACC_SIZE n)
{return papacc_configuration_issuer_hash06(&owner,bytes,n-32U,bytes+n-32U);}
