 memcpy(bytes,saved,n);put32(bytes+128,255);bytes[135]=1;put16(bytes+142,3);memcpy(bytes+280,"usr",3);CHECK(seal(n));
 CHECK(pc_lst1_decode(bytes,n,&decoded,&complete,papacc_configuration_issuer_hash06,&owner)==PC_LST1_UNSUPPORTED&&!complete);
 setup(2);memcpy(model.fields+128+512+24,model.fields+128+24,2);used=99;
 CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,papacc_configuration_issuer_hash06,&owner)==PC_LST1_INVALID&&!used);
 setup(1);q=model.fields+128;q[6]=2;put16(q+18,2);q[384]=1;q[400]=1;memset(q+408,255,8);
 CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,papacc_configuration_issuer_hash06,&owner)==0);
 CHECK(pc_lst1_decode(bytes,used,&decoded,&complete,papacc_configuration_issuer_hash06,&owner)==0&&complete);
 memset(q+408,0,8);CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,papacc_configuration_issuer_hash06,&owner)==PC_LST1_INVALID);
 /* UTF8 invalid/control/BOM/overlong/surrogate/out-of-range/truncated/tail. */
 {static const PAPACC_U8 bad[][4]={{0,0,0,0},{31,0,0,0},{127,0,0,0},{0xc0,0xaf,0,0},{0xed,0xa0,0x80,0},{0xf4,0x90,0x80,0x80},{0xef,0xbb,0xbf,0},{0xc2,0,0,0}};
 for(j=0;j<sizeof(bad)/sizeof(bad[0]);++j){setup(1);q=model.fields+128;memcpy(q+88,bad[j],4);put16(q+12,4);
