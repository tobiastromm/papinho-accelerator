 setup(1);q=model.fields+128;put32(q,255);q[7]=1;put16(q+14,3);memcpy(q+152,"usr",3);used=99;
 CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,papacc_configuration_issuer_hash06,&owner)==PC_LST1_UNSUPPORTED&&used==0);
 /* Binary CLOSED/authkind remains known but never accepted as auth. */
 memcpy(bytes,saved,n);bytes[128+5]=2;CHECK(seal(n));complete=99;
