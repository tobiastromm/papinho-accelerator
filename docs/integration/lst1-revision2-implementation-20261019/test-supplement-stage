 complete=99;CHECK(pc_lst1_decode(bytes,n+1U,&decoded,&complete,papacc_configuration_issuer_hash06,&owner)!=0&&complete==0);
 /* Rehashed hostile bytes: structural checks independent from digest. */
 {static const unsigned offsets[]={0,8,10,12,16,18,20,56,80,88,96,98,128,132,133,134,135,138,140,142,144,146,148,152,216,280,344,512};
