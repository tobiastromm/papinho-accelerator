 setup(1);q=model.fields+128;memset(q+88,0,64);q[88]=0xc3;q[89]=0xa9;q[90]='#';q[91]=';';put16(q+12,4);
 CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,papacc_configuration_issuer_hash06,&owner)==0);
 CHECK(pc_lst1_decode(bytes,used,&decoded,&complete,papacc_configuration_issuer_hash06,&owner)==0);
 setup(1);used=99;CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,unavailable,NULL)==PC_LST1_HASH_FAILED&&!used);
 used=99;CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,NULL,NULL)==PC_LST1_HASH_FAILED&&!used);
 CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),&used,papacc_configuration_issuer_hash06,&owner)==0);n=used;
 complete=99;memset(&decoded,255,sizeof(decoded));CHECK(pc_lst1_decode(bytes,n,&decoded,&complete,unavailable,NULL)==PC_LST1_HASH_FAILED&&!complete);
 for(i=0;i<sizeof(decoded);++i)CHECK(((PAPACC_U8 *)&decoded)[i]==0);
 used=99;CHECK(pc_lst1_encode(&model,(PAPACC_U8 *)&model,sizeof(model),&used,NULL,NULL)==PC_LST1_INVALID&&used==99);
 CHECK(pc_lst1_encode(&model,bytes,159,&used,NULL,NULL)==PC_LST1_INVALID&&used==99);
 CHECK(pc_lst1_encode(&model,bytes,sizeof(bytes),(PAPACC_SIZE *)bytes,NULL,NULL)==PC_LST1_INVALID);
 complete=99;CHECK(pc_lst1_decode(bytes,n,(PC_LST1_MODEL *)bytes,&complete,NULL,NULL)==PC_LST1_INVALID&&complete==99);
 CHECK(pc_lst1_decode(bytes,n,&decoded,(int *)&decoded,NULL,NULL)==PC_LST1_INVALID);
 CHECK(pc_lst1_decode(NULL,n,&decoded,&complete,NULL,NULL)==PC_LST1_INVALID);
 /* Historic discriminators never reinterpreted; no historic codec modified. */
 {static const char *names[]={"ADMP0201","ADMP0301","ADMP0401","ADMP0501","ROOT0601"};
 for(j=0;j<5U;++j){memcpy(bytes,saved,160);memcpy(bytes,names[j],8);complete=99;
 result=pc_lst1_decode(bytes,160,&decoded,&complete,papacc_configuration_issuer_hash06,&owner);CHECK(result==PC_LST1_INVALID&&!complete);}}
 CHECK(papacc_configuration_stop(&owner)==PAPACC_RESULT_OK);
 CHECK(papacc_configuration_finish(&owner)==PAPACC_RESULT_OK);
 printf("LST1_PASS checks=%u native_existing_SHA256 synthetic_configuration NO_CURRENT NO_NETWORK\n",checks);
 printf("CENSUS model=%Iu two_models=%Iu encoded_pair=%u AST=%Iu input=%u used=%Iu complete=%Iu codec_hash_stack=32 product_delta=0 no_new_pins\n",
 sizeof(model),2U*sizeof(model),2U*PC_LST1_MAX_BYTES,sizeof(PC_DOCUMENT),PC_SOURCE_MAX,sizeof(used),sizeof(complete));
