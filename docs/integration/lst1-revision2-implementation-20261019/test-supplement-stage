  CHECK(pc_lst1_decode(bytes,n,&decoded,&complete,papacc_configuration_issuer_hash06,&owner)!=0&&complete==0);}}
 /* Nonzero changed provenance/digest are structurally data, never CURRENT. */
 memcpy(bytes,saved,n);bytes[64]=255;bytes[72]=255;bytes[440]=255;CHECK(seal(n));complete=99;
