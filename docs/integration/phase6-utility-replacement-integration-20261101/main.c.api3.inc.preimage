static const char *papacc_server_log_level_name(PAPACC_LOG_LEVEL level)
{
    switch (level) {
    case PAPACC_LOG_TRACE: return "TRACE";
    case PAPACC_LOG_DEBUG: return "DEBUG";
    case PAPACC_LOG_INFO: return "INFO";
    case PAPACC_LOG_WARNING: return "WARN";
    case PAPACC_LOG_ERROR: return "ERROR";
    case PAPACC_LOG_LEVEL_OFF: return "OFF";
    default: return "UNKNOWN";
    }
}

static const char *papacc_server_log_component_name(
    PAPACC_LOG_COMPONENT_ID component)
{
    switch (component) {
    case PAPACC_LOG_COMPONENT_RUNTIME: return "runtime";
    case PAPACC_LOG_COMPONENT_SERVER: return "server";
    case PAPACC_LOG_COMPONENT_SERVER_IO_LOOP: return "server-io-loop";
    default: return "unspecified";
    }
}

static void papacc_server_console_log_sink(
    void *context, const PAPACC_LOG_RECORD *record)
{
    FILE *output = (FILE *)context;
    fprintf(output, "[%s] %s: %s",
            papacc_server_log_level_name(record->level),
            papacc_server_log_component_name(record->component_id),
            record->message);
    if ((record->context.fields & PAPACC_LOG_CONTEXT_LOCAL_ENDPOINT) != 0)
        fprintf(output, " local=%s", record->context.local_endpoint);
    if ((record->context.fields & PAPACC_LOG_CONTEXT_REMOTE_ENDPOINT) != 0)
        fprintf(output, " remote=%s", record->context.remote_endpoint);
    fputc('\n', output);
    (void)fflush(output);
}

static void papacc_server_print_help(void)
{
    puts("PapinhoAccelerator Server");
    puts("Usage:");
    puts("  papacc_server.exe --help");
#if defined(PAPACC_ENABLE_CONFIG_ADMIN_CLI)
    puts("  papacc_server.exe config validate|diff|apply --source <file>");
    puts("  papacc_server.exe config show-effective");
    puts("  Configuration: offline validation only; CURRENT/apply unavailable");
#endif
#ifdef PAPACC_ENABLE_SERVICE_CLI
    puts("  papacc_server.exe service install|start|stop|status|remove");
    puts("  papacc_server.exe service startup automatic|manual");
    puts("  papacc_server.exe service install --prepare-lab --installation <directory> --configuration <relative-file>");
    puts("  Service hosting is optional; install uses a virtual account, no password.");
    puts("  Service mutations remain denied until installation and admission are qualified.");
#endif
    puts("  papacc_server.exe --list-interfaces");
    puts("  papacc_server.exe --port <port> --all-interfaces [--listener-profile legacy-endpoint] [--log-level <level>]");
    puts("  papacc_server.exe --port <port> --interface-id <id> [--interface-id <id> ...] [--listener-profile legacy-endpoint] [--log-level <level>]");
    puts("  papacc_server.exe --port <port> <bind-option> --listener-profile secure-principal --security-configuration-ref <reference> [--allow-network-egress --egress-policy-ref <reference> --egress-profile-ref <reference> --outbound-tls-profile-ref <reference>] [--log-level <level>]");
    puts("Secure Principal lab source environment:");
    puts("  PAPACC_SECURITY_CONFIGURATION_REF");
    puts("  PAPACC_SERVER_CERTIFICATE_DER_B64");
    puts("  PAPACC_SERVER_PRIVATE_KEY_PKCS8_DER_B64");
    puts("  PAPACC_CLIENT_CA_DER_B64");
    puts("  PAPACC_ALLOWED_CLIENT_CERT_SHA256");
    puts("Log levels: off, error, warn, info (default), debug, trace");
    puts("  off disables all PAPACC_LOGGER output");
    puts("Example: papacc_server.exe --port 39999 --all-interfaces --log-level info");
}

static const char *papacc_server_result_name(PAPACC_RESULT result)
{
    switch (result) {
    case PAPACC_RESULT_OK:
        return "OK";
    case PAPACC_RESULT_INVALID_ARGUMENT:
        return "INVALID_ARGUMENT";
    case PAPACC_RESULT_OUT_OF_MEMORY:
        return "OUT_OF_MEMORY";
    case PAPACC_RESULT_NOT_SUPPORTED:
        return "NOT_SUPPORTED";
    case PAPACC_RESULT_INVALID_STATE:
        return "INVALID_STATE";
    case PAPACC_RESULT_LIMIT_EXCEEDED:
        return "LIMIT_EXCEEDED";
    case PAPACC_RESULT_INTERNAL_ERROR:
        return "INTERNAL_ERROR";
    default:
        return "UNKNOWN";
    }
}

/* Same runtime in both hosts. Receipts are emitted after factual points,
 * never inferred from the final integer exit or elapsed time. */
static void papacc_runtime_receipt(int clean)
{
#ifdef PAPACC_ENABLE_SERVICE_CLI
 if(clean)papacc_server_service_runtime_closed();else papacc_server_service_runtime_retained();
#else
 (void)clean;
#endif
}
static int papacc_server_run(const PAPACC_SERVER_CONFIG *config,PAPACC_NETWORK_INTERFACE_PERSISTENT_ID *cli_id_storage,PAPACC_LOG_LEVEL log_level)
{
 static PAPACC_SERVER_CONSOLE_WIN32 console=PAPACC_SERVER_CONSOLE_WIN32_INITIALIZER;
 static PAPACC_SERVER_NETWORK network=PAPACC_SERVER_NETWORK_INITIALIZER;
 static PAPACC_LOGGER logger;static PAPACC_SERVER_CONFIG owned_config;PAPACC_RESULT result;
    int qualification=0;
#ifdef PAPACC_ENABLE_SERVICE_CLI
    qualification=papacc_server_service_qualification_active();
#endif
 owned_config=*config;config=&owned_config;
 if(papacc_logger_init(&logger,papacc_server_console_log_sink,stderr,log_level)!=PAPACC_RESULT_OK){free(cli_id_storage);papacc_runtime_receipt(1);return 1;}
#ifdef PAPACC_ENABLE_SERVICE_CLI
 if(papacc_server_service_host_active())result=PAPACC_RESULT_OK;
 else
#endif
 result=papacc_server_console_win32_install(&console);
 if(result!=PAPACC_RESULT_OK){free(cli_id_storage);papacc_runtime_receipt(1);return 1;}
 /* Admission remains closed. A ready host never grants listener authority. */
 if(qualification)result=PAPACC_RESULT_OK; /* closed LAB has no operational effect */
 else result=papacc_application_require_operational_admission();
 if(result==PAPACC_RESULT_OK&&!qualification)result=papacc_server_network_start(&network,config);
 if(result!=PAPACC_RESULT_OK){
  fprintf(stderr,"Server startup failed: %s\n",papacc_server_result_name(result));
  if(papacc_server_network_try_shutdown(&network)!=PAPACC_RESULT_OK||papacc_server_console_win32_uninstall(&console)!=PAPACC_RESULT_OK){papacc_runtime_receipt(0);return 1;}
  free(cli_id_storage);papacc_runtime_receipt(1);return 1;
 }
 result=papacc_application_parent_register(&network,config,&logger);
 if(result!=PAPACC_RESULT_OK){
  if(papacc_server_network_try_shutdown(&network)!=PAPACC_RESULT_OK||papacc_server_console_win32_uninstall(&console)!=PAPACC_RESULT_OK){papacc_runtime_receipt(0);return 1;}
  free(cli_id_storage);papacc_runtime_receipt(1);return 1;
 }
 result=papacc_server_run_win32(&network,config,stdout,stderr,&logger);
 if(papacc_application_lifetime_state()==PAPACC_APPLICATION_RETAINED){papacc_runtime_receipt(0);return 1;}
 if(papacc_application_logger_seal()!=PAPACC_RESULT_OK){(void)papacc_application_parent_retain();papacc_runtime_receipt(0);return 1;}
 if(papacc_server_network_try_shutdown(&network)!=PAPACC_RESULT_OK){(void)papacc_application_parent_retain();papacc_runtime_receipt(0);return 1;}
 if(papacc_server_console_win32_uninstall(&console)!=PAPACC_RESULT_OK){(void)papacc_application_parent_retain();papacc_runtime_receipt(0);return 1;}
 free(cli_id_storage);owned_config.bind_selection.interface_persistent_ids=NULL;owned_config.bind_selection.interface_persistent_id_count=0U;
 papacc_runtime_receipt(1);return result==PAPACC_RESULT_OK?0:1;
}

#ifdef PAPACC_ENABLE_SERVICE_CLI
static int papacc_server_entry(int argc, char **argv)
#else
int main(int argc, char **argv)
#endif
{
#ifdef PAPACC_ENABLE_SERVICE_CLI
    if(papacc_server_service_scq_preparation_current())
        return papacc_server_launcher_scq_closed_prepare();
#endif
#if defined(PAPACC_ENABLE_CONFIG_ADMIN_CLI)
    int config_result = papacc_server_config_cli(
        argc, (const char *const *)argv, stdout, stderr);
    if (config_result >= 0) return config_result;
#endif
#ifdef PAPACC_ENABLE_SERVICE_CLI
    if(papacc_server_service_qualification_active()){
        PAPACC_SERVER_CONFIG closed_config=PAPACC_SERVER_CONFIG_INITIALIZER;
        size_t bytes=0;const unsigned char *source=papacc_server_service_qualification_source(&bytes);
        /* Exact protected source is the existing deny-only LAB configuration.
         * No port/bind/grant/CURRENT is invented from an operational default. */
        if(!source||bytes!=116U){papacc_runtime_receipt(1);return 2;}
        return papacc_server_run(&closed_config,NULL,PAPACC_LOG_INFO);
    }
#endif
    if (argc > 1) {
        PAPACC_SERVER_CLI_REQUEST request =
            PAPACC_SERVER_CLI_REQUEST_INITIALIZER;
        PAPACC_NETWORK_INTERFACE_PERSISTENT_ID *id_storage = NULL;
        PAPACC_SIZE required_ids = 0;
        PAPACC_RESULT result = papacc_server_cli_request_parse(
            argc, (const char *const *)argv, NULL, 0, &request,
            &required_ids);

        if (result == PAPACC_RESULT_LIMIT_EXCEEDED && required_ids != 0) {
            if (required_ids > SIZE_MAX / sizeof(*id_storage)) {
                result = PAPACC_RESULT_LIMIT_EXCEEDED;
            } else {
                id_storage =
                    (PAPACC_NETWORK_INTERFACE_PERSISTENT_ID *)malloc(
                        required_ids * sizeof(*id_storage));
                if (id_storage == NULL) {
                    result = PAPACC_RESULT_OUT_OF_MEMORY;
                } else {
                    result = papacc_server_cli_request_parse(
                        argc, (const char *const *)argv, id_storage,
                        required_ids, &request, &required_ids);
                }
            }
        }
        if (result != PAPACC_RESULT_OK) {
            fprintf(stderr, "Invalid server command: %s\n",
                    papacc_server_result_name(result));
            free(id_storage);
            return 1;
        }
        if (request.action == PAPACC_SERVER_CLI_ACTION_LIST_INTERFACES) {
            free(id_storage);
            return papacc_server_cli_list_interfaces(stdout) == PAPACC_RESULT_OK
                       ? 0
                       : 1;
        }
        if (request.action == PAPACC_SERVER_CLI_ACTION_HELP) {
            free(id_storage);
            papacc_server_print_help();
            return 0;
        }
        return papacc_server_run(
            &request.config, id_storage, request.log_level);
    }

    puts("PapinhoAccelerator Server");
    puts("Foundation build");
    printf("Software version %s\n", papacc_version_string());

    return 0;
}

#ifdef PAPACC_ENABLE_SERVICE_CLI
int main(int argc,char **argv)
{
 int s;
 if(argc>1&&argv[1]&&!strcmp(argv[1],"--owner-manual-prepare-update-utility")){
#ifdef PAPACC_SCM_INSTRUMENTED_LAB
  return 2;
#else
  return papacc_server_launcher_utility_prep_cli(argc,(const char *const *)argv,stdout,stderr);
#endif
 }
#ifndef PAPACC_SCM_INSTRUMENTED_LAB
 s=papacc_server_launcher_scq_original_cli(argc,(const char *const *)argv,stdout,stderr);
 if(s>=0)return s;
#endif
 if(argc>1&&argv[1]&&!strcmp(argv[1],"--owner-manual-binary-update")){
#ifdef PAPACC_SCM_INSTRUMENTED_LAB
  return 2;
#else
  return papacc_server_launcher_binary_update_cli(argc,(const char *const *)argv,stdout,stderr);
#endif
 }
 /* Owner-manual only: native confirmation is mandatory; never default/test. */
 if(argc==5&&argv[1]&&!strcmp(argv[1],"--owner-manual-selected-staging"))
#ifdef PAPACC_SCM_INSTRUMENTED_LAB
  return 2;
#else
  return papacc_server_launcher_selected_staging(argv[2],argv[3],argv[4],stdout,stderr);
#endif
 /* Explicit read-only observation, not service registration/start or staging.
  * No default invocation or test campaign runs this native collection. */
 if(argc==2&&argv[1]&&!strcmp(argv[1],"--owner-manual-root-chain-metadata"))
#ifdef PAPACC_SCM_INSTRUMENTED_LAB
  return 2;
#else
  return papacc_server_launcher_chain_metadata(stdout,stderr);
#endif
 if(argc==2&&argv[1]&&!strcmp(argv[1],"--qualification-staging-observe"))
#ifdef PAPACC_SCM_INSTRUMENTED_LAB
  return 2;
#else
  return papacc_server_launcher_staging_observe(stdout,stderr);
#endif
#if defined(PAPACC_C8_PRIVATE_STORAGE_PROFILE) && defined(PAPACC_ENABLE_PST_OUTBOUND_TLS)
 s=papacc_server_service_cli(argc,(const char *const *)argv,stdout,stderr,papacc_server_launcher_scm_prepare);
#else
 s=papacc_server_service_cli(argc,(const char *const *)argv,stdout,stderr,NULL);
#endif
 if(s>=0)return s;
 s=papacc_server_service_dispatch(argc,argv,papacc_server_entry);
 if(s>=0)return s;
 return papacc_server_entry(argc,argv);
}
#endif
