static void close_bound_stream(PAPACC_SERVER_IO_LOOP_WIN32*,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*);
static PAPACC_RESULT process_network_open_frame(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,PAPACC_U64 now)
{
    PAPACC_SIZE pass;
    PAPACC_NETWORK_STREAM*stream=NULL;
    if(s->network_data_protocol.state==PAPACC_NETWORK_DATA_ACTIVE){
        stream=papacc_network_stream_find_channel(&l->network_stream_manager,
            s->network_data_protocol.channel_instance_id);
        if(stream==NULL)return PAPACC_RESULT_INVALID_STATE;
        if(papacc_network_stream_client_space(stream)<
            PAPACC_SERVER_PROTOCOL_READ_BUFFER_SIZE)return PAPACC_RESULT_OK;
    }
    for(pass=0U;pass<4U;++pass){
        PAPACC_FRAMED_READER_STATUS rs;
        PAPACC_FRAME_PARSER_EVENT ev;
        PAPACC_RESULT r=papacc_framed_reader_next(
            &s->data_attach_processor.reader,&rs,&ev);
        if(r!=PAPACC_RESULT_OK)return r;
        if(rs==PAPACC_FRAMED_READER_STATUS_END_OF_STREAM){
            if(s->network_data_protocol.state==PAPACC_NETWORK_DATA_ACTIVE)
                close_bound_stream(l,s);
            else{
                PAPACC_CONNECTION*c=slot_connection(l,s);
                s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
                if(c!=NULL)papacc_connection_close(c);
            }
            return PAPACC_RESULT_OK;
        }
        if(rs!=PAPACC_FRAMED_READER_STATUS_EVENT)return PAPACC_RESULT_OK;
        if(s->network_data_protocol.state==PAPACC_NETWORK_DATA_ACTIVE){
            if(ev.header.message_type==PAPACC_MESSAGE_TYPE_NETWORK_DATA){
                PAPACC_RESULT enqueue_result=PAPACC_RESULT_OK;
                if(stream->client_half_close_requested==PAPACC_TRUE)
                    return PAPACC_RESULT_PROTOCOL_ERROR;
                if(ev.payload_length!=0U)enqueue_result=
                    papacc_network_stream_enqueue_client(stream,ev.payload,
                        ev.payload_length);
                if(enqueue_result!=PAPACC_RESULT_OK)return enqueue_result;
                if(ev.type==PAPACC_FRAME_PARSER_EVENT_FRAME_COMPLETE)
                    return PAPACC_RESULT_OK;
                continue;
            }
            if(papacc_network_terminal_validate(ev.header.message_type,
                ev.header.payload_length)!=PAPACC_RESULT_OK||
                ev.type!=PAPACC_FRAME_PARSER_EVENT_FRAME_COMPLETE)
                return PAPACC_RESULT_PROTOCOL_ERROR;
            if(ev.header.message_type==PAPACC_MESSAGE_TYPE_NETWORK_HALF_CLOSE){
                PAPACC_RESULT half_result=
                    papacc_network_stream_half_close_client(stream);
                if(half_result!=PAPACC_RESULT_OK)return half_result;
                return PAPACC_RESULT_OK;
            }
            if(ev.header.message_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE&&
                stream->transport_mode==PAPACC_NETWORK_TRANSPORT_TLS_REQUIRED){
                PAPACC_RESULT accept_result=accept_owner_terminal(l,stream,
                    PAPACC_MESSAGE_TYPE_NETWORK_CLOSE);
                if(accept_result!=PAPACC_RESULT_OK)return accept_result;
                s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
                return papacc_network_stream_request_close(stream,
                    deadline(now,l->establishment_timeout_ns));
            }
            if(ev.header.message_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE||
                ev.header.message_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT){
                PAPACC_RESULT accept_result=accept_owner_terminal(l,stream,
                    ev.header.message_type);
                PAPACC_CONNECTION*connection;
                if(accept_result!=PAPACC_RESULT_OK)return accept_result;
                connection=slot_connection(l,s);
                (void)papacc_network_stream_close_channel(
                    &l->network_stream_manager,
                    s->network_data_protocol.channel_instance_id);
                s->establishment.reservation=NULL;
                s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
                if(connection!=NULL)papacc_connection_close(connection);
                return PAPACC_RESULT_OK;
            }
            return PAPACC_RESULT_PROTOCOL_ERROR;
        }
        if(ev.header.message_type!=PAPACC_MESSAGE_TYPE_NETWORK_OPEN||
            s->network_open_received+ev.payload_length>
                sizeof(s->network_open_payload))return PAPACC_RESULT_PROTOCOL_ERROR;
        if(ev.payload_length!=0U){
            memcpy(&s->network_open_payload[s->network_open_received],
                ev.payload,ev.payload_length);
            s->network_open_received+=ev.payload_length;
        }
        if(ev.type==PAPACC_FRAME_PARSER_EVENT_FRAME_COMPLETE){
            PAPACC_SESSION_CAPABILITY_SNAPSHOT*snap=
                papacc_session_capability_store_find(&l->capability_store,
                    s->data_attach_processor.session_instance_id);
            if(!papacc_capability_operation_allowed(snap,
                    &PAPACC_CAPABILITY_NETWORK_EGRESS_V2,
                    &l->enabled_capabilities,allow_enabled_capability,NULL)&&
                !papacc_capability_operation_allowed(snap,
                    &PAPACC_CAPABILITY_NETWORK_EGRESS_V1,
                    &l->enabled_capabilities,allow_enabled_capability,NULL))
                return PAPACC_RESULT_INVALID_STATE;
            return papacc_network_data_protocol_accept(&s->network_data_protocol,
                ev.header.message_type,s->network_open_payload,
                s->network_open_received);
        }
    }
    return PAPACC_RESULT_OK;
}
