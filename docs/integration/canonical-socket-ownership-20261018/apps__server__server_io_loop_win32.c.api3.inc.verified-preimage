static void progress_stream_to_client(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_NETWORK_STREAM*stream)
{
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s=slot_for_stream(l,stream);
    const PAPACC_U8*payload=NULL;
    PAPACC_SIZE available=0U,written=0U;
    PAPACC_FRAMED_WRITER_STATUS status;
    PAPACC_RESULT r;
    PAPACC_U16 terminal_type;
    PAPACC_BOOL close_after_terminal;
    if(s==NULL||s->open_result_pending==PAPACC_TRUE||
        s->establishment_job_id!=0U)return;
    if(s->network_control_send_pending==PAPACC_TRUE){
        progress_network_control(l,s,stream);
        return;
    }
    if(papacc_network_stream_peek_client(stream,&payload,&available)!=
        PAPACC_RESULT_OK){
        close_bound_stream(l,s);
        return;
    }
    if(available==0U&&stream->remote_half_closed==PAPACC_TRUE&&
        (stream->transport_mode==PAPACC_NETWORK_TRANSPORT_TLS_REQUIRED||
         stream->remote_half_close_signalled!=PAPACC_TRUE)){
        terminal_type=PAPACC_MESSAGE_TYPE_NETWORK_HALF_CLOSE;
        close_after_terminal=stream->client_half_closed;
        if(stream->transport_mode==PAPACC_NETWORK_TRANSPORT_TLS_REQUIRED){
            terminal_type=PAPACC_MESSAGE_TYPE_NETWORK_CLOSE;
            close_after_terminal=PAPACC_TRUE;
        }
        terminal_trace_emit(l,s,stream,"A5",
            "name=TERMINAL_CLASSIFIED terminal=CLEAN_EOF");
        if(begin_network_control(s,terminal_type,
            close_after_terminal)==PAPACC_RESULT_OK){
            terminal_trace_emit(l,s,stream,"A6",
                terminal_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE?
                    "name=PACC_TERMINAL_CONSTRUCTED message=NETWORK_CLOSE":
                    "name=PACC_TERMINAL_CONSTRUCTED message=NETWORK_HALF_CLOSE");
            terminal_trace_emit(l,s,stream,"A7",
                terminal_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE?
                    "name=PACC_TERMINAL_QUEUED message=NETWORK_CLOSE":
                    "name=PACC_TERMINAL_QUEUED message=NETWORK_HALF_CLOSE");
            progress_network_control(l,s,stream);
        }
        return;
    }
    if(available==0U&&stream->client_half_closed==PAPACC_TRUE&&
        stream->remote_half_close_signalled==PAPACC_TRUE){
        close_bound_stream(l,s);
        return;
    }
    if(s->network_data_send_pending!=PAPACC_TRUE){
        PAPACC_FRAME_HEADER header;
        if(papacc_network_stream_peek_client(stream,&payload,&available)!=
            PAPACC_RESULT_OK||available==0U)return;
        if(available>PAPACC_NETWORK_DATA_MAX_PAYLOAD)
            available=PAPACC_NETWORK_DATA_MAX_PAYLOAD;
        header=papacc_network_frame_header(PAPACC_MESSAGE_TYPE_NETWORK_DATA,
            (PAPACC_U32)available);
        if(papacc_framed_writer_begin_frame(&s->data_attach_processor.writer,
            &header)!=PAPACC_RESULT_OK)return;
        s->network_data_send_length=available;
        s->network_data_send_offset=0U;
        s->network_data_send_pending=PAPACC_TRUE;
    }
    if(papacc_network_stream_peek_client(stream,&payload,&available)!=
        PAPACC_RESULT_OK||available<s->network_data_send_length){
        s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
        return;
    }
    r=papacc_framed_writer_step(&s->data_attach_processor.writer,
        payload+s->network_data_send_offset,
        s->network_data_send_length-s->network_data_send_offset,&written,&status);
    if(r!=PAPACC_RESULT_OK){
        PAPACC_CONNECTION*c=slot_connection(l,s);
        if(c!=NULL)papacc_connection_close(c);
        s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
        return;
    }
    s->network_data_send_offset+=written;
    if(status==PAPACC_FRAMED_WRITER_STATUS_FRAME_COMPLETE){
        if(papacc_network_stream_consume_client(stream,
            s->network_data_send_length)!=PAPACC_RESULT_OK){
            s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
            return;
        }
        s->network_data_send_length=0U;
        s->network_data_send_offset=0U;
        s->network_data_send_pending=PAPACC_FALSE;
    }
}

static PAPACC_BOOL drive_active_streams(PAPACC_SERVER_IO_LOOP_WIN32*l,PAPACC_U64 now)
{
    PAPACC_SIZE i;
    PAPACC_NETWORK_STREAM*stream=NULL;
    PAPACC_BOOL made_progress=PAPACC_FALSE;
    PAPACC_SIZE before_client_size=0U,before_send_offset=0U;
    PAPACC_RESULT r=papacc_network_stream_progress_one_observed_at(
        &l->network_stream_manager,PAPACC_SERVER_NETWORK_STREAM_QUANTUM,now,
        &stream,&made_progress);
    if(stream!=NULL){before_client_size=stream->to_client_size;
        {PAPACC_SERVER_PROTOCOL_SLOT_WIN32*before_slot=slot_for_stream(l,stream);
         if(before_slot!=NULL)before_send_offset=before_slot->network_data_send_offset;}}
    if(r==PAPACC_RESULT_OK&&stream!=NULL){
        if(stream->state==PAPACC_NETWORK_STREAM_OPEN&&
            stream->transport_mode==PAPACC_NETWORK_TRANSPORT_TLS_REQUIRED&&
            stream->remote_half_closed==PAPACC_TRUE&&
            stream->remote_half_close_signalled!=PAPACC_TRUE){
            stream->remote_half_closed=PAPACC_FALSE;
            if(papacc_network_stream_request_close(stream,
                    deadline(now,l->establishment_timeout_ns))!=PAPACC_RESULT_OK)
                (void)papacc_network_stream_close_channel(
                    &l->network_stream_manager,stream->data_channel_instance_id);
        }
        PAPACC_SERVER_PROTOCOL_SLOT_WIN32*trace_slot=slot_for_stream(l,stream);
        if(trace_slot!=NULL&&stream->bytes_to_client>
                trace_slot->terminal_trace_last_bytes){
            trace_slot->terminal_trace_last_bytes=stream->bytes_to_client;
            trace_slot->terminal_trace_last_data_ns=now;
            if(trace_slot->terminal_trace_a2!=PAPACC_TRUE){
                terminal_trace_emit_at(l,trace_slot,stream,"A2",now,
                    "name=FIRST_UPSTREAM_BYTE");
                trace_slot->terminal_trace_a2=PAPACC_TRUE;
            }
        }
        if((stream->terminal_pending==PAPACC_TRUE||
                stream->remote_half_closed==PAPACC_TRUE)&&
            trace_slot!=NULL&&trace_slot->terminal_trace_a4!=PAPACC_TRUE){
            char detail[128];
            if(trace_slot->terminal_trace_last_data_ns!=0U){
                char data_detail[64];
                (void)sprintf_s(data_detail,sizeof(data_detail),
                    "name=LAST_UPSTREAM_DATA_BEFORE_TERMINAL bytes=%llu",
                    (unsigned long long)stream->bytes_to_client);
                terminal_trace_emit_at(l,trace_slot,stream,"A3",
                    trace_slot->terminal_trace_last_data_ns,
                    data_detail);
            }
#ifdef PAPACC_ENABLE_PST_OUTBOUND_TLS
            if(stream->transport_mode==PAPACC_NETWORK_TRANSPORT_TLS_REQUIRED)
                (void)sprintf_s(detail,sizeof(detail),
                    "name=UPSTREAM_TLS_TERMINAL_OBSERVED pst_result=%d classification=%s",
                    (int)((PAPACC_OUTBOUND_TLS*)stream->io.context)->processor.source_result,
                    stream->terminal_reason==PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED?
                        "TLS_TRUNCATED":(stream->remote_half_closed==PAPACC_TRUE?
                        "CLEAN_EOF":"OTHER"));
            else (void)sprintf_s(detail,sizeof(detail),
                "pst_result=NA classification=OTHER");
#else
            (void)sprintf_s(detail,sizeof(detail),"classification=%s",
                "OTHER");
#endif
            terminal_trace_emit(l,trace_slot,stream,"A4",detail);
            trace_slot->terminal_trace_a4=PAPACC_TRUE;
        }
    }
    if(r==PAPACC_RESULT_OK&&stream!=NULL&&
        stream->state==PAPACC_NETWORK_STREAM_OPEN)
        progress_stream_to_client(l,stream);
    if(r==PAPACC_RESULT_OK&&stream!=NULL&&
        (stream->state==PAPACC_NETWORK_STREAM_OPEN||
         stream->state==PAPACC_NETWORK_STREAM_CLOSING)&&
        stream->terminal_pending==PAPACC_TRUE&&
        stream->to_client_size==0U){
        PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s=slot_for_stream(l,stream);
        if(s!=NULL&&s->network_data_send_pending!=PAPACC_TRUE&&
            s->network_control_send_pending!=PAPACC_TRUE){
            PAPACC_SESSION_CAPABILITY_SNAPSHOT*snapshot=
                papacc_session_capability_store_find(&l->capability_store,
                    stream->owner_session_instance_id);
            PAPACC_RESULT terminal_result;
            terminal_trace_emit(l,s,stream,"A5",
                stream->terminal_reason==
                    PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED?
                    "name=TERMINAL_CLASSIFIED terminal=TLS_TRUNCATED":
                    (stream->terminal_cause==
                        PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_SHUTDOWN_DEADLINE?
                        "name=TERMINAL_CLASSIFIED terminal=ABORT internal_cause=SHUTDOWN_DEADLINE":
                        "name=TERMINAL_CLASSIFIED terminal=ABORT"));
            if(stream->terminal_reason==
                    PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED&&
                papacc_session_capability_snapshot_contains(snapshot,
                    &PAPACC_CAPABILITY_NETWORK_EGRESS_V2)==PAPACC_TRUE){
                terminal_result=begin_tls_truncated_reason(s);
                log_session(l,PAPACC_LOG_WARNING,
                    PAPACC_LOG_EVENT_SECURE_TRANSPORT_CONNECTION_FAILURE,
                    PAPACC_LOG_OPERATION_CLEANUP,PAPACC_TRUE,
                    PAPACC_RESULT_INTERNAL_ERROR,
                    "TLS truncation mapped to NETWORK_ABORT_REASON",
                    stream->owner_session_instance_id);
            }else{
                terminal_result=begin_network_control(s,
                    PAPACC_MESSAGE_TYPE_NETWORK_ABORT,PAPACC_TRUE);
                log_session(l,PAPACC_LOG_WARNING,
                    PAPACC_LOG_EVENT_SECURE_TRANSPORT_CONNECTION_FAILURE,
                    PAPACC_LOG_OPERATION_CLEANUP,PAPACC_TRUE,
                    PAPACC_RESULT_INTERNAL_ERROR,
                    stream->terminal_reason==
                        PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED?
                        "TLS truncation mapped to NETWORK_ABORT":
                        (stream->terminal_cause==
                            PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_SHUTDOWN_DEADLINE?
                            "Shutdown deadline mapped to NETWORK_ABORT":
                            "Network Stream mapped to NETWORK_ABORT"),
                    stream->owner_session_instance_id);
            }
            if(terminal_result==PAPACC_RESULT_OK){
                terminal_trace_emit(l,s,stream,"A6",
                    stream->terminal_reason==PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED?
                    "name=PACC_TERMINAL_CONSTRUCTED message=NETWORK_ABORT_REASON reason=TLS_TRUNCATED":
                    "name=PACC_TERMINAL_CONSTRUCTED message=NETWORK_ABORT");
                terminal_trace_emit(l,s,stream,"A7",
                    stream->terminal_reason==PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED?
                    "name=PACC_TERMINAL_QUEUED message=NETWORK_ABORT_REASON":
                    "name=PACC_TERMINAL_QUEUED message=NETWORK_ABORT");
                progress_network_control(l,s,stream);
            }else close_bound_stream(l,s);
        }
    }
    {
        for(i=0U;i<l->processor_capacity;++i){
            PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s=&l->processor_slots[i];
            if(s->in_use==PAPACC_TRUE&&
                publication_connection_active(l,s)==PAPACC_TRUE&&
                s->kind==PAPACC_SERVER_PROTOCOL_SLOT_KIND_DATA_ATTACH&&
                (s->network_data_protocol.state==PAPACC_NETWORK_DATA_ACTIVE||
                 s->network_data_protocol.state==PAPACC_NETWORK_DATA_TERMINAL)&&
                s->network_terminal_sent!=PAPACC_TRUE&&
                papacc_network_stream_find_channel(&l->network_stream_manager,
                    s->network_data_protocol.channel_instance_id)==NULL){
                s->establishment.reservation=NULL;
                if(s->network_data_send_pending!=PAPACC_TRUE&&
                    s->data_attach_processor.writer.state==
                        PAPACC_FRAMED_WRITER_STATE_IDLE&&
                    begin_network_control(s,PAPACC_MESSAGE_TYPE_NETWORK_ABORT,
                        PAPACC_TRUE)==PAPACC_RESULT_OK)
                    progress_network_control(l,s,NULL);
                else close_bound_stream(l,s);
            }
        }
    }
    if(stream!=NULL&&stream->state==PAPACC_NETWORK_STREAM_OPEN){
        PAPACC_SERVER_PROTOCOL_SLOT_WIN32*after_slot=slot_for_stream(l,stream);
        if(stream->to_client_size!=before_client_size||
            (after_slot!=NULL&&after_slot->network_data_send_offset!=
                before_send_offset))made_progress=PAPACC_TRUE;
    }
    return made_progress;
}
