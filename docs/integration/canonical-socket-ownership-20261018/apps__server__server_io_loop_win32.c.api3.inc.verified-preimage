        boundary,(unsigned long long)now,(unsigned long)GetCurrentThreadId(),(void*)s,
        (unsigned long long)s->connection_instance_id,c!=NULL?(unsigned)c->state:0U,
        (unsigned long long)s->network_data_protocol.channel_instance_id,
        (unsigned long long)(stream!=NULL?stream->stream_instance_id:0U),
        (unsigned long long)s->network_stream_generation,(unsigned long long)s->network_control_connection_id,
        (unsigned long long)s->network_control_operation_id,(unsigned long long)s->network_control_generation,(const void*)stream,
        stream!=NULL?(unsigned)stream->state:0U,stream!=NULL?(unsigned)stream->terminal_cause:0U,
        (unsigned)s->network_control_send_pending,(unsigned)s->network_control_send_type,
        (unsigned)s->data_attach_processor.writer.state,
        (unsigned long long)s->data_attach_processor.writer.header_offset);
