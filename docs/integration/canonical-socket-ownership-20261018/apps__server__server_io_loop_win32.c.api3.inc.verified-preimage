}
#define AUTHORITY_TRACE(l,s,stream,boundary) publication_authority_trace(l,s,stream,boundary)
#else
#define AUTHORITY_TRACE(l,s,stream,boundary) ((void)0)
#endif
/* A queued terminal never grants authority after its Connection close intent.
 * Keep the queue intact until owner reconciliation; do not run its writer. */
static PAPACC_BOOL publication_connection_active(PAPACC_SERVER_IO_LOOP_WIN32*l,
    const PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s)
{
    PAPACC_CONNECTION*c;
    if(l==NULL||s==NULL)return PAPACC_FALSE;
    if(l->connection_manager==NULL){
#ifdef PAPACC_ENABLE_TEST_OWNER_TERMINAL_HOOKS
        /* Existing standalone owner-hook harness, not an initialized runtime. */
        return l->initialized!=PAPACC_TRUE&&l->owner_terminal_test_thread_id==
            (PAPACC_U32)GetCurrentThreadId()?PAPACC_TRUE:PAPACC_FALSE;
#else
        return PAPACC_FALSE;
#endif
    }
    c=papacc_connection_manager_find(l->connection_manager,s->connection_instance_id);
    return c!=NULL&&(c->state==PAPACC_CONNECTION_STATE_PENDING||
        c->state==PAPACC_CONNECTION_STATE_ASSOCIATED)?PAPACC_TRUE:PAPACC_FALSE;
}
/* ADR-0023 G1: a factual site clean completion may reach the writer's
 * validation after DATA has closed. This grants no delivery authority: the
 * same CLOSED Connection must have an invalid transport, so validation fails
 * before any transport callback. Retained/closing owners never qualify. */
static PAPACC_BOOL publication_closed_clean_rejection(
    PAPACC_SERVER_IO_LOOP_WIN32*l,
    const PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,PAPACC_U16 type)
{
    PAPACC_CONNECTION*c;
    PAPACC_NETWORK_STREAM*stream;
    if(l==NULL||s==NULL||l->connection_manager==NULL||
       type!=PAPACC_MESSAGE_TYPE_NETWORK_CLOSE||
       s->network_data_protocol.state!=PAPACC_NETWORK_DATA_TERMINAL||
       s->network_terminal_sent==PAPACC_TRUE||s->in_use!=PAPACC_TRUE||
       s->kind!=PAPACC_SERVER_PROTOCOL_SLOT_KIND_DATA_ATTACH)return PAPACC_FALSE;
    c=papacc_connection_manager_find(l->connection_manager,s->connection_instance_id);
    if(c==NULL||c->state!=PAPACC_CONNECTION_STATE_CLOSED||
       s->data_attach_processor.writer.transport!=&c->transport||
       papacc_transport_connection_is_valid(&c->transport)==PAPACC_TRUE)
        return PAPACC_FALSE;
    stream=papacc_network_stream_find_channel(&l->network_stream_manager,
        s->network_data_protocol.channel_instance_id);
    return stream!=NULL&&stream->stream_instance_id==s->network_stream_generation&&
        stream->transport_mode==PAPACC_NETWORK_TRANSPORT_TLS_REQUIRED&&
        stream->remote_half_closed==PAPACC_TRUE&&
        stream->accepted_terminal_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE&&
        stream->accepted_terminal_generation==stream->stream_instance_id&&
        stream->terminal_cause==PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_NONE?
        PAPACC_TRUE:PAPACC_FALSE;
}
static PAPACC_BOOL publication_slot_identity_valid(
    const PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s)
{
    return s!=NULL&&s->network_data_protocol.channel_instance_id!=0U&&
        s->network_stream_generation!=0U?PAPACC_TRUE:PAPACC_FALSE;
}
static PAPACC_SERVER_PROTOCOL_SLOT_WIN32*slot_for_stream(
    PAPACC_SERVER_IO_LOOP_WIN32*l,const PAPACC_NETWORK_STREAM*stream)
{
    PAPACC_SIZE i;
    for(i=0U;i<l->processor_capacity;++i){
        PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s=&l->processor_slots[i];
        if(s->in_use==PAPACC_TRUE&&s->kind==PAPACC_SERVER_PROTOCOL_SLOT_KIND_DATA_ATTACH&&
            s->network_data_protocol.channel_instance_id==
                stream->data_channel_instance_id)return s;
    }
    return NULL;
}

static void close_bound_stream(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s)
{
    PAPACC_CONNECTION*c=slot_connection(l,s);
    AUTHORITY_TRACE(l,s,s->establishment.reservation,"CANCEL_CASCADE_BEGIN");
    (void)papacc_network_stream_close_channel(&l->network_stream_manager,
        s->network_data_protocol.channel_instance_id);
    AUTHORITY_TRACE(l,s,s->establishment.reservation,"STREAM_DESTROY_RETURN");
    s->establishment.reservation=NULL;
    s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
    if(c!=NULL)papacc_connection_close(c);
    AUTHORITY_TRACE(l,s,NULL,"CONNECTION_CLOSE_RETURN");
}

static PAPACC_RESULT begin_network_control_payload(
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,PAPACC_U16 type,
    const PAPACC_U8*payload,PAPACC_SIZE payload_length,PAPACC_BOOL close_after)
{
    PAPACC_FRAME_HEADER header;
    PAPACC_RESULT r;
    if(s->network_control_send_pending==PAPACC_TRUE||
       (publication_connection_active(s->establishment.loop,s)!=PAPACC_TRUE&&
        publication_closed_clean_rejection(s->establishment.loop,s,type)!=PAPACC_TRUE)||
       publication_slot_identity_valid(s)!=PAPACC_TRUE||
       s->network_terminal_sent==PAPACC_TRUE)
        return PAPACC_RESULT_INVALID_STATE;
    if(payload_length>sizeof(s->network_control_payload)||
        (payload_length!=0U&&payload==NULL))return PAPACC_RESULT_INVALID_ARGUMENT;
    header=papacc_network_frame_header(type,(PAPACC_U32)payload_length);
    AUTHORITY_TRACE(s->establishment.loop,s,s->establishment.reservation,"CONTROL_CREATE");
    r=papacc_framed_writer_begin_frame(&s->data_attach_processor.writer,
        &header);
    if(r==PAPACC_RESULT_OK){
        s->network_control_send_type=type;
        s->network_control_connection_id=s->connection_instance_id;
        s->network_control_operation_id=s->network_data_protocol.channel_instance_id;
        s->network_control_generation=s->network_stream_generation;
        s->network_control_publication_started=PAPACC_FALSE;
        s->network_control_send_pending=PAPACC_TRUE;
        AUTHORITY_TRACE(s->establishment.loop,s,s->establishment.reservation,"CONTROL_ENQUEUE");
        if(payload_length!=0U)memcpy(s->network_control_payload,payload,
            payload_length);
        s->network_control_payload_length=payload_length;
        s->network_control_payload_offset=0U;
        s->network_close_after_control=close_after;
    }
    return r;
}

static PAPACC_RESULT begin_network_control(
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,PAPACC_U16 type,
    PAPACC_BOOL close_after)
{
    return begin_network_control_payload(s,type,NULL,0U,close_after);
}

static PAPACC_RESULT begin_tls_truncated_reason(
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s)
{
    PAPACC_NETWORK_ABORT_REASON_MESSAGE message=
        PAPACC_NETWORK_ABORT_REASON_MESSAGE_INITIALIZER;
    PAPACC_U8 payload[2];PAPACC_SIZE written=0U;PAPACC_RESULT r;
    message.reason=PAPACC_NETWORK_TERMINAL_REASON_TLS_TRUNCATED;
    r=papacc_network_abort_reason_encode(&message,payload,sizeof(payload),
        &written);
    if(r!=PAPACC_RESULT_OK)return r;
    return begin_network_control_payload(s,
        PAPACC_MESSAGE_TYPE_NETWORK_ABORT_REASON,payload,written,PAPACC_TRUE);
}

static void progress_network_control(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,PAPACC_NETWORK_STREAM*stream)
{
    PAPACC_SIZE ignored=0U;
    PAPACC_FRAMED_WRITER_STATUS status;
    PAPACC_RESULT r;
    if(s->network_control_send_pending!=PAPACC_TRUE)return;
    if((publication_connection_active(l,s)!=PAPACC_TRUE&&
        publication_closed_clean_rejection(l,s,s->network_control_send_type)!=PAPACC_TRUE)||
       publication_slot_identity_valid(s)!=PAPACC_TRUE||
       s->network_control_connection_id!=s->connection_instance_id||
       s->network_control_operation_id!=s->network_data_protocol.channel_instance_id||
       s->network_control_generation!=s->network_stream_generation||
       (stream!=NULL&&(stream->stream_instance_id!=s->network_control_generation||
        stream->data_channel_instance_id!=s->network_control_operation_id))){
        AUTHORITY_TRACE(l,s,stream,"CONTROL_AUTHORITY_REVOKED");
        return;
    }
    AUTHORITY_TRACE(l,s,stream,"CONTROL_DEQUEUE_DISPATCH");
    if(s->terminal_trace_a4==PAPACC_TRUE&&
        (s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_HALF_CLOSE||
         s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE||
         s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT||
         s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT_REASON)&&
        s->terminal_trace_write_started!=PAPACC_TRUE){
        terminal_trace_emit(l,s,stream,"A8",
            "name=PACC_TERMINAL_WRITE_BEGIN");
        s->terminal_trace_write_started=PAPACC_TRUE;
    }
#ifdef PAPACC_ENABLE_TEST_OWNER_TERMINAL_HOOKS
    if((s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE||
        s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT||
        s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT_REASON)&&
       s->network_control_publication_started!=PAPACC_TRUE)
        owner_terminal_emit_publication(l,stream,s,
            PAPACC_OWNER_TERMINAL_TEST_EVENT_PUBLICATION_ATTEMPT,
            s->network_control_send_type,PAPACC_RESULT_OK,
            PAPACC_FRAMED_WRITER_STATUS_UNSPECIFIED);
#endif
    s->network_control_publication_started=PAPACC_TRUE;
    r=papacc_framed_writer_step(&s->data_attach_processor.writer,
        s->network_control_payload_length==0U?NULL:
            s->network_control_payload+s->network_control_payload_offset,
        s->network_control_payload_length-s->network_control_payload_offset,
        &ignored,&status);
    if(r!=PAPACC_RESULT_OK||status==PAPACC_FRAMED_WRITER_STATUS_END_OF_STREAM){
#ifdef PAPACC_ENABLE_TEST_OWNER_TERMINAL_HOOKS
        if(s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE||
           s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT||
           s->network_control_send_type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT_REASON)
            owner_terminal_emit_publication(l,stream,s,
                PAPACC_OWNER_TERMINAL_TEST_EVENT_PUBLICATION_FAILURE,
                s->network_control_send_type,r,status);
#endif
        close_bound_stream(l,s);
        return;
    }
    s->network_control_payload_offset+=ignored;
    if(status==PAPACC_FRAMED_WRITER_STATUS_FRAME_COMPLETE){
        PAPACC_BOOL close_after=s->network_close_after_control;
        PAPACC_U16 type=s->network_control_send_type;
#ifdef PAPACC_ENABLE_TEST_OWNER_TERMINAL_HOOKS
        if(type==PAPACC_MESSAGE_TYPE_NETWORK_CLOSE||type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT||
           type==PAPACC_MESSAGE_TYPE_NETWORK_ABORT_REASON)
            owner_terminal_emit_publication(l,stream,s,
                PAPACC_OWNER_TERMINAL_TEST_EVENT_PUBLICATION_SUCCESS,
                type,PAPACC_RESULT_OK,status);
#endif
        s->network_control_send_type=0U;
        s->network_control_send_pending=PAPACC_FALSE;
        s->network_control_payload_length=0U;
        s->network_control_payload_offset=0U;
        s->network_close_after_control=PAPACC_FALSE;
        if(s->terminal_trace_a4==PAPACC_TRUE&&
            s->terminal_trace_write_started==PAPACC_TRUE)
            terminal_trace_emit(l,s,stream,"A9",
                "name=PACC_TERMINAL_WRITE_COMPLETE");
        if(type==PAPACC_MESSAGE_TYPE_NETWORK_HALF_CLOSE&&stream!=NULL)
            stream->remote_half_close_signalled=PAPACC_TRUE;
        if(close_after==PAPACC_TRUE)
            s->network_terminal_sent=PAPACC_TRUE;
        if(close_after==PAPACC_TRUE)close_bound_stream(l,s);
    }
}
#ifdef PAPACC_ENABLE_TEST_OWNER_TERMINAL_HOOKS
PAPACC_RESULT papacc_server_io_loop_win32_test_publish_owner_terminal(
    PAPACC_SERVER_IO_LOOP_WIN32*l,PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,
    PAPACC_U64 operation,PAPACC_U64 generation,PAPACC_U16 type)
{
    PAPACC_NETWORK_STREAM*stream;PAPACC_RESULT r;
    if(l==NULL||s==NULL||operation==0U||generation==0U||
       l->owner_terminal_test_thread_id!=(PAPACC_U32)GetCurrentThreadId())
        return PAPACC_RESULT_INVALID_ARGUMENT;
    stream=papacc_network_stream_find_channel(&l->network_stream_manager,
        operation);
    if(stream==NULL||stream->stream_instance_id!=generation||
       stream->accepted_terminal_type!=type||
       stream->accepted_terminal_generation!=generation||
       s->network_data_protocol.channel_instance_id!=operation)
        return PAPACC_RESULT_INVALID_STATE;
    s->establishment.loop=l;
    s->network_stream_generation=generation;
    r=begin_network_control(s,type,PAPACC_TRUE);
    if(r!=PAPACC_RESULT_OK)return r;
