static void progress_standalone_open_result(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s)
{
    PAPACC_FRAMED_WRITER_STATUS status;
    PAPACC_SIZE written=0U;
    PAPACC_RESULT r;
    if(s->open_result_pending!=PAPACC_TRUE||s->establishment_job_id!=0U)return;
    r=papacc_framed_writer_step(&s->data_attach_processor.writer,
        &s->open_result_payload[s->open_result_offset],
        s->open_result_length-s->open_result_offset,&written,&status);
    if(r!=PAPACC_RESULT_OK){
        PAPACC_CONNECTION*c=slot_connection(l,s);
        if(c!=NULL)papacc_connection_close(c);
        (void)papacc_network_stream_close_channel(&l->network_stream_manager,
            s->network_data_protocol.channel_instance_id);
        s->open_result_pending=PAPACC_FALSE;
        return;
    }
    s->open_result_offset+=written;
    if(status==PAPACC_FRAMED_WRITER_STATUS_FRAME_COMPLETE)
        s->open_result_pending=PAPACC_FALSE;
}

static void cancel_lost_establishments(PAPACC_SERVER_IO_LOOP_WIN32*l)
{
    PAPACC_SIZE i,pass;
    PAPACC_JOB*j;
    for(i=0U;i<l->processor_capacity;++i){
        PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s=&l->processor_slots[i];
        if(s->in_use==PAPACC_TRUE&&s->kind==PAPACC_SERVER_PROTOCOL_SLOT_KIND_DATA_ATTACH&&
            s->establishment_job_id!=0U&&closed_slot_connection(l,s)!=NULL){
            j=papacc_job_manager_find(&l->network_job_manager,s->establishment_job_id);
            if(j!=NULL)j->suppress_result=PAPACC_TRUE;
            (void)papacc_job_manager_cancel(&l->network_job_manager,
                s->establishment_job_id);
        }
    }
    for(pass=0U;pass<l->network_job_manager.capacity;++pass){
        j=NULL;
        if(papacc_job_manager_progress_one(&l->network_job_manager,0U,&j)!=
            PAPACC_RESULT_OK||j==NULL)break;
        if(papacc_job_state_terminal(j->state)==PAPACC_TRUE){
            PAPACC_U64 id=j->job_instance_id;
            for(i=0U;i<l->processor_capacity;++i)
                if(l->processor_slots[i].establishment_job_id==id)
                    l->processor_slots[i].establishment_job_id=0U;
            (void)papacc_job_manager_reap(&l->network_job_manager,id);
        }
    }
}

static void drive_establishments(PAPACC_SERVER_IO_LOOP_WIN32*l,PAPACC_U64 now)
{
    PAPACC_SIZE i;
    PAPACC_JOB*j=NULL;
    cancel_lost_establishments(l);
    for(i=0U;i<l->processor_capacity;++i){
        PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s=&l->processor_slots[i];
        if(s->in_use&&s->kind==PAPACC_SERVER_PROTOCOL_SLOT_KIND_DATA_ATTACH&&
            s->network_data_protocol.state==PAPACC_NETWORK_DATA_ESTABLISHING&&
            s->establishment_job_id==0U&&s->open_result_pending!=PAPACC_TRUE&&
            s->network_open_attempted!=PAPACC_TRUE){
            s->network_open_attempted=PAPACC_TRUE;
            terminal_trace_begin(l,s,now);
            PAPACC_RESULT r=admit_network_open(l,s,now);
            if(r!=PAPACC_RESULT_OK){
                s->network_data_protocol.state=PAPACC_NETWORK_DATA_TERMINAL;
                (void)prepare_open_result(s,r==PAPACC_RESULT_NOT_SUPPORTED?
                    PAPACC_NETWORK_OPEN_UNSUPPORTED:PAPACC_NETWORK_OPEN_FAILED);
            }
        }
        progress_standalone_open_result(l,s);
    }
    if(papacc_job_manager_progress_one(&l->network_job_manager,now,&j)!=
        PAPACC_RESULT_OK)return;
    if(j!=NULL&&papacc_job_state_terminal(j->state)==PAPACC_TRUE){
        PAPACC_U64 id=j->job_instance_id;
        for(i=0U;i<l->processor_capacity;++i)
            if(l->processor_slots[i].establishment_job_id==id){
                if(j->state!=PAPACC_JOB_STATE_COMPLETED)
                    l->processor_slots[i].network_data_protocol.state=
                        PAPACC_NETWORK_DATA_TERMINAL;
                l->processor_slots[i].establishment_job_id=0U;
                break;
            }
        (void)papacc_job_manager_reap(&l->network_job_manager,id);
    }
}

