static const char*terminal_trace_name(const char*event)
{
    static const char*names[]={"NETWORK_OPEN_BEGIN","UPSTREAM_TLS_READY",
        "FIRST_UPSTREAM_BYTE","LAST_UPSTREAM_DATA_BEFORE_TERMINAL",
        "UPSTREAM_TLS_TERMINAL_OBSERVED","TERMINAL_CLASSIFIED",
        "PACC_TERMINAL_CONSTRUCTED","PACC_TERMINAL_QUEUED",
        "PACC_TERMINAL_WRITE_BEGIN","PACC_TERMINAL_WRITE_COMPLETE"};
    if(event!=NULL&&event[0]=='A'&&event[1]>='0'&&event[1]<='9'&&
        event[2]=='\0')return names[event[1]-'0'];
    return "UNKNOWN";
}
static void terminal_trace_emit_at(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,const PAPACC_NETWORK_STREAM*stream,
    const char*event,PAPACC_U64 event_ns,const char*detail)
{
    FILE*f=NULL;PAPACC_U64 elapsed;
    if(l==NULL||s==NULL||event==NULL||
        l->terminal_latency_trace_enabled!=PAPACC_TRUE||
        s->terminal_trace_t0_ns==0U)return;
    elapsed=event_ns>=s->terminal_trace_t0_ns?
        event_ns-s->terminal_trace_t0_ns:0U;
    if(fopen_s(&f,l->terminal_latency_trace_path,"ab")!=0||f==NULL)return;
    (void)fprintf(f,
        "event=%s name=%s elapsed_us=%llu session=%llu data_channel=%llu connection=%llu stream=%llu%s%s\n",
        event,terminal_trace_name(event),(unsigned long long)(elapsed/1000U),
        (unsigned long long)s->network_data_protocol.session_instance_id,
        (unsigned long long)s->network_data_protocol.channel_instance_id,
        (unsigned long long)s->connection_instance_id,
        (unsigned long long)(stream!=NULL?stream->stream_instance_id:0U),
        detail!=NULL?" ":"",detail!=NULL?detail:"");
    (void)fclose(f);
}
static void terminal_trace_emit(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,const PAPACC_NETWORK_STREAM*stream,
    const char*event,const char*detail)
{
    PAPACC_U64 now;
    if(l==NULL||l->terminal_latency_trace_enabled!=PAPACC_TRUE||
        papacc_pal_monotonic_time_ns(&now)!=PAPACC_RESULT_OK)return;
    terminal_trace_emit_at(l,s,stream,event,now,detail);
}
static void terminal_trace_begin(PAPACC_SERVER_IO_LOOP_WIN32*l,
    PAPACC_SERVER_PROTOCOL_SLOT_WIN32*s,PAPACC_U64 now)
{
    DWORD size;
    if(l==NULL||s==NULL)return;
    size=GetEnvironmentVariableA(PAPACC_TERMINAL_LATENCY_TRACE_ENV,
        l->terminal_latency_trace_path,
        (DWORD)sizeof(l->terminal_latency_trace_path));
    if(size==0U||size>=sizeof(l->terminal_latency_trace_path)){
        l->terminal_latency_trace_enabled=PAPACC_FALSE;
        l->terminal_latency_trace_path[0]='\0';
        return;
    }
    l->terminal_latency_trace_enabled=PAPACC_TRUE;
    s->terminal_trace_t0_ns=now;
    terminal_trace_emit_at(l,s,NULL,"A0",now,"name=NETWORK_OPEN_BEGIN");
}
