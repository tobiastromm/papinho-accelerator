static void reap_budget(PAPACC_SERVER_IO_LOOP_WIN32*l,PAPACC_U64 now,
    PAPACC_SIZE network_stream_budget){PAPACC_SIZE operation,idle=0U,active;
    drive_establishments(l,now);
    active=l->network_stream_manager.count;
    for(operation=0U;operation<network_stream_budget;++operation){
        if(drive_active_streams(l,now)==PAPACC_TRUE)idle=0U;else ++idle;
        active=l->network_stream_manager.count;
        if(active==0U||idle>=active)break;}
