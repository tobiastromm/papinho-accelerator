/* U1-U7 binary UPDATE, distinct from exclusive staging/configuration UPDATE.
 * Preparation alone denies. The sole effect route requires the independently
 * attributed native act, original references and fresh limited U4 admission. */
static PAPACC_STAGED_UPDATE_STATE *staged_update_state(void)
{return &root.configuration_commit.pending_commit.personal_native.staged_update;}
static DWORD staged_update_fail(DWORD e)
{PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();if(!e)e=ERROR_INVALID_DATA;if(!u->first){u->first=e;u->first_location=u->location;}return u->first;}
static int staged_update_owned(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();
 return staging_owned()&&u->self==u&&u->thread==GetCurrentThreadId()&&u->invocation==root.invocation&&u->phase==1U;
}
static int staged_update_stop(void)
{return papacc_server_console_win32_stop_requested()||root.configuration_commit.pending_commit.stop;}
/* Accepted U2: slot8 is DATA only AFTER independent executor admission.
 * Parse the entire owner/DACL; a generic valid SD is never sufficient. */
static int staged_update_data_descriptor(PSECURITY_DESCRIPTOR sd)
{
 PSID owner;PACL acl;BOOL present,def;DWORD i;
 if(!sd||!IsValidSecurityDescriptor(sd)||!GetSecurityDescriptorOwner(sd,&owner,&def)||
 !owner||!IsValidSid(owner)||!GetSecurityDescriptorDacl(sd,&present,&acl,&def)||
 !present||!acl||!IsValidAcl(acl)||!acl->AceCount)return 0;
 for(i=0;i<acl->AceCount;i++){
  PACE_HEADER h;ACCESS_ALLOWED_ACE *a;PSID sid;
  if(!GetAce(acl,i,(void **)&h)||(h->AceFlags&~(OBJECT_INHERIT_ACE|CONTAINER_INHERIT_ACE|NO_PROPAGATE_INHERIT_ACE|INHERIT_ONLY_ACE|INHERITED_ACE))||
   (h->AceType!=ACCESS_ALLOWED_ACE_TYPE&&h->AceType!=ACCESS_DENIED_ACE_TYPE)||
   h->AceSize<FIELD_OFFSET(ACCESS_ALLOWED_ACE,SidStart)+8U)return 0;
  a=(ACCESS_ALLOWED_ACE *)h;sid=&a->SidStart;
  if(!IsValidSid(sid)||GetLengthSid(sid)>(DWORD)(h->AceSize-FIELD_OFFSET(ACCESS_ALLOWED_ACE,SidStart)))return 0;
 }
 return 1;
}
static DWORD staged_update_executor_current(void);
/* Fixed caller buffer, no realloc/retry for opaque SCM configuration sizes.
 * All returned strings must terminate INSIDE the original query result. */
static int staged_update_string(const WCHAR *text,const WCHAR *expected,DWORD bytes)
{
 const BYTE *begin=staged_update_state()->query;ULONG_PTR at=(ULONG_PTR)text,base=(ULONG_PTR)begin;size_t i,cap;
 if(!text||bytes>sizeof(staged_update_state()->query)||at<base||at-base>=bytes||(at-base)%sizeof(WCHAR))return 0;
 cap=(bytes-(size_t)(at-base))/sizeof(WCHAR);
 for(i=0;i<cap;i++)if(!text[i])return wcslen(expected)==i&&!memcmp(text,expected,i*sizeof(WCHAR));
 return 0;
}
static DWORD staged_update_service(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();PAPACC_PERSONAL_NATIVE_CONTEXT *n=&root.configuration_commit.pending_commit.personal_native;
 QUERY_SERVICE_CONFIGW *q=(QUERY_SERVICE_CONFIGW *)u->query;SERVICE_STATUS_PROCESS status;
 SERVICE_SID_INFO sid;DWORD bytes=0,needed=0;WCHAR command[MAX_PATH+32U];
 u->location=200U;
 if(!staged_update_owned()||!u->service||staged_update_stop())return staged_update_fail(ERROR_CANCELLED);
 if(swprintf_s(command,MAX_PATH+32U,L"\"%s\\papacc_server.exe\" service host scq-closed",n->install_paths.binary)<0)return staged_update_fail(ERROR_INVALID_NAME);
 ZeroMemory(u->query,sizeof(u->query));
 if(!QueryServiceConfigW(u->service,q,sizeof(u->query),&needed))return staged_update_fail(GetLastError());
 /* On success pcbBytesNeeded is not used as a returned initialized byte count.
  * Zeroing and bounded pointer checks constrain every interpreted string. */
 bytes=sizeof(u->query);
 if(q->dwServiceType!=SERVICE_WIN32_OWN_PROCESS||q->dwStartType!=SERVICE_DEMAND_START||q->dwErrorControl!=SERVICE_ERROR_NORMAL||
 !staged_update_string(q->lpBinaryPathName,command,bytes)||!staged_update_string(q->lpServiceStartName,L"NT SERVICE\\PapinhoAccelerator",bytes)||
 !staged_update_string(q->lpLoadOrderGroup,L"",bytes)||!q->lpDependencies||
 !staged_update_string(q->lpDependencies,L"",bytes))return staged_update_fail(ERROR_ACCESS_DENIED);
 ZeroMemory(&sid,sizeof(sid));needed=0;
 if(!QueryServiceConfig2W(u->service,SERVICE_CONFIG_SERVICE_SID_INFO,(BYTE *)&sid,sizeof(sid),&needed)||
 sid.dwServiceSidType!=SERVICE_SID_TYPE_UNRESTRICTED)return staged_update_fail(ERROR_ACCESS_DENIED);
 ZeroMemory(&status,sizeof(status));bytes=0;
 if(!QueryServiceStatusEx(u->service,SC_STATUS_PROCESS_INFO,(BYTE *)&status,sizeof(status),&bytes))return staged_update_fail(GetLastError());
 if(bytes!=sizeof(status)||status.dwServiceType!=SERVICE_WIN32_OWN_PROCESS||status.dwCurrentState!=SERVICE_STOPPED||status.dwProcessId)
 return staged_update_fail(ERROR_SERVICE_CANNOT_ACCEPT_CTRL);
 return staged_update_stop()?staged_update_fail(ERROR_CANCELLED):0;
}
static DWORD staged_update_object(unsigned index,int first)
{
 PAPACC_QUALIFICATION_STAGING *s=staging_act();PAPACC_STAGING_OBJECT *o=&s->objects[index];BY_HANDLE_FILE_INFORMATION f;
 SECURITY_DESCRIPTOR_CONTROL control;DWORD rev,bytes;BYTE digest[32];int valid=0;
 staged_update_state()->location=100U+index;
 if(!staged_update_owned()||staged_update_stop())return staged_update_fail(ERROR_CANCELLED);
 if(index==8U&&staged_update_state()->execute_mode&&staged_update_executor_current())return staged_update_state()->first;
 if(!GetFileInformationByHandle(o->handle,&f))return staged_update_fail(GetLastError());
 if((f.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT)||!!(f.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY)!=!!o->directory||
 f.dwVolumeSerialNumber!=root.configuration_commit.pending_commit.personal_native.parent.dwVolumeSerialNumber)
 return staged_update_fail(ERROR_ACCESS_DENIED);
 if(!first&&(o->directory?(f.nFileIndexHigh!=o->identity.nFileIndexHigh||f.nFileIndexLow!=o->identity.nFileIndexLow||f.dwFileAttributes!=o->identity.dwFileAttributes):!scm_register_id(&f,&o->identity)))
 return staged_update_fail(ERROR_REVISION_MISMATCH);
 if(s->scratch)return staged_update_fail(ERROR_INVALID_STATE);
 if(GetSecurityInfo(o->handle,SE_FILE_OBJECT,OWNER_SECURITY_INFORMATION|DACL_SECURITY_INFORMATION,NULL,NULL,NULL,NULL,&s->scratch)!=ERROR_SUCCESS||!s->scratch)
 return staged_update_fail(ERROR_INVALID_SECURITY_DESCR);
 bytes=GetSecurityDescriptorLength(s->scratch);
 if(bytes&&bytes<=65536U&&GetSecurityDescriptorControl(s->scratch,&control,&rev)&&
 /* No generic-SD bypass: DATA requires the independent original executor.
  * Preparation-only retains the historical strict source policy. */
 (o->directory||(index==8U&&staged_update_state()->execute_mode?
  staged_update_data_descriptor(s->scratch):
  ((index==8U||(control&SE_DACL_PROTECTED))&&scm_descriptor(s->scratch,root.configuration_commit.pending_commit.personal_native.sid))))&&
 (!o->directory||staging_descriptor(s->scratch,1))&&
 (index!=0U||staging_anchor_descriptor(s->scratch))&&
 pacc_storage_hash_callback(NULL,(BYTE *)s->scratch,bytes,digest)&&(first||!memcmp(o->acl,digest,32)))valid=1;
 if(LocalFree(s->scratch)){s->phase=8U;return staged_update_fail(ERROR_INVALID_HANDLE);}s->scratch=NULL;
 if(!valid)return staged_update_fail(ERROR_ACCESS_DENIED);
 if(first){o->identity=f;memcpy(o->acl,digest,32);}return 0;
}
/* FILE_OPEN only, READ_CONTROL/read attributes/data, share READ. Stable packet
 * name and IOSB survive unexpected pending results. No WRITE/DELETE/ACL rights.
 * Bounded controlled references are not a guessed total-process handle quota. */
static DWORD staged_update_open(unsigned index,HANDLE parent,const WCHAR *name,int directory)
{
 PAPACC_PERSONAL_NATIVE_CONTEXT *n=&root.configuration_commit.pending_commit.personal_native;
 PAPACC_QUALIFICATION_STAGING *s=staging_act();STAGING_NT_CREATE fn;FARPROC proc;HMODULE module;NTSTATUS status;size_t len;ACCESS_MASK rights;ULONG share=FILE_SHARE_READ;
 if(!staged_update_owned()||index>=16U||s->objects[index].handle||!name||staged_update_stop())return staged_update_fail(ERROR_INVALID_STATE);
 len=wcslen(name);if(!len||len>=MAX_PATH)return staged_update_fail(ERROR_INVALID_NAME);
 module=GetModuleHandleW(L"ntdll.dll");proc=module?GetProcAddress(module,"NtCreateFile"):NULL;if(!proc)return staged_update_fail(ERROR_NOT_SUPPORTED);
 memcpy(&fn,&proc,sizeof(fn));memcpy(s->source,name,(len+1U)*sizeof(WCHAR));
 ZeroMemory(&n->scq_cold_attributes,sizeof(n->scq_cold_attributes));ZeroMemory(&s->resources.volume_io,sizeof(s->resources.volume_io));
 n->scq_cold_unicode.Buffer=s->source;n->scq_cold_unicode.Length=(USHORT)(len*sizeof(WCHAR));n->scq_cold_unicode.MaximumLength=n->scq_cold_unicode.Length;
 n->scq_cold_attributes.Length=sizeof(n->scq_cold_attributes);n->scq_cold_attributes.RootDirectory=parent;
 n->scq_cold_attributes.ObjectName=&n->scq_cold_unicode;n->scq_cold_attributes.Attributes=OBJ_CASE_INSENSITIVE|0x1000U;
 s->objects[index].directory=directory?1U:0U;
 rights=READ_CONTROL|SYNCHRONIZE|FILE_READ_ATTRIBUTES|(directory?FILE_TRAVERSE:FILE_READ_DATA);
 if(staged_update_state()->execute_mode){
  if(index==13U)rights|=DELETE;
  if(directory==2)rights|=FILE_ADD_FILE;
  /* Readback requests only read rights; primary share READ still denies all
   * other writers/deleters, including via these readback borrows. */
  if(index==11U||index==15U)share|=FILE_SHARE_WRITE|FILE_SHARE_DELETE;
 }
 status=fn(&s->objects[index].handle,rights,
 &n->scq_cold_attributes,&s->resources.volume_io,NULL,directory?FILE_ATTRIBUTE_DIRECTORY:FILE_ATTRIBUTE_NORMAL,share,1U,
 directory?0x00200021U:0x00200060U,NULL,0);
 if(status>0||s->resources.volume_io.Status==(NTSTATUS)0x103L||(status!=0&&s->objects[index].handle)){
 s->phase=8U;return staged_update_fail(ERROR_IO_PENDING);}
 if(status||s->resources.volume_io.Status||s->resources.volume_io.Information!=1U||!s->objects[index].handle)return staged_update_fail(status?(DWORD)status:ERROR_INVALID_DATA);
 return staged_update_object(index,1);
}
/* Same owner, original ancestor handles, strict image/DLLs and live process.
 * No grant setter and no selection by candidate-owner/hash. Slot7 is an
 * existing bounded slot, reserved only if it is not needed by ancestors. */
static DWORD staged_update_executor_current(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();PAPACC_QUALIFICATION_STAGING *s=staging_act();
 FILETIME created,exited,kernel,user;WCHAR process_name[MAX_PATH],file_name[MAX_PATH];
 DWORD a=MAX_PATH,b;BYTE digest[32];unsigned i;
 if(!staged_update_owned()||!u->execute_mode||!u->executor_pid||!s->objects[7].handle||
  s->ancestor_count>7U||u->executor_pid!=GetCurrentProcessId()||staged_update_stop())return staged_update_fail(ERROR_ACCESS_DENIED);
 if(papacc_configuration_personal_native_current(&root.configuration_commit)!=PAPACC_RESULT_OK||
 !GetProcessTimes(GetCurrentProcess(),&created,&exited,&kernel,&user)||
 memcmp(&created,&u->executor_creation,sizeof(created)))return staged_update_fail(ERROR_REVISION_MISMATCH);
 if(staged_update_object(7U,0)||!scm_register_hash(s->objects[7].handle,digest)||memcmp(digest,u->executor_hash,32))return staged_update_fail(ERROR_CRC);
 if(!QueryFullProcessImageNameW(GetCurrentProcess(),PROCESS_NAME_NATIVE,process_name,&a)||!a||a>=MAX_PATH)return staged_update_fail(ERROR_ACCESS_DENIED);
 b=GetFinalPathNameByHandleW(s->objects[7].handle,file_name,MAX_PATH,FILE_NAME_NORMALIZED|VOLUME_NAME_NT);
 if(!b||b>=MAX_PATH||a!=b||CompareStringOrdinal(process_name,(int)a,file_name,(int)b,FALSE)!=CSTR_EQUAL)return staged_update_fail(ERROR_ACCESS_DENIED);
 for(i=0;i<2U;i++){
  HMODULE module=GetModuleHandleW(staging_leaf[i+1U]);
  a=module?GetModuleFileNameW(module,process_name,MAX_PATH):0;
  b=GetFinalPathNameByHandleW(s->objects[9U+i].handle,file_name,MAX_PATH,FILE_NAME_NORMALIZED|VOLUME_NAME_DOS);
  if(!a||a>=MAX_PATH||!b||b>=MAX_PATH)return staged_update_fail(ERROR_ACCESS_DENIED);
  /* DOS final paths have the explicit \\?\ prefix; module paths do not. */
  if(b!=a+4U||wcsncmp(file_name,L"\\\\?\\",4U)||CompareStringOrdinal(process_name,(int)a,file_name+4,(int)a,TRUE)!=CSTR_EQUAL)return staged_update_fail(ERROR_ACCESS_DENIED);
 }
 for(i=0;i<16U;i++)if(i!=7U&&s->objects[i].handle&&
  s->objects[i].identity.dwVolumeSerialNumber==u->executor_id[0]&&s->objects[i].identity.nFileIndexHigh==u->executor_id[1]&&
  s->objects[i].identity.nFileIndexLow==u->executor_id[2])return staged_update_fail(ERROR_ACCESS_DENIED);
 return 0;
}
static DWORD staged_update_executor_capture(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();PAPACC_PERSONAL_NATIVE_CONTEXT *n=&root.configuration_commit.pending_commit.personal_native;
 PAPACC_QUALIFICATION_STAGING *s=staging_act();FILETIME exited,kernel,user;DWORD count;size_t prefix=wcslen(n->install_paths.binary);
 u->location=920U;
 count=GetModuleFileNameW(NULL,u->executor_path,MAX_PATH);
 if(!count||count>=MAX_PATH||count<=prefix+1U||s->ancestor_count>7U||
  _wcsnicmp(u->executor_path,n->install_paths.binary,prefix)||u->executor_path[prefix]!=L'\\'||
  wcschr(u->executor_path+prefix+1U,L'\\'))return staged_update_fail(ERROR_ACCESS_DENIED);
 if(staged_update_open(7U,s->objects[s->ancestor_count-1U].handle,u->executor_path+prefix+1U,0))return u->first;
 {const BY_HANDLE_FILE_INFORMATION *f=&s->objects[7].identity;
 if(f->dwVolumeSerialNumber!=u->executor_id[0]||f->nFileIndexHigh!=u->executor_id[1]||f->nFileIndexLow!=u->executor_id[2])return staged_update_fail(ERROR_REVISION_MISMATCH);}
 u->executor_pid=GetCurrentProcessId();
 if(!u->executor_pid||!GetProcessTimes(GetCurrentProcess(),&u->executor_creation,&exited,&kernel,&user))return staged_update_fail(ERROR_ACCESS_DENIED);
 return staged_update_executor_current();
}
static DWORD staged_update_files(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();PAPACC_QUALIFICATION_STAGING *s=staging_act();unsigned i,j;BYTE digest[32];
 const unsigned files_to_check[4]={8U,9U,10U,13U};
 if(!staged_update_owned()||papacc_configuration_personal_layout_binary_current(&root.configuration_commit)!=PAPACC_RESULT_OK||
 papacc_configuration_personal_native_current(&root.configuration_commit)!=PAPACC_RESULT_OK)return staged_update_fail(ERROR_ACCESS_DENIED);
 if(staged_update_service())return u->first;
 if(u->execute_mode&&staged_update_executor_current())return u->first;
 for(i=0;i<s->ancestor_count;i++)if(staged_update_object(i,0))return u->first;
 for(i=0;i<4U;i++){
  unsigned k=files_to_check[i];const BYTE *pin=k==8U?u->new_hash:k==13U?u->old_hash:u->dll_hash[k-9U];
  if(k==13U&&(s->objects[k].identity.dwVolumeSerialNumber!=u->expected_old_id[0]||
   s->objects[k].identity.nFileIndexHigh!=u->expected_old_id[1]||s->objects[k].identity.nFileIndexLow!=u->expected_old_id[2]))return staged_update_fail(ERROR_REVISION_MISMATCH);
  if(staged_update_object(k,0)||!scm_register_hash(s->objects[k].handle,digest)||memcmp(digest,pin,32))return staged_update_fail(ERROR_CRC);
  if(!s->objects[k].identity.nFileSizeLow&&!s->objects[k].identity.nFileSizeHigh)return staged_update_fail(ERROR_INVALID_DATA);
  for(j=0;j<i;j++)if(s->objects[k].identity.nFileIndexHigh==s->objects[files_to_check[j]].identity.nFileIndexHigh&&
   s->objects[k].identity.nFileIndexLow==s->objects[files_to_check[j]].identity.nFileIndexLow)return staged_update_fail(ERROR_ACCESS_DENIED);
 }
 if(staged_update_stop()||papacc_configuration_personal_native_current(&root.configuration_commit)!=PAPACC_RESULT_OK)return staged_update_fail(ERROR_ACCESS_DENIED);
 return 0; /* snapshot, never a lease preventing another administrator's Start */
}
static DWORD staged_update_close(void)
{
 PAPACC_STAGED_UPDATE_STATE *u=staged_update_state();PAPACC_QUALIFICATION_STAGING *s=staging_act();SC_HANDLE *handles[2]={&u->service,&u->manager};unsigned i;
 if(!staged_update_owned()||s->phase==8U||u->phase==8U)return ERROR_INVALID_STATE;
 u->location=900U;
 if(u->effects&&u->first)goto retained;
 for(i=0;i<2U;i++)if(*handles[i]){
  if(u->close_attempts&(1U<<i))goto retained;u->close_attempts|=1U<<i;
  if(!CloseServiceHandle(*handles[i]))goto retained;*handles[i]=NULL;
 }
