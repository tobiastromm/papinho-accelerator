}
/* Application-private composition. The separate manual CLI below constructs
 * the attributed act; the existing read-only wrapper cannot perform effects.
 * Expected identities/hashes are comparison DATA, not authority sources. */
static int staged_update_entry(const WCHAR *,const DWORD [3],const DWORD [3],const BYTE [32],const BYTE [32],const BYTE [2][32],const DWORD [3],const BYTE [32],FILE *,int);
#include "server_launcher_staged_update_effects_win32.inc"
size_t papacc_server_launcher_binary_update_known_bytes(void)
{
 return PAPACC_C8_KNOWN_MANAGED_BYTES+papacc_server_service_storage_bytes()+sizeof(LONG)+
 3U*MAX_PATH*sizeof(WCHAR)+3U*sizeof(WCHAR)+(MAX_PATH+32U)*sizeof(WCHAR)+sizeof(SERVICE_STATUS_PROCESS)+
 sizeof(SERVICE_SID_INFO)+sizeof(BY_HANDLE_FILE_INFORMATION)+sizeof(PACC_STORAGE_SHA256)+1024U+128U+32U*sizeof(void *)+32U*sizeof(DWORD)+
 128U+6U*sizeof(DWORD)+MAX_PATH*sizeof(WCHAR)+UPDATE_KNOWN_AUTOMATIC_BYTES+
 2U*MAX_PATH*sizeof(WCHAR)+7U*sizeof(FILETIME)+32U+16U*sizeof(void *)+16U*sizeof(DWORD);
}
static int staged_update_entry(const WCHAR *source,const DWORD parent_id[3],const DWORD old_id[3],const BYTE old_pin[32],const BYTE new_pin[32],const BYTE dll_pins[2][32],const DWORD executor_id[3],const BYTE executor_pin[32],FILE *out,int execute)
{
