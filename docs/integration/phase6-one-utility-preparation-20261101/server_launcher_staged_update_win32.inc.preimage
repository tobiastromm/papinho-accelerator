 ZeroMemory(&root,sizeof(root));root.owner_thread=GetCurrentThreadId();root.invocation=++next_invocation;c->writer=root.owner_thread;
 s->self=s;s->thread=root.owner_thread;s->invocation=root.invocation;s->phase=1U;
 u->self=u;u->thread=root.owner_thread;u->invocation=root.invocation;u->phase=1U;
 u->execute_mode=execute?1U:0U;wcscpy_s(u->source_path,MAX_PATH,source);u->resources.sink=out;
 u->missing=PAPACC_UPDATE_MISSING_ACT|PAPACC_UPDATE_MISSING_NATIVE|PAPACC_UPDATE_MISSING_MARGIN|PAPACC_UPDATE_MISSING_REPLACEMENT;
