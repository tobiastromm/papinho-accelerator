 if(!QueryDosDeviceW(drive,device,MAX_PATH)||wcsncmp(device,L"\\Device\\",8U)||
 swprintf_s(native_source,MAX_PATH,L"%s%s",device,source+2)<0){staged_update_fail(ERROR_INVALID_NAME);goto done;}
 if(staged_update_open(8U,NULL,native_source,0))goto done;
 u->manager=OpenSCManagerW(NULL,NULL,SC_MANAGER_CONNECT);if(!u->manager){staged_update_fail(GetLastError());goto done;}
 u->service=OpenServiceW(u->manager,L"PapinhoAccelerator",SERVICE_QUERY_CONFIG|SERVICE_QUERY_STATUS);if(!u->service){staged_update_fail(GetLastError());goto done;}
 if(staged_update_files())goto done;
 u->old_bytes=((ULONGLONG)s->objects[13].identity.nFileSizeHigh<<32)|s->objects[13].identity.nFileSizeLow;
 u->new_bytes=((ULONGLONG)s->objects[8].identity.nFileSizeHigh<<32)|s->objects[8].identity.nFileSizeLow;
 if(staged_update_stop()){staged_update_fail(ERROR_CANCELLED);goto done;}u->prepared=1U;
 if(execute){
  if(!u->new_bytes||u->new_bytes>MAXDWORD-4U){staged_update_fail(ERROR_ARITHMETIC_OVERFLOW);goto done;}
  if(staged_update_present(out))goto done;
  {DWORD e=staged_update_apply();if(e){staged_update_fail(e);goto done;}}
 }
done:
 if(s->phase!=8U&&u->phase!=8U){(void)staged_update_close();clean=u->phase==4U&&s->phase==6U;}
 if(!clean){root.configuration_commit.unresolved=1;InterlockedExchange(&state,PAPACC_LAUNCHER_RETAINED);}
 else InterlockedExchange(&state,PAPACC_LAUNCHER_FINISHED);
 fprintf(out,"STAGED_UPDATE_RESULT prepared=%u first=%lu missing=%lu consumed=%u submitted=%u created=%u renames=%u close_known=%u K=%llu R=%llu; %s; OPAQUE_COSTS_UNKNOWN; OS_QUIESCENCE=UNKNOWN; NO_RETRY_NO_ROLLBACK_NO_START\n",
 u->prepared,(unsigned long)u->first,(unsigned long)u->missing,u->consumed,u->effects,u->created,u->rename_done,(unsigned)clean,
 (ULONGLONG)root.reserved_bytes,u->rounded,execute&&u->rename_done==3U&&clean&&!u->first?"LIMITED_UPDATE_VERIFIED_CLOSED":"AUTHORITY=DENY");
 fprintf(out,"STAGED_UPDATE_FIRST_CAUSE location=%lu native_predicate=%lu native_kind=%lu native_error=%lu; METADATA_NOT_AUTHORITY\n",(unsigned long)u->first_location,(unsigned long)n->diagnostic_first,(unsigned long)n->diagnostic_kind,(unsigned long)n->diagnostic_error);
 if(s->objects[14].identity.nFileIndexHigh||s->objects[14].identity.nFileIndexLow)
  fprintf(out,"STAGED_UPDATE_NEW_OBJECT volume=%lu high=%lu low=%lu bytes=%llu canonical_verified_closed=%u; CAPTURE_NOT_START_AUTHORITY\n",
   (unsigned long)s->objects[14].identity.dwVolumeSerialNumber,(unsigned long)s->objects[14].identity.nFileIndexHigh,
   (unsigned long)s->objects[14].identity.nFileIndexLow,u->new_bytes,(unsigned)(execute&&u->rename_done==3U&&clean&&!u->first));
 return u->prepared&&clean&&!u->first&&(!execute||u->rename_done==3U)?0:2;
}
int papacc_server_launcher_staged_update_prepare(const WCHAR *source,const DWORD old_id[3],const BYTE a[32],const BYTE b[32],const BYTE d[2][32],FILE *out)
{return staged_update_entry(source,NULL,old_id,a,b,d,NULL,NULL,out,0);}
