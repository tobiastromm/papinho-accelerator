 u->location=910U;
 drive[0]=n->install_paths.binary[0];drive[1]=':';drive[2]=0;
 {char volume[4]={(char)drive[0],':','\\',0};if(papacc_configuration_personal_native_open(c,volume)!=PAPACC_RESULT_OK){staged_update_fail(ERROR_ACCESS_DENIED);goto done;}}
 if(!ConvertStringSidToSidW(L"S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464",&s->trusted_installer)){staged_update_fail(ERROR_INVALID_SID);goto done;}
 len=wcslen(n->install_paths.binary);start=3U;
 for(i=start;i<=len;i++)if(n->install_paths.binary[i]==L'\\'||!n->install_paths.binary[i]){
  unsigned k=s->ancestor_count;if(i==start||k==8U){staged_update_fail(ERROR_INVALID_NAME);goto done;}
