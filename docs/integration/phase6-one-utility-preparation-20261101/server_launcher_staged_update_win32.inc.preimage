 if(staging_close()){u->phase=8U;return staged_update_fail(ERROR_INVALID_HANDLE);}
 if(root.configuration_commit.pending_commit.personal_native.console.is_installed&&
 papacc_server_console_win32_uninstall(&root.configuration_commit.pending_commit.personal_native.console)!=PAPACC_RESULT_OK)goto retained;
 return u->first;
