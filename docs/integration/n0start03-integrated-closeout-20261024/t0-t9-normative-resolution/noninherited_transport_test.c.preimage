/* Isolated non-inherited IPC prototype. NO LAB/SCM/operational dispatch. */
#define WIN32_LEAN_AND_MEAN 1
#include <windows.h>
#include <sddl.h>
#include <aclapi.h>
#include <bcrypt.h>
#include <processsnapshot.h>
#include <psapi.h>
