if(NOT DEFINED EXECUTABLE OR NOT DEFINED BASE OR NOT DEFINED MODE)
 message(FATAL_ERROR "Explicit isolated fixture path and mode required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef fixture_nonce)
set(fixture_dir "${BASE}/tpm-${MODE}-${fixture_nonce}")
file(MAKE_DIRECTORY "${fixture_dir}")
if(MODE STREQUAL "artifacts")
 execute_process(COMMAND "${EXECUTABLE}" "${fixture_dir}" "${CERTIFICATE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
elseif(MODE STREQUAL "admin")
 execute_process(COMMAND "${EXECUTABLE}" "${fixture_dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
elseif(MODE STREQUAL "console")
 execute_process(COMMAND "${EXECUTABLE}" --fixture-controller "${fixture_dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
else()
 message(FATAL_ERROR "Unknown isolated fixture mode")
endif()
file(WRITE "${fixture_dir}/runner-result.txt" "${output}${errors}")
message(STATUS "${output}${errors}")
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Fixture failed (${result}); files retained in ${fixture_dir}; no operational retry/cleanup authority")
endif()
