#ifndef PAPACC_NETWORK_STREAM_H
#define PAPACC_NETWORK_STREAM_H

#include <papacc/types.h>
#include "network_offload_protocol.h"

typedef enum PAPACC_NETWORK_STREAM_STATE { PAPACC_NETWORK_STREAM_UNUSED=0,
    PAPACC_NETWORK_STREAM_RESERVED=1,PAPACC_NETWORK_STREAM_OPEN=2,
    PAPACC_NETWORK_STREAM_CLOSING=3,PAPACC_NETWORK_STREAM_CLOSED=4 }
    PAPACC_NETWORK_STREAM_STATE;
typedef enum PAPACC_NETWORK_STREAM_TERMINAL_CAUSE {
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_NONE=0,
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_SHUTDOWN_DEADLINE=1,
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_CONTROL_TRANSPORT_LOSS=2,
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_CONTROL_TLS_FAILURE=3,
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_PACC_PROTOCOL_FAILURE=4,
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_SERVER_STOP_REQUESTED=5
} PAPACC_NETWORK_STREAM_TERMINAL_CAUSE;
typedef PAPACC_RESULT (*PAPACC_NETWORK_STREAM_READ_FN)(void *,PAPACC_U8 *,
    PAPACC_SIZE,PAPACC_SIZE *,PAPACC_BOOL *);
typedef PAPACC_RESULT (*PAPACC_NETWORK_STREAM_WRITE_FN)(void *,const PAPACC_U8 *,
    PAPACC_SIZE,PAPACC_SIZE *);
typedef PAPACC_RESULT (*PAPACC_NETWORK_STREAM_HALF_CLOSE_FN)(void *);
typedef PAPACC_RESULT (*PAPACC_NETWORK_STREAM_SHUTDOWN_FN)(void *,
    PAPACC_BOOL *);
typedef void (*PAPACC_NETWORK_STREAM_CLOSE_FN)(void *);
typedef PAPACC_NETWORK_TERMINAL_REASON (*PAPACC_NETWORK_STREAM_TERMINAL_REASON_FN)(void *);
typedef struct PAPACC_NETWORK_STREAM_IO { void *context;
    PAPACC_NETWORK_STREAM_READ_FN read;PAPACC_NETWORK_STREAM_WRITE_FN write;
    PAPACC_NETWORK_STREAM_HALF_CLOSE_FN half_close;
    PAPACC_NETWORK_STREAM_SHUTDOWN_FN shutdown;
    PAPACC_NETWORK_STREAM_CLOSE_FN close;
    PAPACC_NETWORK_STREAM_TERMINAL_REASON_FN terminal_reason;
    PAPACC_RESULT (*try_close)(void *, PAPACC_BOOL *); } PAPACC_NETWORK_STREAM_IO;
#define PAPACC_NETWORK_STREAM_IO_INITIALIZER {NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL}
typedef struct PAPACC_NETWORK_STREAM {
    PAPACC_U64 stream_instance_id,owner_session_instance_id,data_channel_instance_id;
    PAPACC_NETWORK_TRANSPORT_MODE transport_mode;
    PAPACC_NETWORK_STREAM_STATE state;PAPACC_BOOL client_half_close_requested;
    PAPACC_BOOL client_half_closed,remote_half_closed,remote_half_close_signalled;
    PAPACC_BOOL terminal_pending;PAPACC_NETWORK_TERMINAL_REASON terminal_reason;
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE terminal_cause;
    PAPACC_U16 accepted_terminal_type;PAPACC_U64 accepted_terminal_generation;
    PAPACC_U64 close_deadline_ns,schedule_order;
    PAPACC_U8 *to_remote,*to_client;PAPACC_SIZE buffer_capacity;
    PAPACC_SIZE to_remote_size,to_client_size;PAPACC_U64 bytes_to_remote,bytes_to_client;
    PAPACC_NETWORK_STREAM_IO io;
    PAPACC_BOOL close_retained;
} PAPACC_NETWORK_STREAM;
#define PAPACC_NETWORK_STREAM_INITIALIZER {0U,0U,0U,PAPACC_NETWORK_TRANSPORT_TCP_PLAIN,PAPACC_NETWORK_STREAM_UNUSED, \
    PAPACC_FALSE,PAPACC_FALSE,PAPACC_FALSE,PAPACC_FALSE,PAPACC_FALSE,PAPACC_NETWORK_TERMINAL_REASON_UNSPECIFIED,PAPACC_NETWORK_STREAM_TERMINAL_CAUSE_NONE,0U,0U,0U,0U,NULL,NULL,0U,0U,0U,0U,0U,PAPACC_NETWORK_STREAM_IO_INITIALIZER,PAPACC_FALSE}
typedef struct PAPACC_NETWORK_STREAM_MANAGER {PAPACC_NETWORK_STREAM *storage;
    PAPACC_SIZE capacity,count,per_session_limit,buffer_capacity,cursor;
    PAPACC_U64 next_instance_id,next_schedule_order,last_session_id;
    PAPACC_BOOL initialized;}
    PAPACC_NETWORK_STREAM_MANAGER;
#define PAPACC_NETWORK_STREAM_MANAGER_INITIALIZER {NULL,0U,0U,0U,0U,0U,1U,1U,0U,PAPACC_FALSE}

PAPACC_RESULT papacc_network_stream_manager_init(PAPACC_NETWORK_STREAM_MANAGER *,
    PAPACC_NETWORK_STREAM *,PAPACC_U8 *,PAPACC_U8 *,PAPACC_SIZE,PAPACC_SIZE,PAPACC_SIZE);
PAPACC_RESULT papacc_network_stream_reserve(PAPACC_NETWORK_STREAM_MANAGER *,
    PAPACC_U64,PAPACC_U64,PAPACC_NETWORK_TRANSPORT_MODE,PAPACC_NETWORK_STREAM **);
PAPACC_RESULT papacc_network_stream_publish(PAPACC_NETWORK_STREAM_MANAGER *,
    PAPACC_NETWORK_STREAM *,const PAPACC_NETWORK_STREAM_IO *);
void papacc_network_stream_release_reservation(PAPACC_NETWORK_STREAM_MANAGER *,
    PAPACC_NETWORK_STREAM *);
PAPACC_NETWORK_STREAM *papacc_network_stream_find_for_session(
    PAPACC_NETWORK_STREAM_MANAGER *,PAPACC_U64,PAPACC_U64);
PAPACC_NETWORK_STREAM *papacc_network_stream_find_channel(
    PAPACC_NETWORK_STREAM_MANAGER *,PAPACC_U64);
const PAPACC_NETWORK_STREAM *papacc_network_stream_inspect_at(
    const PAPACC_NETWORK_STREAM_MANAGER *,PAPACC_SIZE);
PAPACC_RESULT papacc_network_stream_enqueue_client(PAPACC_NETWORK_STREAM *,
    const PAPACC_U8 *,PAPACC_SIZE);
PAPACC_RESULT papacc_network_stream_take_client(PAPACC_NETWORK_STREAM *,
    PAPACC_U8 *,PAPACC_SIZE,PAPACC_SIZE *);
PAPACC_SIZE papacc_network_stream_client_space(const PAPACC_NETWORK_STREAM *);
PAPACC_RESULT papacc_network_stream_peek_client(const PAPACC_NETWORK_STREAM *,
    const PAPACC_U8 **,PAPACC_SIZE *);
PAPACC_RESULT papacc_network_stream_consume_client(PAPACC_NETWORK_STREAM *,
    PAPACC_SIZE);
PAPACC_RESULT papacc_network_stream_progress_one(PAPACC_NETWORK_STREAM_MANAGER *,
    PAPACC_SIZE,PAPACC_NETWORK_STREAM **);
PAPACC_RESULT papacc_network_stream_progress_one_at(PAPACC_NETWORK_STREAM_MANAGER *,
    PAPACC_SIZE,PAPACC_U64,PAPACC_NETWORK_STREAM **);
PAPACC_RESULT papacc_network_stream_progress_one_observed_at(
    PAPACC_NETWORK_STREAM_MANAGER *, PAPACC_SIZE, PAPACC_U64,
    PAPACC_NETWORK_STREAM **, PAPACC_BOOL *);
PAPACC_RESULT papacc_network_stream_half_close_client(PAPACC_NETWORK_STREAM *);
PAPACC_RESULT papacc_network_stream_request_close(PAPACC_NETWORK_STREAM *,
    PAPACC_U64);
PAPACC_RESULT papacc_network_stream_close_channel(PAPACC_NETWORK_STREAM_MANAGER *,PAPACC_U64);
PAPACC_RESULT papacc_network_stream_close_session(PAPACC_NETWORK_STREAM_MANAGER *,PAPACC_U64);
PAPACC_RESULT papacc_network_stream_close_session_with_cause(
    PAPACC_NETWORK_STREAM_MANAGER *, PAPACC_U64,
    PAPACC_NETWORK_STREAM_TERMINAL_CAUSE);
void papacc_network_stream_manager_shutdown(PAPACC_NETWORK_STREAM_MANAGER *);
#endif
