#ifndef PAPACC_TCP_OUTBOUND_WIN32_H
#define PAPACC_TCP_OUTBOUND_WIN32_H

#include <winsock2.h>
#include "network_endpoint.h"
#include "transport_connection.h"
#include "tcp_connection_transport_win32.h"

typedef enum PAPACC_TCP_OUTBOUND_STATE { PAPACC_TCP_OUTBOUND_NOT_STARTED=0,
    PAPACC_TCP_OUTBOUND_CONNECTING=1,PAPACC_TCP_OUTBOUND_CONNECTED=2,
    PAPACC_TCP_OUTBOUND_FAILED=3,PAPACC_TCP_OUTBOUND_CANCELLED=4 }
    PAPACC_TCP_OUTBOUND_STATE;
typedef struct PAPACC_TCP_OUTBOUND_WIN32 {SOCKET native_socket;
    PAPACC_TCP_OUTBOUND_STATE state;PAPACC_NETWORK_ENDPOINT remote,source;
    PAPACC_U64 deadline_ns;PAPACC_BOOL source_required;} PAPACC_TCP_OUTBOUND_WIN32;
#define PAPACC_TCP_OUTBOUND_WIN32_INITIALIZER {INVALID_SOCKET, \
    PAPACC_TCP_OUTBOUND_NOT_STARTED,PAPACC_NETWORK_ENDPOINT_INITIALIZER, \
    PAPACC_NETWORK_ENDPOINT_INITIALIZER,0U,PAPACC_FALSE}

PAPACC_RESULT papacc_tcp_outbound_win32_start(PAPACC_TCP_OUTBOUND_WIN32 *,
    const PAPACC_NETWORK_ENDPOINT *,const PAPACC_NETWORK_ENDPOINT *,PAPACC_BOOL,
    PAPACC_U64);
PAPACC_RESULT papacc_tcp_outbound_win32_progress(PAPACC_TCP_OUTBOUND_WIN32 *,
    PAPACC_U64);
void papacc_tcp_outbound_win32_cancel(PAPACC_TCP_OUTBOUND_WIN32 *);
PAPACC_RESULT papacc_tcp_outbound_win32_take_socket(
    PAPACC_TCP_OUTBOUND_WIN32 *, SOCKET *);
PAPACC_RESULT papacc_tcp_outbound_win32_take_transport(
    PAPACC_TCP_OUTBOUND_WIN32 *,PAPACC_TCP_CONNECTION_TRANSPORT_WIN32_CONTEXT *,
    PAPACC_TRANSPORT_CONNECTION *);
void papacc_tcp_outbound_win32_close(PAPACC_TCP_OUTBOUND_WIN32 *);
#endif
