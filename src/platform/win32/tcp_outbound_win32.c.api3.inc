#include "tcp_outbound_win32.h"
#include "native_teardown_win32.h"
#include <ws2tcpip.h>
#include <string.h>

static int native_address(const PAPACC_NETWORK_ENDPOINT *e,struct sockaddr_storage *s,int *n)
{memset(s,0,sizeof(*s));if(e->address.family==PAPACC_IP_FAMILY_IPV4){struct sockaddr_in *a=(struct sockaddr_in*)s;a->sin_family=AF_INET;a->sin_port=htons(e->port);memcpy(&a->sin_addr,e->address.bytes,4);*n=sizeof(*a);return AF_INET;}if(e->address.family==PAPACC_IP_FAMILY_IPV6){struct sockaddr_in6 *a=(struct sockaddr_in6*)s;a->sin6_family=AF_INET6;a->sin6_port=htons(e->port);a->sin6_scope_id=e->scope_id;memcpy(&a->sin6_addr,e->address.bytes,16);*n=sizeof(*a);return AF_INET6;}return AF_UNSPEC;}
PAPACC_RESULT papacc_tcp_outbound_win32_try_close(PAPACC_TCP_OUTBOUND_WIN32 *c){PAPACC_RESULT r;if(!c)return PAPACC_RESULT_INVALID_ARGUMENT;r=papacc_native_socket_close_once(&c->native_socket,&c->close_unresolved);if(r!=PAPACC_RESULT_OK)return r;*c=(PAPACC_TCP_OUTBOUND_WIN32)PAPACC_TCP_OUTBOUND_WIN32_INITIALIZER;return PAPACC_RESULT_OK;}
void papacc_tcp_outbound_win32_close(PAPACC_TCP_OUTBOUND_WIN32 *c){(void)papacc_tcp_outbound_win32_try_close(c);}
PAPACC_RESULT papacc_tcp_outbound_win32_start(PAPACC_TCP_OUTBOUND_WIN32 *c,const PAPACC_NETWORK_ENDPOINT *remote,const PAPACC_NETWORK_ENDPOINT *source,PAPACC_BOOL source_required,PAPACC_U64 deadline)
{struct sockaddr_storage ra,sa;int rn,sn,family,result;u_long one=1UL;if(c==NULL||c->close_unresolved||c->native_socket!=INVALID_SOCKET||remote==NULL||deadline==0U||papacc_network_endpoint_validate(remote)!=PAPACC_RESULT_OK||remote->port==0U||c->state!=PAPACC_TCP_OUTBOUND_NOT_STARTED)return PAPACC_RESULT_INVALID_ARGUMENT;family=native_address(remote,&ra,&rn);if(family==AF_UNSPEC)return PAPACC_RESULT_INVALID_ARGUMENT;if(source_required==PAPACC_TRUE&&(source==NULL||papacc_network_endpoint_validate(source)!=PAPACC_RESULT_OK||source->address.family!=remote->address.family))return PAPACC_RESULT_INVALID_ARGUMENT;c->native_socket=socket(family,SOCK_STREAM,IPPROTO_TCP);if(c->native_socket==INVALID_SOCKET){c->state=PAPACC_TCP_OUTBOUND_FAILED;return PAPACC_RESULT_INTERNAL_ERROR;}if(ioctlsocket(c->native_socket,FIONBIO,&one)==SOCKET_ERROR)goto fail;if(source_required==PAPACC_TRUE){sn=0;(void)native_address(source,&sa,&sn);if(bind(c->native_socket,(struct sockaddr*)&sa,sn)==SOCKET_ERROR)goto fail;c->source=*source;c->source_required=PAPACC_TRUE;}c->remote=*remote;c->deadline_ns=deadline;result=connect(c->native_socket,(struct sockaddr*)&ra,rn);if(result==0){c->state=PAPACC_TCP_OUTBOUND_CONNECTED;return PAPACC_RESULT_OK;}if(WSAGetLastError()==WSAEWOULDBLOCK||WSAGetLastError()==WSAEINPROGRESS){c->state=PAPACC_TCP_OUTBOUND_CONNECTING;return PAPACC_RESULT_OK;}fail:(void)papacc_native_socket_close_once(&c->native_socket,&c->close_unresolved);c->state=PAPACC_TCP_OUTBOUND_FAILED;return PAPACC_RESULT_INTERNAL_ERROR;}
PAPACC_RESULT papacc_tcp_outbound_win32_progress(PAPACC_TCP_OUTBOUND_WIN32 *c,PAPACC_U64 now)
{fd_set w,e;struct timeval tv={0,0};int selected,error=0,n=sizeof(error);if(c==NULL||c->close_unresolved||c->state!=PAPACC_TCP_OUTBOUND_CONNECTING)return PAPACC_RESULT_INVALID_STATE;if(now>=c->deadline_ns){(void)papacc_native_socket_close_once(&c->native_socket,&c->close_unresolved);c->state=PAPACC_TCP_OUTBOUND_FAILED;return PAPACC_RESULT_LIMIT_EXCEEDED;}FD_ZERO(&w);FD_ZERO(&e);FD_SET(c->native_socket,&w);FD_SET(c->native_socket,&e);selected=select(0,NULL,&w,&e,&tv);if(selected==0)return PAPACC_RESULT_OK;if(selected==SOCKET_ERROR||getsockopt(c->native_socket,SOL_SOCKET,SO_ERROR,(char*)&error,&n)==SOCKET_ERROR||error!=0){(void)papacc_native_socket_close_once(&c->native_socket,&c->close_unresolved);c->state=PAPACC_TCP_OUTBOUND_FAILED;return PAPACC_RESULT_INTERNAL_ERROR;}c->state=PAPACC_TCP_OUTBOUND_CONNECTED;return PAPACC_RESULT_OK;}
void papacc_tcp_outbound_win32_cancel(PAPACC_TCP_OUTBOUND_WIN32 *c){if(c==NULL||c->close_unresolved||c->state==PAPACC_TCP_OUTBOUND_CANCELLED)return;if(c->native_socket!=INVALID_SOCKET)(void)papacc_native_socket_close_once(&c->native_socket,&c->close_unresolved);c->state=PAPACC_TCP_OUTBOUND_CANCELLED;}
PAPACC_RESULT papacc_tcp_outbound_win32_take_socket(PAPACC_TCP_OUTBOUND_WIN32 *c,
    SOCKET *out)
{if(out!=NULL)*out=INVALID_SOCKET;if(c==NULL||c->close_unresolved||out==NULL||c->state!=PAPACC_TCP_OUTBOUND_CONNECTED||c->native_socket==INVALID_SOCKET)return PAPACC_RESULT_INVALID_STATE;*out=c->native_socket;c->native_socket=INVALID_SOCKET;c->state=PAPACC_TCP_OUTBOUND_NOT_STARTED;return PAPACC_RESULT_OK;}
PAPACC_RESULT papacc_tcp_outbound_win32_take_transport(PAPACC_TCP_OUTBOUND_WIN32 *c,PAPACC_TCP_CONNECTION_TRANSPORT_WIN32_CONTEXT *context,PAPACC_TRANSPORT_CONNECTION *out)
{PAPACC_RESULT r;if(c==NULL||c->close_unresolved||c->state!=PAPACC_TCP_OUTBOUND_CONNECTED)return PAPACC_RESULT_INVALID_STATE;r=papacc_tcp_connection_transport_win32_adopt(c->native_socket,context,out);if(r==PAPACC_RESULT_OK){c->native_socket=INVALID_SOCKET;c->state=PAPACC_TCP_OUTBOUND_NOT_STARTED;}return r;}
